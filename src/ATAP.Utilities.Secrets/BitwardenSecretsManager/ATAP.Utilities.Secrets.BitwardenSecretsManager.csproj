<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Library</OutputType>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <IsPackable>true</IsPackable>
    <Description>Project-scoped Bitwarden Secrets Manager provider that retrieves exact SecretNames through bws by using a bounded ReadOnly access-token source.</Description>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <DisableFody>true</DisableFody>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="Windows\**\*.cs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Interfaces\ATAP.Utilities.Secrets.Interfaces.csproj" Version="0.1.2" />
    <ProjectReference Include="..\Model\ATAP.Utilities.Secrets.Model.csproj" Version="0.1.2" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Configuration" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
  </ItemGroup>
</Project>
