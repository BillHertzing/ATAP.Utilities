##########################################################################
# CSharpPackage-PerProject - BuildMaster OtterScript Plan
#
# Source of truth:
#   Plan-DocsUpdateForImmutablePackages_V3.md Section K
#   SolutionDocumentation/BuildMaster-ProGet-CSharp-Package-Pipeline.md section 9
#
# Variables (Application or Build Variables):
#   $ApplicationName          Repository/application name, e.g. ATAP.Utilities
#   $Branch                   Branch being built
#   $SourcePath               Absolute path to the developer worktree
#   $ProjectPath              Repo-root-relative path to one .csproj
#   $Configuration            MSBuild configuration, e.g. Release
#   $ProGetApiKey             Masked BuildMaster variable for ProGet API calls
#
# This is the single-project sibling of CSharpPackage-5Stage.otter. Only
# Experimental builds and publishes; later stages move the same package
# version through the feed chain and run tests against the promoted artifact.
##########################################################################

# The source is the BuildMaster-provided developer worktree. Do not replace it
# with file-export checkout; the .git file is required by version resolution.

set $BuildToolingModulePath = $PathCombine($SourcePath, src\ATAP.Utilities.BuildTooling.PowerShell\ATAP.Utilities.BuildTooling.PowerShell.psd1);

set $ExperimentalFeedName = nuget-experimental;
set $DevelopmentFeedName  = nuget-development;
set $IntegrationFeedName  = nuget-integration;
set $QaFeedName           = nuget-qa;
set $ProductionFeedName   = nuget-stable;

set $PackageSlug = $RegexReplace($ProjectPath, `^.*[\\/]([^\\/]+)\.csproj$`, `$1`);
set $PackageName = $PackageSlug;

Exec
(
    FileName: pwsh,
    Arguments: `-NoProfile -Command "Import-Module '$BuildToolingModulePath' -Force; New-Item -ItemType Directory -Path '_generated\buildmaster' -Force | Out-Null; $$context = Get-BuildContext -Application '$ApplicationName' -Branch '$Branch'; $$context.Tier | Set-Content -Path '_generated\buildmaster\_tier.tmp' -NoNewline; $$context.ResolvedPackageVersion | Set-Content -Path '_generated\buildmaster\_resolved_version.tmp' -NoNewline; $$context.PrereleaseLabel | Set-Content -Path '_generated\buildmaster\_prerelease_label.tmp' -NoNewline"`,
    WorkingDirectory: $SourcePath,
    SuccessExitCode: 0
);

set $TierTempFile = $PathCombine($SourcePath, _generated\buildmaster\_tier.tmp);
set $ResolvedPackageVersionTempFile = $PathCombine($SourcePath, _generated\buildmaster\_resolved_version.tmp);
set $PrereleaseLabelTempFile = $PathCombine($SourcePath, _generated\buildmaster\_prerelease_label.tmp);

set $Tier = $Trim($FileContents($TierTempFile));
set $ResolvedPackageVersion = $Trim($FileContents($ResolvedPackageVersionTempFile));
set $PrereleaseLabel = $Trim($FileContents($PrereleaseLabelTempFile));

set $FeedName = $ExperimentalFeedName;
if $Tier == Development { set $FeedName = $DevelopmentFeedName;  }
if $Tier == Integration { set $FeedName = $IntegrationFeedName;  }
if $Tier == QA          { set $FeedName = $QaFeedName;           }
if $Tier == Production  { set $FeedName = $ProductionFeedName;   }

Log-Debug `Resolved Tier=$Tier Feed=$FeedName Project=$ProjectPath Package=$PackageName Version=$ResolvedPackageVersion PrereleaseLabel=$PrereleaseLabel`;

# -------------------------------------------------------------------------
# Stage Experimental - build, pack, publish to the first feed
# -------------------------------------------------------------------------
stage Experimental
{
    if $Tier == Experimental
    {
        Exec
        (
            FileName: dotnet,
            Arguments: `build $ProjectPath --configuration $Configuration --no-incremental`,
            WorkingDirectory: $SourcePath,
            SuccessExitCode: 0
        );

        Exec
        (
            FileName: dotnet,
            Arguments: `pack $ProjectPath --configuration $Configuration --no-build --output _generated\nuget\$Tier\$PackageSlug`,
            WorkingDirectory: $SourcePath,
            SuccessExitCode: 0
        );

        Exec
        (
            FileName: pwsh,
            Arguments: `-NoProfile -Command "$$env:PROGET_ADMIN_API_KEY = '$Decrypt($ProGetApiKey)'; Import-Module '$BuildToolingModulePath' -Force; Get-ChildItem -Path '_generated\nuget\$Tier\$PackageSlug' -Filter '*.nupkg' -File | ForEach-Object { Publish-NuGetPackageToProGet -NupkgPath $$_.FullName -Feed '$FeedName' | Out-Null }"`,
            WorkingDirectory: $SourcePath,
            SuccessExitCode: 0
        );

        Create-Artifact ProjectPackages
        (
            From: _generated\nuget\$Tier\$PackageSlug,
            Include: @(*.nupkg, *.snupkg)
        );
    }
}

# -------------------------------------------------------------------------
# Stage Development - promote from Experimental, then run unit tests
# -------------------------------------------------------------------------
stage Development
{
    if $Tier == Development
    {
        Exec
        (
            FileName: pwsh,
            Arguments: `-NoProfile -Command "$$env:PROGET_BUILDMASTER_API_KEY = '$Decrypt($ProGetApiKey)'; Import-Module '$BuildToolingModulePath' -Force; Promote-ProGetPackage -Name '$PackageName' -Version '$ResolvedPackageVersion' -FromFeed '$ExperimentalFeedName' -ToFeed '$DevelopmentFeedName' -Reason 'Development gate for $ApplicationName $ResolvedPackageVersion on $Branch'"`,
            WorkingDirectory: $SourcePath,
            SuccessExitCode: 0
        );

        Exec
        (
            FileName: pwsh,
            Arguments: `-NoProfile -Command "Import-Module '$BuildToolingModulePath' -Force; Invoke-PromotedPackageTests -Name '$PackageName' -Version '$ResolvedPackageVersion' -Feed '$DevelopmentFeedName' -TestFilter 'Category=Unit' -ResultsPath '_generated\testresults\$Tier\$PackageSlug'"`,
            WorkingDirectory: $SourcePath,
            SuccessExitCode: 0
        );

        Create-Artifact ProjectTestResults
        (
            From: _generated\testresults\$Tier\$PackageSlug,
            Include: @(*.trx)
        );
    }
}

# -------------------------------------------------------------------------
# Stage Integration - promote from Development, then run integration tests
# -------------------------------------------------------------------------
stage Integration
{
    if $Tier == Integration
    {
        Exec
        (
            FileName: pwsh,
            Arguments: `-NoProfile -Command "$$env:PROGET_BUILDMASTER_API_KEY = '$Decrypt($ProGetApiKey)'; Import-Module '$BuildToolingModulePath' -Force; Promote-ProGetPackage -Name '$PackageName' -Version '$ResolvedPackageVersion' -FromFeed '$DevelopmentFeedName' -ToFeed '$IntegrationFeedName' -Reason 'Integration gate for $ApplicationName $ResolvedPackageVersion on $Branch'"`,
            WorkingDirectory: $SourcePath,
            SuccessExitCode: 0
        );

        Exec
        (
            FileName: pwsh,
            Arguments: `-NoProfile -Command "Import-Module '$BuildToolingModulePath' -Force; Invoke-PromotedPackageTests -Name '$PackageName' -Version '$ResolvedPackageVersion' -Feed '$IntegrationFeedName' -TestFilter 'Category=Unit|Category=Integration' -ResultsPath '_generated\testresults\$Tier\$PackageSlug'"`,
            WorkingDirectory: $SourcePath,
            SuccessExitCode: 0
        );

        Create-Artifact ProjectTestResults
        (
            From: _generated\testresults\$Tier\$PackageSlug,
            Include: @(*.trx)
        );
    }
}

# -------------------------------------------------------------------------
# Stage QA - promote from Integration, then run regression tests with coverage
# -------------------------------------------------------------------------
stage QA
{
    if $Tier == QA
    {
        Exec
        (
            FileName: pwsh,
            Arguments: `-NoProfile -Command "$$env:PROGET_BUILDMASTER_API_KEY = '$Decrypt($ProGetApiKey)'; Import-Module '$BuildToolingModulePath' -Force; Promote-ProGetPackage -Name '$PackageName' -Version '$ResolvedPackageVersion' -FromFeed '$IntegrationFeedName' -ToFeed '$QaFeedName' -Reason 'QA gate for $ApplicationName $ResolvedPackageVersion on $Branch'"`,
            WorkingDirectory: $SourcePath,
            SuccessExitCode: 0
        );

        Exec
        (
            FileName: pwsh,
            Arguments: `-NoProfile -Command "Import-Module '$BuildToolingModulePath' -Force; Invoke-PromotedPackageTests -Name '$PackageName' -Version '$ResolvedPackageVersion' -Feed '$QaFeedName' -CollectCoverage -ResultsPath '_generated\testresults\$Tier\$PackageSlug'"`,
            WorkingDirectory: $SourcePath,
            SuccessExitCode: 0
        );

        Create-Artifact ProjectTestResults
        (
            From: _generated\testresults\$Tier\$PackageSlug,
            Include: @(*.trx, coverage.cobertura.xml)
        );
    }
}

# -------------------------------------------------------------------------
# Stage Production - promote from QA, then run smoke tests
# -------------------------------------------------------------------------
stage Production
{
    if $Tier == Production
    {
        Exec
        (
            FileName: pwsh,
            Arguments: `-NoProfile -Command "$$env:PROGET_BUILDMASTER_API_KEY = '$Decrypt($ProGetApiKey)'; Import-Module '$BuildToolingModulePath' -Force; Promote-ProGetPackage -Name '$PackageName' -Version '$ResolvedPackageVersion' -FromFeed '$QaFeedName' -ToFeed '$ProductionFeedName' -Reason 'Production gate for $ApplicationName $ResolvedPackageVersion on $Branch'"`,
            WorkingDirectory: $SourcePath,
            SuccessExitCode: 0
        );

        Exec
        (
            FileName: pwsh,
            Arguments: `-NoProfile -Command "Import-Module '$BuildToolingModulePath' -Force; Invoke-PromotedPackageTests -Name '$PackageName' -Version '$ResolvedPackageVersion' -Feed '$ProductionFeedName' -TestFilter 'Category=Smoke' -ResultsPath '_generated\testresults\$Tier\$PackageSlug'"`,
            WorkingDirectory: $SourcePath,
            SuccessExitCode: 0
        );

        Create-Artifact ProjectTestResults
        (
            From: _generated\testresults\$Tier\$PackageSlug,
            Include: @(*.trx)
        );
    }
}
