// A tasks configuration that defines
//   Build Tasks
//     runs npm to compile Typescript application and watch for changes (and then recompile)
//     runs npm to compile Typescript test file and watch for changes (and then recompile)
//     runs a compound tasks to compile typescript application and its test files and to watch for changes in either (and then recompile)
//     ToDo: Untested: Runs Invoke-Pester with VSCCodeMarkers
//     ToDo: Untested: Builds a C# project using dotnet build and multiple ATAP specific build arguments
//     ToDo: Untested: Builds the ATAP CodeAnalysis c# project using dotnet build and multiple ATAP specific build arguments
//     ToDo: Untested: Builds the ATAP VoiceAttack plugin C# project using dotnet build and multiple ATAP specific build arguments
//     ToDo: Untested: Publishes the ATAP VoiceAttack plugin C# project using dotnet publish and multiple ATAP specific build / publish arguments
//     ToDo: Untested: Starts the VoiceAttack program
//     ToDo: Untested: Publishes the ATAP VoiceAttack plugin C# project and starts the VoiceAttack program. Uses a Powershell function (PublishPluginAndStartVAProcess) and alias (psva) defined in the AllHosts profile
//     ToDo: Untested: Stops the VoiceAttack program. Uses a Powershell function (StopVoiceAttackProcess) and alias (stopVA) defined in the AllHosts profile
//     ToDo: Untested: Runs a C# project using dotnet watch and run and multiple ATAP specific build arguments
// See https://go.microsoft.com/fwlink/?LinkId=733558
// for the documentation about the tasks.json format
{
  "version": "2.0.0",
  // Define the 'shell' for each OS. This makes pwsh (cross-platform Powershell V7+) the shell, and defines the path and arguments for invoking it on each OS
  "windows": {
    "options": {
      "shell": {
        "executable": "pwsh.exe",
        "args": ["-ExecutionPolicy", "Bypass", "-Command"]
      }
    }
  },
  "linux": {
    "options": {
      "shell": {
        "executable": "/usr/bin/pwsh",
        "args": ["-NoProfile", "-Command"]
      }
    }
  },
  "osx": {
    "options": {
      "shell": {
        "executable": "/usr/local/bin/pwsh",
        "args": ["-NoProfile", "-Command"]
      }
    }
  },
  "tasks": [
    //  ************************************************************************
    // Set an environment variable
    {
      "label": "Set Environment Variable Environment to the value of Development",
      "type": "shell", // The OS options above all specify using Powershell (cross platform) as the shell
      "command": "$env:Environment = 'development'", // Powershell command to set an environment variable
      "problemMatcher": []
    },
    //  ************************************************************************
    // VSC Extension development
    // {
    //   "label": "Test with Mocha (ESM)",
    //   "type": "shell",
    //   "command": "npm test",
    //   "group": {
    //     "kind": "test",
    //     "isDefault": true
    //   },
    //   "problemMatcher": ["$mocha"],
    //   "presentation": {
    //     "reveal": "always"
    //   }
    // },
    {
      "label": "showVSCEnvironment(Task)",
      "type": "shell",
      "command": "$message = 'workspaceFolder = ${workspaceFolder} ; fileDirname = ${fileDirname}';Write-PSFMessage -Level Important -Message $message "
    },
    {
      "label": "npm: watch",
      "type": "npm",
      // watch script is found in package.json
      "script": "watch",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": "$ts-webpack-watch",
      "isBackground": true,
      "presentation": {
        "reveal": "never",
        "group": "watchers"
      },
      "group": {
        "kind": "build",
        "isDefault": true
      }
    },
    {
      "label": "npm: watch-tests",
      "type": "npm",
      // watch-tests script is found in package.json
      "script": "watch-tests",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": "$tsc-watch",
      "isBackground": true,
      "presentation": {
        "reveal": "never",
        "group": "watchers"
      },
      "group": {
        "kind": "build"
      }
    },
    {
      "label": "tasks: watch-tests",
      "dependsOn": ["npm: watch", "npm: watch-tests"],
      "problemMatcher": []
    },

    // --------------------------------------------------------------------------
    // Powershell script and module development
    {
      "label": "Run Pester Tests for Active File",
      "type": "shell",
      "command": "pwsh",
      "args": ["-NoProfile", "-Command", "Invoke-Pester -Script '${file}' -Output Detailed"],
      "problemMatcher": ["$pester"],
      "group": {
        "kind": "test",
        "isDefault": true
      }
    },
    {
      "label": "Pester Test",
      "type": "shell",
      "command": "pwsh",
      "args": [
        "-NoProfile",
        "-Command",
        "Invoke-Pester ",
        "-Path \"${workspaceFolder}\" ",
        "-ExcludePath \"**/Resources/**\",\"**/Releases/**\" ",
        "-OutputFormat NUnitXml ",
        "-OutputFile \"${workspaceFolder}/_generated/TestResults/results.xml\" ",
        "-PesterOption @{IncludeVSCodeMarker=$true} ",
        "-ExcludeTag Disabled"
      ],
      "problemMatcher": ["$pester"],
      "group": { "kind": "build" }
    },

    //  ************************************************************************
    // Powershell script and module development
    {
      "label": "Pester Test ALSOOLD",
      "type": "shell",
      "command": "Invoke-Pester -PesterOption @{IncludeVSCodeMarker=$true};ExcludeTag='Disabled'",
      "problemMatcher": ["$pester"],
      "group": {
        "kind": "build"
      }
    },
    {
      "label": "Pester Test OLD",
      "type": "shell",
      "command": "Invoke-Pester -PesterOption @{IncludeVSCodeMarker=$true};ExcludeTag='Disabled'",
      "problemMatcher": ["$pester"],
      "group": {
        "kind": "build"
      }
    },
    // this task uses dotnet and Invoke-Build (alias 'ib') to run all the Pester tests
    {
      "label": "TestPSModule",
      "type": "shell",
      "command": "dotnet",
      "args": ["ib", "TestPSModule"],
      "problemMatcher": "$pester",
      "presentation": {
        "echo": false,
        "showReuseMessage": false
      },
      "group": { "kind": "test" }
    },

    // The following group of tasks call the Powershell Invoke-Build script to execute the individual parts of the full module build/document/sign/test/package/deploy process
    {
      "label": "BuildPSModule",
      "type": "shell",
      "command": "Invoke-Build -Task BuildPSModule",
      "problemMatcher": "$msCompile",
      "presentation": {
        "echo": false,
        "showReuseMessage": false
      },
      "group": {
        "kind": "build"
      }
    },
    {
      "label": "GenerateHelpForPSModule",
      "type": "shell",
      "command": "Invoke-Build -Task GenerateHelpForPSModule",
      "problemMatcher": "$msCompile",
      "presentation": {
        "echo": false,
        "showReuseMessage": false
      }
    },
    {
      "label": "GenerateDocumentationForPSModule",
      "type": "shell",
      "command": "Invoke-Build -Task GenerateDocumentationForPSModule",
      "problemMatcher": "$msCompile",
      "presentation": {
        "echo": false,
        "showReuseMessage": false
      }
    },
    {
      "label": "SignPSModule",
      "type": "shell",
      "command": "Invoke-Build -Task SignPSModule",
      "problemMatcher": "$msCompile",
      "presentation": {
        "echo": false,
        "showReuseMessage": false
      }
    },
    {
      "label": "PackagePSModule",
      "type": "shell",
      "command": "Invoke-Build -Task PackagePSModule",
      "problemMatcher": "$msCompile",
      "presentation": {
        "echo": false,
        "showReuseMessage": false
      }
    },

    //  ************************************************************************
    // C# and dotnet development
    {
      "label": "Build C# Project",
      "type": "process",
      "command": "pwsh",
      "args": [
        "-ExecutionPolicy",
        "Bypass",
        "-Command",
        "& {",
        "  $csproj = Get-ChildItem -Path '${fileDirname}' -Filter '*.csproj' | Select-Object -First 1;",
        "  if ($csproj) {",
        "    dotnet build $csproj.FullName",
        "      /p:GenerateFullPaths=true",
        "      /p:Configuration=Debug",
        "      /bl:_devlogs/msbuild.binlog",
        "      /consoleloggerparameters:NoSummary",
        "  } else {",
        "    Write-Error 'No .csproj file found in ${fileDirname}'",
        "  }",
        "}"
      ],
      "presentation": {
        "reveal": "always",
        "echo": true
      },
      "problemMatcher": "$msCompile",
      "group": {
        "kind": "build"
      }
    },
    {
      "label": "buildHTMLParser",
      "command": "dotnet",
      "type": "process",
      "args": ["build", "${workspaceFolder}/src/HTMLParserApp/HTMLParserApp.csproj"],
      "problemMatcher": "$msCompile",
      "group": {
        "kind": "build",
        "isDefault": false
      }
    },
    {
      "label": "buildParticipantsParserApp",
      "command": "dotnet",
      "type": "process",
      "args": ["build", "${workspaceFolder}/src/ParticipantsParserApp/ParticipantsParserApp.csproj"],
      "problemMatcher": "$msCompile",
      "group": {
        "kind": "build",
        "isDefault": false
      }
    },
    {
      "label": "testParticipantsParserApp",
      "command": "dotnet",
      "type": "process",
      "args": ["test", "${workspaceFolder}/tests/ParticipantsParserApp/ParticipantsParserApp.Tests.csproj", "--logger:trx"],
      "problemMatcher": "$msCompile",
      "group": {
        "kind": "test",
        "isDefault": true
      },
      "dependsOn": "build"
    },
    {
      // This task is a compound task that runs the build and test tasks for the ParticipantsParserApp project
      // This task is atempting to put the test results under _devLogs
      // This task has syntax errors. DO NOT USE
      "label": "test2ParticipantsParserApp",
      "type": "shell",
      "command": "pwsh",
      "args": [
        "-Command",
        "& {",
        "$timestamp = Get-Date -Format 'yyyy-MM-dd_HH_mm_ss';",
        "$username = $env:USERNAME;",
        "$computername = $env:COMPUTERNAME;",
        "$logFileName = \"${workspaceFolder}/_devLogs/tests/ParticipantsParserApp/TestResults/${username}_${computername}_$timestamp.trx\";",
        "dotnet test ${workspaceFolder}/tests/ParticipantsParserApp/ParticipantsParserApp.Tests.csproj --logger:\"trx;LogFileName=$logFileName\"",
        "}"
      ],
      "problemMatcher": "$msCompile",
      "group": {
        "kind": "test",
        "isDefault": true
      },
      "dependsOn": "buildParticipantsParserApp"
    },
    {
      "label": "BuildCodeAnalysis",
      "command": "dotnet",
      "type": "process",
      "args": [
        "build",
        "src/ATAP.Console.CodeAnalysis/ATAP.Console.CodeAnalysis.csproj",
        "/p:GenerateFullPaths=true",
        "/p:Configuration=Debug",
        "/p:DeployOnBuild=true",
        "/p:PublishProfile=\"properties/publishProfiles/Development.pubxml\"",
        "/p:TargetFramework=net48",
        "/bl:_devlogs/msbuild.binlog",
        "/clp:NoSummary"
      ],
      "presentation": {
        "reveal": "always",
        "echo": true
      },
      "problemMatcher": "$msCompile",
      "group": {
        "kind": "build"
      }
    },
    {
      "label": "watch",
      "command": "dotnet",
      "type": "process",
      "args": [
        "watch",
        "run",
        "${workspaceFolder}/${fileDirname}.csproj",
        "/p:Configuration=Debug",
        "/p:DeployOnBuild=true",
        "/p:PublishProfile=\"properties/publishProfiles/Development.pubxml\"",
        "/p:TargetFramework=net48",
        "/bl:_devlogs/msbuild.binlog"
      ],
      "problemMatcher": "$msCompile",
      "group": {
        "kind": "build"
      }
    },
    // {
    //   "label": "build",
    //   "type": "shell",
    //   "command": "msbuild",
    //   "args": [
    //     "/property:GenerateFullPaths=true",
    //     "/property:Configuration=Debug",
    //     "/t:build",
    //     "/consoleloggerparameters:NoSummary"
    //   ],
    //   "group": {
    //     "kind": "build",
    //     "isDefault": true
    //   },
    //   "presentation": {
    //     "reveal": "silent"
    //   },
    //   "problemMatcher": "$msCompile"
    // }

    //  ************************************************************************
    // VoiceAttack plugin development
    {
      "label": "buildVA",
      "command": "dotnet",
      "type": "process",
      "args": [
        "build",
        "src/ATAP.Utilities.VoiceAttack/ATAP.Utilities.VoiceAttack.csproj",
        "/p:GenerateFullPaths=true",
        "/p:Configuration=Debug",
        "/p:DeployOnBuild=true",
        "/p:PublishProfile=\"properties/publishProfiles/Development.pubxml\"",
        "/p:TargetFramework=net48",
        "/bl:_devlogs/msbuild.binlog",
        "/clp:NoSummary"
      ],
      "presentation": {
        "reveal": "always",
        "echo": true
      },
      "problemMatcher": "$msCompile",
      "group": {
        "kind": "build"
      }
    },
    {
      "label": "publishVA",
      "command": "dotnet",
      "type": "process",
      "args": [
        "publish",
        "src/ATAP.Utilities.VoiceAttack/ATAP.Utilities.VoiceAttack.csproj",
        "/p:Configuration=Debug",
        "/p:DeployOnBuild=true",
        "/p:PublishProfile=\"properties/publishProfiles/Development.pubxml\"",
        "/p:TargetFramework=net48",
        "/bl:_devlogs/msbuild.binlog"
      ],
      "problemMatcher": "$msCompile",
      "group": {
        "kind": "build"
      }
    },
    {
      "label": "startVA",
      "command": "C:\\Program Files\\VoiceAttack\\VoiceAttack.exe",
      "type": "process",
      "args": ["-bypassimpropershutdowncheck"],
      "presentation": {
        "reveal": "always",
        "echo": true
      }
    },
    {
      "label": "stopVA",
      "command": "pwsh",
      "type": "shell",
      "args": ["-ExecutionPolicy", "Unrestricted", "-Command", "stopVA"],
      "presentation": {
        "reveal": "always",
        "echo": true
      }
    },
    {
      "label": "publishPluginAndStartVA",
      "command": "pwsh",
      "type": "shell",
      "args": ["-ExecutionPolicy", "Unrestricted", "-Command", "psva"],
      "presentation": {
        "reveal": "always",
        "echo": true
      },
      "problemMatcher": []
    }
  ]
}
