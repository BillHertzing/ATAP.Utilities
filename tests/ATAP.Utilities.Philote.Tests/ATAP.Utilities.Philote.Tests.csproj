<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <Nullable>enable</Nullable>
    <!-- Assembly, File, and Package Information for this assembly-->
    <!-- Build and revision are created based on date-->
    <MajorVersion>0</MajorVersion>
    <MinorVersion>1</MinorVersion>
    <PatchVersion>0</PatchVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="FluentAssertions" />
    <PackageReference Include="Moq" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.console">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="xunit.runner.visualstudio">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers</IncludeAssets>
    </PackageReference>
    <PackageReference Include="coverlet.collector">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <!-- Conditional-SUT pattern per CSharp-Packages-Test-Process.md S3.1:
       promotion tiers pass UsePackageReferenceForSUT=true and SUTVersion=<promoted-version>
       so this test project consumes the promoted Philote packages instead of local project refs. -->
  <PropertyGroup>
    <UsePackageReferenceForSUT Condition="'$(UsePackageReferenceForSUT)' == ''">false</UsePackageReferenceForSUT>
  </PropertyGroup>

  <ItemGroup Condition="'$(UsePackageReferenceForSUT)' == 'false'">
    <ProjectReference Include="..\..\src\ATAP.Utilities.Philote\DefaultConfiguration\ATAP.Utilities.Philote.DefaultConfiguration.csproj" />
    <ProjectReference Include="..\..\src\ATAP.Utilities.Philote\Interfaces\ATAP.Utilities.Philote.Interfaces.csproj" />
    <ProjectReference Include="..\..\src\ATAP.Utilities.Philote\Models\ATAP.Utilities.Philote.Models.csproj" />
    <ProjectReference Include="..\..\src\ATAP.Utilities.Philote\JsonConverter.Shim.SystemTextJson\ATAP.Utilities.Philote.JsonConverter.Shim.SystemTextJson.csproj" />
    <ProjectReference Include="..\..\src\ATAP.Utilities.Philote\ATAP.Utilities.Philote.csproj" />
  </ItemGroup>

  <!-- Package-consumption SUT fixture: permit the promoted package version supplied by the caller. -->
  <PropertyGroup Condition="'$(UsePackageReferenceForSUT)' == 'true'">
    <CentralPackageVersionOverrideEnabled>true</CentralPackageVersionOverrideEnabled>
  </PropertyGroup>

  <ItemGroup Condition="'$(UsePackageReferenceForSUT)' == 'true'">
    <PackageReference Include="ATAP.Utilities.Philote.DefaultConfiguration" VersionOverride="$(SUTVersion)" />
    <PackageReference Include="ATAP.Utilities.Philote.Interfaces" VersionOverride="$(SUTVersion)" />
    <PackageReference Include="ATAP.Utilities.Philote" VersionOverride="$(SUTVersion)" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\ATAP.Utilities.DateTime.Interfaces\ATAP.Utilities.DateTime.Interfaces.csproj" />
    <ProjectReference Include="..\..\src\ATAP.Utilities.DateTime.Model\ATAP.Utilities.DateTime.Model.csproj" />
    <ProjectReference Include="..\..\src\ATAP.Utilities.StronglyTypedId\Interfaces\ATAP.Utilities.StronglyTypedId.Interfaces.csproj" />
    <ProjectReference Include="..\..\src\ATAP.Utilities.StronglyTypedId\Models\ATAP.Utilities.StronglyTypedId.Models.csproj" />
  </ItemGroup>

</Project>
