              "code": "for ($feedNamesIndex = 0; $feedNamesIndex -lt $feedNames.Count; $feedNamesIndex++) {\n  $feedName = $feedNames[$feedNamesIndex]\n  $feed = $($global:settings[$global:ConfigRootKeys['PackageRepositoriesCollectionConfigRootKey']][$feedName])\n  $feedShortName = $feed.ShortName\n\n  $uri = \"http://${ProGetHost}:${ProGetBasePort}/api/feeds/delete\"\n  $headers = @{ \"X-ApiKey\" = $adminApiKey }\n  $body = @{\n    feed = $feedShortName\n  }\n\n  if ($PSCmdlet.ShouldProcess(\"ProGet\", \"Delete feed '$feedShortName'\")) {\n    try {\n      $response = Invoke-RestMethod -Uri $uri -Method Post -Headers $headers -Body $body\n      Write-PSFMessage -Level Important -Message \"Deleted feed '$feedShortName' successfully.\"\n    } catch {\n      Write-PSFMessage -Level Error -Message \"Failed to delete feed '$feedShortName': $_\"\n    }\n  }\n}\n",
