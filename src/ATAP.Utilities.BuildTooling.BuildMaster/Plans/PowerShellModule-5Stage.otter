##########################################################################
# PowerShellModule-5Stage - BuildMaster OtterScript Plan
#
# Variables (Application Variables - set in BuildMaster Application config):
#   $ApplicationName  - BuildMaster application name, e.g. "ATAP.Utilities.PowerShell"
#   $SourcePath       - absolute path to the developer/build worktree
#   $ModuleName       - module folder under src/, e.g. "ATAP.Utilities.BuildTooling.PowerShell"
#   $PackageName      - ProGet package/module ID, normally the same as $ModuleName
#   $PackageVersion   - exact package version to promote/test
#   $ProGetApiKey     - masked BuildMaster variable for ProGet API calls
#   $Tier             - current BuildMaster tier/stage
#
# Experimental builds the PowerShell module nupkg once and publishes it to
# powershellget-experimental. Later stages promote that same immutable nupkg
# and run tests against the promoted module; they do not rebuild or repack.
#
# Immutable build strategy:
#   Adheres to the immutable build strategy: build occurs only in the
#   Experimental stage; later stages promote the same bytes via
#   Promote-ProGetPackage.
#   Topology doc: SolutionDocumentation/BuildMaster-Pipeline-Topology.md
##########################################################################

# BuildTooling module used by every stage command.
set $BuildToolingModuleManifest = $PathCombine($SourcePath, src\ATAP.Utilities.BuildTooling.PowerShell\ATAP.Utilities.BuildTooling.PowerShell.psd1);

# Module source/package paths.
set $ModulePath = $PathCombine($SourcePath, src\$ModuleName);
set $PackageOutputPath = $PathCombine($SourcePath, _generated\psmodules\$ModuleName\packages-nupkg);
set $NupkgPathFile = $PathCombine($SourcePath, _generated\buildmaster\$ModuleName.nupkg-path.tmp);

# Canonical PowerShellGet feed names.
set $ExperimentalFeed = powershellget-experimental;
set $DevelopmentFeed = powershellget-development;
set $IntegrationFeed = powershellget-integration;
set $QAFeed = powershellget-qa;
set $ProductionFeed = powershellget-stable;

# -------------------------------------------------------------------------
# Stage Experimental - pack once and publish to powershellget-experimental
# -------------------------------------------------------------------------
stage Experimental
{
    if $Tier == Experimental
    {
        Exec
        (
            FileName: pwsh,
            Arguments: `-NoProfile -Command "Import-Module '$BuildToolingModuleManifest' -Force; New-Item -ItemType Directory -Path (Split-Path -Parent '$NupkgPathFile') -Force | Out-Null; $$nupkg = New-PSModuleNupkg -ModulePath '$ModulePath' -OutputPath '$PackageOutputPath' -Force; $$nupkg.FullName | Set-Content -LiteralPath '$NupkgPathFile' -Encoding utf8 -NoNewline"`,
            WorkingDirectory: $SourcePath,
            SuccessExitCode: 0
        );

        Exec
        (
            FileName: pwsh,
            Arguments: `-NoProfile -Command "$$env:PROGET_APIKEY_POWERSHELLGET_EXPERIMENTAL = '$Decrypt($ProGetApiKey)'; $$env:PROGET_ADMIN_API_KEY = '$Decrypt($ProGetApiKey)'; Import-Module '$BuildToolingModuleManifest' -Force; $$nupkgPath = (Get-Content -LiteralPath '$NupkgPathFile' -Raw).Trim(); Publish-PSModuleToProGet -NupkgPath $$nupkgPath"`,
            WorkingDirectory: $SourcePath,
            SuccessExitCode: 0
        );

        Create-Artifact Packages
        (
            From: _generated\psmodules\$ModuleName\packages-nupkg,
            Include: @(*.nupkg)
        );
    }
}

# -------------------------------------------------------------------------
# Stage Development - promote artifact + run module tests against it
# -------------------------------------------------------------------------
stage Development
{
    if $Tier == Development
    {
        set $FromFeed = $ExperimentalFeed;
        set $ToFeed = $DevelopmentFeed;

        Exec
        (
            FileName: pwsh,
            Arguments: `-NoProfile -Command "$$env:PROGET_BUILDMASTER_API_KEY = '$Decrypt($ProGetApiKey)'; Import-Module '$BuildToolingModuleManifest' -Force; Promote-ProGetPackage -Name '$PackageName' -Version '$PackageVersion' -FromFeed '$FromFeed' -ToFeed '$ToFeed' -Reason 'DEV-PASS for $ApplicationName $PackageVersion'"`,
            WorkingDirectory: $SourcePath,
            SuccessExitCode: 0
        );

        Exec
        (
            FileName: pwsh,
            Arguments: `-NoProfile -Command "Import-Module '$BuildToolingModuleManifest' -Force; Invoke-PromotedModuleTests -Name '$PackageName' -Version '$PackageVersion' -Feed '$ToFeed' -Tier '$Tier' -ResultsPath '_generated\testresults\$Tier'"`,
            WorkingDirectory: $SourcePath,
            SuccessExitCode: 0
        );

        Create-Artifact TestResults
        (
            From: _generated\testresults\$Tier,
            Include: @(*.xml, *.trx)
        );
    }
}

# -------------------------------------------------------------------------
# Stage Integration - promote artifact + run module tests against it
# -------------------------------------------------------------------------
stage Integration
{
    if $Tier == Integration
    {
        set $FromFeed = $DevelopmentFeed;
        set $ToFeed = $IntegrationFeed;

        Exec
        (
            FileName: pwsh,
            Arguments: `-NoProfile -Command "$$env:PROGET_BUILDMASTER_API_KEY = '$Decrypt($ProGetApiKey)'; Import-Module '$BuildToolingModuleManifest' -Force; Promote-ProGetPackage -Name '$PackageName' -Version '$PackageVersion' -FromFeed '$FromFeed' -ToFeed '$ToFeed' -Reason 'INT-PASS for $ApplicationName $PackageVersion'"`,
            WorkingDirectory: $SourcePath,
            SuccessExitCode: 0
        );

        Exec
        (
            FileName: pwsh,
            Arguments: `-NoProfile -Command "Import-Module '$BuildToolingModuleManifest' -Force; Invoke-PromotedModuleTests -Name '$PackageName' -Version '$PackageVersion' -Feed '$ToFeed' -Tier '$Tier' -ResultsPath '_generated\testresults\$Tier'"`,
            WorkingDirectory: $SourcePath,
            SuccessExitCode: 0
        );

        Create-Artifact TestResults
        (
            From: _generated\testresults\$Tier,
            Include: @(*.xml, *.trx)
        );
    }
}

# -------------------------------------------------------------------------
# Stage QA - promote artifact + run module tests against it
# -------------------------------------------------------------------------
stage QA
{
    if $Tier == QA
    {
        set $FromFeed = $IntegrationFeed;
        set $ToFeed = $QAFeed;

        Exec
        (
            FileName: pwsh,
            Arguments: `-NoProfile -Command "$$env:PROGET_BUILDMASTER_API_KEY = '$Decrypt($ProGetApiKey)'; Import-Module '$BuildToolingModuleManifest' -Force; Promote-ProGetPackage -Name '$PackageName' -Version '$PackageVersion' -FromFeed '$FromFeed' -ToFeed '$ToFeed' -Reason 'QA-PASS for $ApplicationName $PackageVersion'"`,
            WorkingDirectory: $SourcePath,
            SuccessExitCode: 0
        );

        Exec
        (
            FileName: pwsh,
            Arguments: `-NoProfile -Command "Import-Module '$BuildToolingModuleManifest' -Force; Invoke-PromotedModuleTests -Name '$PackageName' -Version '$PackageVersion' -Feed '$ToFeed' -Tier '$Tier' -ResultsPath '_generated\testresults\$Tier'"`,
            WorkingDirectory: $SourcePath,
            SuccessExitCode: 0
        );

        Create-Artifact TestResults
        (
            From: _generated\testresults\$Tier,
            Include: @(*.xml, *.trx, coverage.cobertura.xml)
        );
    }
}

# -------------------------------------------------------------------------
# Stage Production - promote artifact + smoke test against stable feed
# -------------------------------------------------------------------------
stage Production
{
    if $Tier == Production
    {
        set $FromFeed = $QAFeed;
        set $ToFeed = $ProductionFeed;

        Exec
        (
            FileName: pwsh,
            Arguments: `-NoProfile -Command "$$env:PROGET_BUILDMASTER_API_KEY = '$Decrypt($ProGetApiKey)'; Import-Module '$BuildToolingModuleManifest' -Force; Promote-ProGetPackage -Name '$PackageName' -Version '$PackageVersion' -FromFeed '$FromFeed' -ToFeed '$ToFeed' -Reason 'PROD-APPROVAL for $ApplicationName $PackageVersion'"`,
            WorkingDirectory: $SourcePath,
            SuccessExitCode: 0
        );

        Exec
        (
            FileName: pwsh,
            Arguments: `-NoProfile -Command "Import-Module '$BuildToolingModuleManifest' -Force; Invoke-PromotedModuleTests -Name '$PackageName' -Version '$PackageVersion' -Feed '$ToFeed' -Tier '$Tier' -ResultsPath '_generated\testresults\$Tier'"`,
            WorkingDirectory: $SourcePath,
            SuccessExitCode: 0
        );

        Create-Artifact TestResults
        (
            From: _generated\testresults\$Tier,
            Include: @(*.xml, *.trx)
        );
    }
}
