// A tasks configuration that defines
//   Build Tasks
//     runs npm to compile Typescript application and watch for changes (and then recompile)
//     runs npm to compile Typescript test file and watch for changes (and then recompile)
//     runs a compound tasks to compile typescript application and its test files and to watch for changes in either (and then recompile)
//     ToDo: Untested: Runs Invoke-Pester with VSCCodeMarkers
//     ToDo: Untested: Builds a C# project using dotnet build and multiple ATAP specific build arguments
//     ToDo: Untested: Builds the ATAP CodeAnalysis c# project using dotnet build and multiple ATAP specific build arguments
//     ToDo: Untested: Builds the ATAP VoiceAttack plugin C# project using dotnet build and multiple ATAP specific build arguments
//     ToDo: Untested: Publishes the ATAP VoiceAttack plugin C# project using dotnet publish and multiple ATAP specific build / publish arguments
//     ToDo: Untested: Starts the VoiceAttack program
//     ToDo: Untested: Publishes the ATAP VoiceAttack plugin C# project and starts the VoiceAttack program. Uses a Powershell function (PublishPluginAndStartVAProcess) and alias (psva) defined in the AllHosts profile
//     ToDo: Untested: Stops the VoiceAttack program. Uses a Powershell function (StopVoiceAttackProcess) and alias (stopVA) defined in the AllHosts profile
//     ToDo: Untested: Runs a C# project using dotnet watch and run and multiple ATAP specific build arguments
// See https://go.microsoft.com/fwlink/?LinkId=733558
// for the documentation about the tasks.json format
{
  "version": "2.0.0",
  // Define the 'shell' for each OS. This makes pwsh (cross-platform Powershell V7+) the shell, and defines the path and arguments for invoking it on each OS
  "windows": {
    "options": {
      "shell": {
        "executable": "pwsh.exe",
        "args": ["-ExecutionPolicy", "Bypass", "-Command"]
      }
    }
  },
  "linux": {
    "options": {
      "shell": {
        "executable": "/usr/bin/pwsh",
        "args": ["-NoProfile", "-Command"]
      }
    }
  },
  "osx": {
    "options": {
      "shell": {
        "executable": "/usr/local/bin/pwsh",
        "args": ["-NoProfile", "-Command"]
      }
    }
  },
  "tasks": [
    //  ************************************************************************
    // VSC Extension development
    {
      "label": "showVSCEnvironment(Task)",
      "type": "shell",
      "command": "$message = 'workspaceFolder = ${workspaceFolder} ; fileDirname = ${fileDirname}';Write-PSFMessage -Level Important -Message $message "
    },
    {
      "label": "npm: watch",
      "type": "npm",
      // watch script is found in package.json
      "script": "watch",
      "options": {
        "cwd": "."
      },
      "problemMatcher": "$ts-webpack-watch",
      //"problemMatcher": "$tsc-watch",
      "isBackground": true,
      "presentation": {
        "reveal": "never",
        "group": "watchers"
      },
      "group": {
        "kind": "build",
        "isDefault": true
      }
    },
    {
      "label": "npm: watch-tests",
      "type": "npm",
      // watch-tests script is found in package.json
      "script": "watch-tests",
      "options": {
        "cwd": "."
      },
      "problemMatcher": "$tsc-watch",
      "isBackground": true,
      "presentation": {
        "reveal": "never",
        "group": "watchers"
      },
      "group": {
        "kind": "build"
      }
    },
    {
      "label": "tasks: watch-tests",
      "dependsOn": ["npm: watch", "npm: watch-tests"],
      "problemMatcher": []
    }
  ]
}
