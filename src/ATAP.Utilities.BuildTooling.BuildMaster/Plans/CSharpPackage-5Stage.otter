##########################################################################
# CSharpPackage-5Stage — BuildMaster OtterScript Plan
#
# Variables (Application Variables — set in BuildMaster Application config):
#   $ApplicationName         — "ATAP.Utilities"
#   $Branch                  — branch being built
#   $SourcePath              — absolute path to worktree
#                              (BuildMaster App Variable name: ATAPUtilitiesSourcePath)
#   $SprintNumber            — current sprint number, e.g. "0006"  (task 1.3-5)
#   $UserName                — developer username, e.g. value of $env:USERNAME  (task 1.3-5)
#   $Configuration           — "Release"
#   $ProGetUrl               — e.g. "http://localhost:50000"
#   $ProGetApiKey            — masked; from PROGET_ADMIN_API_KEY env var
#   $MetaPackageName         — "ATAP.Utilities"
#
# Note (task 1.3-5): Sprint-feed Application Variables (SprintFeedName,
#   SprintFeedUrl) are NOT used. All five tiers use the permanent
#   nuget-* feeds only (reverted naming scheme).
#
# Tier names (from Explainer 602):
#   Experimental  ← NBGV label -Sprint-   → nuget-experimental
#   Development   ← NBGV label -Alpha-    → nuget-development
#   Integration   ← NBGV label -Beta-     → nuget-integration
#   QA            ← NBGV label -QA-       → nuget-qa
#   Production    ← NBGV label (stable)   → nuget-stable
#
# Retention policy (task 1.3-4 — configured per-feed in ProGet UI, not here):
#   nuget-experimental:  7 days
#   nuget-development:   30 days
#   nuget-integration:   indefinite (hermetic — no inbound connectors)
#   nuget-qa:            indefinite (hermetic — no inbound connectors)
#   nuget-stable:        indefinite (no inbound connectors)
##########################################################################

# Git::Checkout-Code is intentionally absent. $SourcePath is the developer worktree
# (set as a BuildMaster Application Variable). The worktree contains a .git file so
# NBGV can read version information. File-export checkout does not preserve .git.

# Resolve tier from NBGV.
# Step 1: Run nbgv and write output to a temp file under _generated/buildmaster/ (SC-0033)
Exec
(
    FileName: pwsh,
    Arguments: >>-NoProfile -Command "New-Item -ItemType Directory -Path '_generated\buildmaster' -Force | Out-Null; dotnet nbgv get-version --variable NuGetPackageVersion | Out-File '_generated\buildmaster\_nbgv.tmp' -Encoding utf8 -NoNewline">>,
    WorkingDirectory: $SourcePath,
    SuccessExitCode: 0
);

# Step 2: Read it into a variable using a real OtterScript function
set $NbgvTempFile = $PathCombine($SourcePath, _generated\buildmaster\_nbgv.tmp);
set $NbgvVersion  = $Trim($FileContents($NbgvTempFile));

set $PrereleaseLabel = $RegexReplace($NbgvVersion, "^[0-9]+\.[0-9]+\.[0-9]+-?([A-Za-z]*).*$", `$1`);

set $Tier = Experimental;
if $PrereleaseLabel == Alpha      { set $Tier = Development;  }
if $PrereleaseLabel == Beta       { set $Tier = Integration;  }
if $PrereleaseLabel == QA         { set $Tier = QA;           }
if $PrereleaseLabel == ""         { set $Tier = Production;   }

# Resolve feed name via Get-ATAPIACConstant (T-31) — no hard-coded feed names.
Exec pwsh
(
    Arguments: >>-NoProfile -File src/ATAP.Utilities.BuildTooling.BuildMaster/Scripts/Resolve-FeedName.ps1 -Tier $Tier -FeedType nuget -OutputFile _generated\buildmaster\_feedname.tmp>>,
    WorkingDirectory: $SourcePath,
    SuccessExitCode: 0
);
set $FeedNameTmp = $PathCombine($SourcePath, _generated\buildmaster\_feedname.tmp);
set $FeedName = $Trim($FileContents($FeedNameTmp));

Log-Debug "Resolved Tier=$Tier  Feed=$FeedName  from NuGetPackageVersion=$NbgvVersion";

# -------------------------------------------------------------------------
# Stage Experimental — build + unit tests (Category=Unit) + pack + push
#   task 1.6-1: unit tests added per tier-to-filter table
#   task 1.6-3: tests run against per-sprint Experimental SQL instance
# -------------------------------------------------------------------------
  if $Tier == Experimental
  {
      Exec dotnet (
        Arguments: "build ATAP.Utilities.sln --configuration $Configuration --no-incremental",
        WorkingDirectory: $SourcePath,
        SuccessExitCode: 0
      );
      # ---- task 1.6-1 / 1.6-3: Run Category=Unit tests; connection string → Experimental SQL instance ----
      # Reads dbConnectionString-ATAPUtilities-localhost-Experimental from User-scope env var
      # (populated by LoginScript.ps1 from the Bitwarden secret of the same name).
      Exec pwsh
      (
          Arguments: >>-NoProfile -Command "$$cs = [System.Environment]::GetEnvironmentVariable('dbConnectionString-ATAPUtilities-localhost-Experimental', 'User'); if ([string]::IsNullOrEmpty($$cs)) { throw 'Env var dbConnectionString-ATAPUtilities-localhost-Experimental not set. Run LoginScript.ps1 to populate it from the Bitwarden secret.' }; $$env:ConnectionStrings__Default = $$cs; dotnet test 'ATAP.Utilities.sln' --configuration $Configuration --no-build --filter 'Category=Unit' --logger trx --results-directory '_generated\testresults\$Tier'">>      ,
          WorkingDirectory: $SourcePath,
          SuccessExitCode: 0
      );
      Exec dotnet (
        Arguments: "pack ATAP.Utilities.sln --configuration $Configuration --no-build --output _generated\nuget\$Tier",
          WorkingDirectory: $SourcePath,
          SuccessExitCode: 0
      );
      Exec dotnet (
        Arguments: "nuget push _generated\nuget\$Tier\*.nupkg --source $ProGetUrl/nuget/$FeedName/v3/index.json --api-key $ProGetApiKey --skip-duplicate",
          WorkingDirectory: $SourcePath,
          SuccessExitCode: 0
      );
      Create-Artifact TestResults
      (
          From: _generated\testresults\$Tier,
          Include: @(*.trx)
      );
      Create-Artifact Packages
      (
          From: _generated\nuget\$Tier,
          Include: @(*.nupkg, *.snupkg)
      );
  }
# -------------------------------------------------------------------------
# Stage Development — build + all tests + pack + publish to nuget-development
#   task 1.6-3: tests run against per-sprint Development SQL instance
# -------------------------------------------------------------------------
  if $Tier == Development
  {
      Exec dotnet (
        Arguments: "build ATAP.Utilities.sln --configuration $Configuration --no-incremental",
          WorkingDirectory: $SourcePath,
          SuccessExitCode: 0
      );
      # ---- task 1.6-3: Set per-sprint Development SQL instance for all tests ----
      # Reads dbConnectionString-ATAPUtilities-localhost-Development from User-scope env var
      # (populated by LoginScript.ps1 from the Bitwarden secret of the same name).
      Exec pwsh
      (
          Arguments: >>-NoProfile -Command "$$cs = [System.Environment]::GetEnvironmentVariable('dbConnectionString-ATAPUtilities-localhost-Development', 'User'); if ([string]::IsNullOrEmpty($$cs)) { throw 'Env var dbConnectionString-ATAPUtilities-localhost-Development not set. Run LoginScript.ps1 to populate it from the Bitwarden secret.' }; $$env:ConnectionStrings__Default = $$cs; dotnet test 'ATAP.Utilities.sln' --configuration $Configuration --no-build --logger trx --results-directory '_generated\testresults\$Tier'">>      ,
          WorkingDirectory: $SourcePath,
          SuccessExitCode: 0
      );
      # ---- task 7.3-2: Failure-Acknowledged gate ----
      Exec pwsh
      (
          Arguments: >>-NoProfile -Command "Import-Module '$SourcePath\src\ATAP.Utilities.BuildTooling.PowerShell\ATAP.Utilities.BuildTooling.PowerShell.psd1' -Force; $$r = Invoke-FailureAcknowledgedGate -ResultFile '$SourcePath\_generated\testresults\$Tier' -AcknowledgedFile '$SourcePath\FailureAcknowledged.json' -Tier '$Tier'; if (-not $$r.GatePass) { throw ('Failure-Acknowledged gate FAILED at $Tier: ' + $$r.Unacknowledged + ' unacknowledged failure(s).') }">>      ,
          WorkingDirectory: $SourcePath,
          SuccessExitCode: 0
      );
      Exec dotnet (
        Arguments: "pack ATAP.Utilities.sln --configuration $Configuration --no-build --output _generated\nuget\$Tier",
          WorkingDirectory: $SourcePath,
          SuccessExitCode: 0
      );
      Exec dotnet (
        Arguments: "nuget push _generated\nuget\$Tier\*.nupkg --source $ProGetUrl/nuget/$FeedName/v3/index.json --api-key $ProGetApiKey --skip-duplicate",
          WorkingDirectory: $SourcePath,
          SuccessExitCode: 0
      );
      Create-Artifact TestResults
      (
          From: _generated\testresults\$Tier,
          Include: @(*.trx)
      );
      Create-Artifact Packages
      (
          From: _generated\nuget\$Tier,
          Include: @(*.nupkg, *.snupkg)
      );
  }
# -------------------------------------------------------------------------
# Stage Integration — build + unit + integration tests + pack + publish
# -------------------------------------------------------------------------
  if $Tier == Integration
  {
      Exec dotnet (
        Arguments: "build ATAP.Utilities.sln --configuration $Configuration --no-incremental",
          WorkingDirectory: $SourcePath,
          SuccessExitCode: 0
      );
      # ---- task 1.6-3: Set permanent Integration SQL instance for unit + integration tests ----
      # Reads dbConnectionString-ATAPUtilities-localhost-Integration from User-scope env var
      # (populated by LoginScript.ps1 from the permanent Bitwarden secret of the same name).
      Exec pwsh
      (
          Arguments: >>-NoProfile -Command "$$cs = [System.Environment]::GetEnvironmentVariable('dbConnectionString-ATAPUtilities-localhost-Integration', 'User'); if ([string]::IsNullOrEmpty($$cs)) { throw 'Env var dbConnectionString-ATAPUtilities-localhost-Integration not set. Run LoginScript.ps1 to populate it from the Bitwarden secret.' }; $$env:ConnectionStrings__Default = $$cs; dotnet test 'ATAP.Utilities.sln' --configuration $Configuration --no-build --filter 'Category=Unit|Category=Integration' --logger trx --results-directory '_generated\testresults\$Tier'">>      ,
          WorkingDirectory: $SourcePath,
          SuccessExitCode: 0
      );
      # ---- task 7.3-2: Failure-Acknowledged gate ----
      Exec pwsh
      (
          Arguments: >>-NoProfile -Command "Import-Module '$SourcePath\src\ATAP.Utilities.BuildTooling.PowerShell\ATAP.Utilities.BuildTooling.PowerShell.psd1' -Force; $$r = Invoke-FailureAcknowledgedGate -ResultFile '$SourcePath\_generated\testresults\$Tier' -AcknowledgedFile '$SourcePath\FailureAcknowledged.json' -Tier '$Tier'; if (-not $$r.GatePass) { throw ('Failure-Acknowledged gate FAILED at $Tier: ' + $$r.Unacknowledged + ' unacknowledged failure(s).') }">>      ,
          WorkingDirectory: $SourcePath,
          SuccessExitCode: 0
      );
      Exec dotnet (
        Arguments: "pack ATAP.Utilities.sln --configuration $Configuration --no-build --output _generated\nuget\$Tier",
          WorkingDirectory: $SourcePath,
          SuccessExitCode: 0
      );
      Exec dotnet (
        Arguments: "nuget push _generated\nuget\$Tier\*.nupkg --source $ProGetUrl/nuget/$FeedName/v3/index.json --api-key $ProGetApiKey --skip-duplicate",
          WorkingDirectory: $SourcePath,
          SuccessExitCode: 0
      );
      Create-Artifact TestResults ( From: _generated\testresults\$Tier, Include: @(*.trx) );
      Create-Artifact Packages    ( From: _generated\nuget\$Tier,       Include: @(*.nupkg, *.snupkg) );

      # ---- task 1.3-3: AceCommander smoke-test gate (manual, blocks QA promotion) ----
      # Before promoting packages to nuget-qa a human must:
      #   1. Build AceCommander targeting the packages just pushed to nuget-integration.
      #   2. Perform a smoke-test of the running application.
      #   3. Create the approval marker file at:
      #        $SourcePath\_generated\gates\SmokeTest-Integration.approved
      # This step fails with a clear error if the marker is absent, blocking QA promotion.
      Exec pwsh
      (
          Arguments: >>-NoProfile -Command "if (-not (Test-Path '$SourcePath\_generated\gates\SmokeTest-Integration.approved')) { throw 'Integration gate not cleared. Complete the AceCommander smoke-test and create the approval marker file before promoting to QA.' }">>      ,
          WorkingDirectory: $SourcePath,
          SuccessExitCode: 0
      );
      Log-Information "Integration smoke-test gate passed — promoting packages to QA feed.";

      # ---- task 1.3-2: Promote packages from nuget-integration → nuget-qa ----
      # Move-ProGetPackageInterTier auto-resolves the destination feed from -SourceFeed.
      Exec pwsh
      (
          Arguments: >>-NoProfile -Command "Import-Module 'ATAP.Utilities.BuildTooling.PowerShell'; $srcFeed = Get-ATAPIACConstant -Name 'NuGetFeedName_Integration'; Move-ProGetPackageInterTier -PackageName '$MetaPackageName' -Version '$NbgvVersion' -SourceFeed $srcFeed -ProGetBaseUrl '$ProGetUrl' -ApiKey '$ProGetApiKey' -Comments 'Promoted to QA after Integration smoke-test gate passed (Sprint $SprintNumber, User $UserName)'">>      ,
          WorkingDirectory: $SourcePath,
          SuccessExitCode: 0
      );
  }
# -------------------------------------------------------------------------
# Stage QA — full suite + coverage + pack + publish
# -------------------------------------------------------------------------
  if $Tier == QA
  {
      Exec dotnet (
        Arguments: "build ATAP.Utilities.sln --configuration $Configuration --no-incremental",
          WorkingDirectory: $SourcePath,
          SuccessExitCode: 0
      );
      # ---- task 1.6-1: Full test suite at QA (no filter); 1.6-2: collect coverage for gate ----
      Exec dotnet (
        Arguments: >>test ATAP.Utilities.sln --configuration $Configuration --no-build --logger trx --collect:"XPlat Code Coverage" --results-directory _generated\testresults\$Tier>>,
          WorkingDirectory: $SourcePath,
          SuccessExitCode: 0
      );
      # ---- task 7.3-2: Failure-Acknowledged gate ----
      Exec pwsh
      (
          Arguments: >>-NoProfile -Command "Import-Module '$SourcePath\src\ATAP.Utilities.BuildTooling.PowerShell\ATAP.Utilities.BuildTooling.PowerShell.psd1' -Force; $$r = Invoke-FailureAcknowledgedGate -ResultFile '$SourcePath\_generated\testresults\$Tier' -AcknowledgedFile '$SourcePath\FailureAcknowledged.json' -Tier '$Tier'; if (-not $$r.GatePass) { throw ('Failure-Acknowledged gate FAILED at $Tier: ' + $$r.Unacknowledged + ' unacknowledged failure(s).') }">>      ,
          WorkingDirectory: $SourcePath,
          SuccessExitCode: 0
      );
      # ---- task 1.6-2: Coverage gate — fail if line coverage < 70% ----
      # coverlet writes coverage.cobertura.xml into a GUID-named subfolder; discover at runtime.
      Exec pwsh
      (
          Arguments: >>-NoProfile -Command "Import-Module 'ATAP.Utilities.BuildTooling.PowerShell'; $$xmlFile = Get-ChildItem -Path '_generated\testresults\$Tier' -Filter 'coverage.cobertura.xml' -Recurse | Select-Object -First 1; if (-not $$xmlFile) { throw 'No coverage.cobertura.xml found under _generated\testresults\$Tier — verify dotnet test ran with --collect:\"XPlat Code Coverage\".' }; $$gate = Test-CodeCoverageGate -CoverageFile $$xmlFile.FullName -Tier QA -Threshold 70; if (-not $$gate.GatePass) { throw ('Coverage gate FAILED at QA tier: {0:F1}% < {1:F1}%' -f $$gate.CoveragePct, $$gate.Threshold) }">>      ,
          WorkingDirectory: $SourcePath,
          SuccessExitCode: 0
      );
      Exec dotnet (
        Arguments: "pack ATAP.Utilities.sln --configuration $Configuration --no-build --output _generated\nuget\$Tier",
          WorkingDirectory: $SourcePath,
          SuccessExitCode: 0
      );
      Exec dotnet (
        Arguments: "nuget push _generated\nuget\$Tier\*.nupkg --source $ProGetUrl/nuget/$FeedName/v3/index.json --api-key $ProGetApiKey --skip-duplicate",
          WorkingDirectory: $SourcePath,
          SuccessExitCode: 0
      );
      Create-Artifact TestResults ( From: _generated\testresults\$Tier, Include: @(*.trx, coverage.cobertura.xml) );
      Create-Artifact Packages    ( From: _generated\nuget\$Tier,       Include: @(*.nupkg, *.snupkg) );
  }
# -------------------------------------------------------------------------
# Stage Production — signed packages + full suite + publish to nuget-stable
# -------------------------------------------------------------------------
  if $Tier == Production
  {
      Exec dotnet (
        Arguments: "build ATAP.Utilities.sln --configuration $Configuration --no-incremental",
          WorkingDirectory: $SourcePath,
          SuccessExitCode: 0
      );
      # ---- task 1.6-1: Run Category=Smoke tests only at Production tier ----
      Exec dotnet (
        Arguments: >>test ATAP.Utilities.sln --configuration $Configuration --no-build --filter "Category=Smoke" --logger trx --collect:"XPlat Code Coverage" --results-directory _generated\testresults\$Tier>>,
          WorkingDirectory: $SourcePath,
          SuccessExitCode: 0
      );
      # ---- task 7.3-2: Failure-Acknowledged gate ----
      Exec pwsh
      (
          Arguments: >>-NoProfile -Command "Import-Module '$SourcePath\src\ATAP.Utilities.BuildTooling.PowerShell\ATAP.Utilities.BuildTooling.PowerShell.psd1' -Force; $$r = Invoke-FailureAcknowledgedGate -ResultFile '$SourcePath\_generated\testresults\$Tier' -AcknowledgedFile '$SourcePath\FailureAcknowledged.json' -Tier '$Tier'; if (-not $$r.GatePass) { throw ('Failure-Acknowledged gate FAILED at $Tier: ' + $$r.Unacknowledged + ' unacknowledged failure(s).') }">>      ,
          WorkingDirectory: $SourcePath,
          SuccessExitCode: 0
      );
      Exec dotnet (
        Arguments: "pack ATAP.Utilities.sln --configuration $Configuration --no-build --output _generated\nuget\$Tier",
          WorkingDirectory: $SourcePath,
          SuccessExitCode: 0
      );
      # Optional: sign packages before push
      # Exec ( FileName: dotnet, Arguments: `nuget sign _generated\nuget\$Tier\*.nupkg --certificate-path ... --timestamper ...` );
      Exec dotnet (
        Arguments: "nuget push _generated\nuget\$Tier\*.nupkg --source $ProGetUrl/nuget/$FeedName/v3/index.json --api-key $ProGetApiKey --skip-duplicate",
          WorkingDirectory: $SourcePath,
      SuccessExitCode: 0
  );
  Create-Artifact TestResults ( From: _generated\testresults\$Tier, Include: @(*.trx, coverage.cobertura.xml) );
  Create-Artifact Packages    ( From: _generated\nuget\$Tier,       Include: @(*.nupkg, *.snupkg) );
  }
