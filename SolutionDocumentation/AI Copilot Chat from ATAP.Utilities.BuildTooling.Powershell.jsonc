    {
      "requestId": "request_36d6f823-1392-4cc7-a3f0-c630334a3d81",
      "message": {
        "text": "are you sure about ::? [Environment]::Get-EnvironmentVariable($PSRepositoryFeedAPIKeyName)\r\nParserError: \r\nLine |\r\n   1 |  [Environment]::Get-EnvironmentVariable($PSRepositoryFeedAPIKeyName)\r\n     |                    ~~~~~~~~~~~~~~~~~~~~\r\n     | Unexpected token '-EnvironmentVariable' in expression or statement.\r\n",
        "parts": [
          {
            "range": {
              "start": 0,
              "endExclusive": 316
            },
            "editorRange": {
              "startLineNumber": 1,
              "startColumn": 1,
