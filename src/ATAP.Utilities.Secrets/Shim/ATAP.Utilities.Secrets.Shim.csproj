<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Library</OutputType>
    <EnableDefaultItems>false</EnableDefaultItems>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <IsPackable>true</IsPackable>
    <PackageDescription>Retired compatibility aggregator. Reference an explicit provider package; applications must use ATAP.Utilities.Secrets.BitwardenSecretsManager.</PackageDescription>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="Bitwarden\ATAP.Utilities.Secrets.Shim.Bitwarden.csproj" />
    <!-- Plugin excluded: depends on ATAP.Utilities.Loader which has unresolved dependencies -->
    <!-- <ProjectReference Include="Plugin\ATAP.Utilities.Secrets.Shim.Plugin.csproj" /> -->
  </ItemGroup>

  <!-- Packages and projects to implement IL Weaving using Fody during the build process -->
  <!-- MethodBoundaryAspect.Fody is injected by Directory.Build.targets; do not repeat here. -->
  <ItemGroup>
    <ProjectReference Include="..\..\ATAP.Utilities.ETW\ATAP.Utilities.ETW.csproj" />
  </ItemGroup>

</Project>
