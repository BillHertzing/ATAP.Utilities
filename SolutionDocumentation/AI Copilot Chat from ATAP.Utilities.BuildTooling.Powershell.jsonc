    {
      "requestId": "request_ee35fcea-b4ac-495f-9b89-80227b4724ff",
      "message": {
        "text": "tell me about instruction files for copilot, that can contain system prompt hints, and how I can create them specific to language (powershell or c#), or tasks )(coding, documenting, testing)",
        "parts": [
          {
            "range": {
