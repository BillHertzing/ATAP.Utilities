        C:\Path With Spaces\ExampleScript.ps1
      </ScriptLocation>
      <LogFileLocation Condition=" '$(LogFileLocation)'=='' ">
        C:\Path With Spaces\ExampleLogFileName.txt
      </LogFileLocation>
