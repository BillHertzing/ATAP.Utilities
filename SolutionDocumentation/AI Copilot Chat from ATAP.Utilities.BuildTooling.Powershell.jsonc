      "variableData": {
        "variables": [
          {
            "kind": "file",
            "id": "vscode.implicit.selection",
            "name": "file:module.build.ps1",
            "value": {
              "uri": {
                "$mid": 1,
                "fsPath": "c:\\Dropbox\\whertzing\\GitHub\\ATAP.Utilities\\src\\ATAP.Utilities.BuildTooling.PowerShell\\module.build.ps1",
                "_sep": 1,
                "external": "file:///c%3A/Dropbox/whertzing/GitHub/ATAP.Utilities/src/ATAP.Utilities.BuildTooling.PowerShell/module.build.ps1",
                "path": "/c:/Dropbox/whertzing/GitHub/ATAP.Utilities/src/ATAP.Utilities.BuildTooling.PowerShell/module.build.ps1",
                "scheme": "file"
              },
              "range": {
                "startLineNumber": 1115,
                "startColumn": 118,
                "endLineNumber": 1115,
                "endColumn": 141,
                "selectionStartLineNumber": 1115,
                "selectionStartColumn": 118,
