            {
              "type": 1,
              "text": "<attachments>\n<attachment id=\"file:Remove-ProGetApiKeys.ps1\">\nUser's current visible code, this should be the main focus:\nExcerpt from Remove-ProGetApiKeys.ps1, lines 1 to 35:\n```powershell\n# filepath: c:\\Dropbox\\whertzing\\GitHub\\ATAP.Utilities\\src\\ATAP.Utilities.IAC.Ansible.Powershell\\public\\Remove-ProGetApiKeys.ps1\nfunction Remove-ProGetApiKeys {\n  [CmdletBinding(SupportsShouldProcess = $true)]\n  param (\n    $proGetBaseScheme,\n    $proGetBaseHost,\n    $proGetBasePort,\n    [int[]] $iD\n  )\n  Begin {\n    Write-PSFMessage -Level Verbose -Message 'Entering function: Remove-ProGetApiKeys' -Tag 'Remove-ProGetApiKeys', 'Trace'\n    # if called with the globla preference variable 'ErrorActionPreference\" set to 'SilentlyContinue', the\n    # code will keep trying to delete all Ids, otherwise it will stop on the first error\n\n    # if not passed, get from the environment variable. If Not an environment variable fall back to the $global: value\n    if (-not $proGetBaseScheme) {\n      $proGetBaseScheme = [Environment]::GetEnvironmentVariable($global:configRootKeys['ProGetAdminUriSchemeConfigRootKey'], 'Process')\n if (-not $proGetBaseScheme) {\n        $progetBaseScheme = $global:Settings[$global:configRootKeys['ProGetAdminUriSchemeConfigRootKey']]\n if (-not $proGetBaseScheme) {\n          $errorMessage = 'ProGetBaseScheme is not available.'\n          Write-PSFMessage -Level Error -Message $errorMessage -Tag 'Remove-ProGetApiKeys', 'Trace', 'Error'\n          throw $errorMessage\n        }\n      }\n    }\n    if (-not $proGetBaseHost) {\n      $proGetBaseHost = [Environment]::GetEnvironmentVariable($global:configRootKeys['ProGetAdminUriHostConfigRootKey'], 'Process')\n if (-not $proGetBaseHost) {\n        $progetBaseHost = $global:Settings[$global:configRootKeys['ProGetAdminUriHostConfigRootKey']]\n if (-not $proGetBaseHost) {\n          $errorMessage = 'ProGetBaseHost is not available.'\n          Write-PSFMessage -Level Error -Message $errorMessage -Tag 'Remove-ProGetApiKeys', 'Trace', 'Error'\n          throw $errorMessage\n        }\n      }\n```\n</attachment>\n<attachment>\nUser's active file for additional context:\n```powershell\n# filepath: c:\\Dropbox\\whertzing\\GitHub\\ATAP.Utilities\\src\\ATAP.Utilities.IAC.Ansible.Powershell\\public\\Remove-ProGetApiKeys.ps1\nfunction Remove-ProGetApiKeys {\n  [CmdletBinding(SupportsShouldProcess = $true)]\n  param (\n    $proGetBaseScheme,\n    $proGetBaseHost,\n    $proGetBasePort,\n    [int[]] $iD\n  )\n  Begin {\n    Write-PSFMessage -Level Verbose -Message 'Entering function: Remove-ProGetApiKeys' -Tag 'Remove-ProGetApiKeys', 'Trace'\n    # if called with the globla preference variable 'ErrorActionPreference\" set to 'SilentlyContinue', the\n    # code will keep trying to delete all Ids, otherwise it will stop on the first error\n\n    # if not passed, get from the environment variable. If Not an environment variable fall back to the $global: value\n    if (-not $proGetBaseScheme) {\n      $proGetBaseScheme = [Environment]::GetEnvironmentVariable($global:configRootKeys['ProGetAdminUriSchemeConfigRootKey'], 'Process')\n if (-not $proGetBaseScheme) {\n        $progetBaseScheme = $global:Settings[$global:configRootKeys['ProGetAdminUriSchemeConfigRootKey']]\n if (-not $proGetBaseScheme) {\n          $errorMessage = 'ProGetBaseScheme is not available.'\n          Write-PSFMessage -Level Error -Message $errorMessage -Tag 'Remove-ProGetApiKeys', 'Trace', 'Error'\n          throw $errorMessage\n        }\n      }\n    }\n    if (-not $proGetBaseHost) {\n      $proGetBaseHost = [Environment]::GetEnvironmentVariable($global:configRootKeys['ProGetAdminUriHostConfigRootKey'], 'Process')\n if (-not $proGetBaseHost) {\n        $progetBaseHost = $global:Settings[$global:configRootKeys['ProGetAdminUriHostConfigRootKey']]\n if (-not $proGetBaseHost) {\n          $errorMessage = 'ProGetBaseHost is not available.'\n          Write-PSFMessage -Level Error -Message $errorMessage -Tag 'Remove-ProGetApiKeys', 'Trace', 'Error'\n          throw $errorMessage\n        }\n      }\n    }\n    if (-not $proGetBasePort) {\n      $proGetBasePort = [Environment]::GetEnvironmentVariable($global:configRootKeys['ProGetAdminUriPortConfigRootKey'], 'Process')\n if (-not $proGetBasePort) {\n        $progetBasePort = $global:Settings[$global:configRootKeys['ProGetAdminUriPortConfigRootKey']]\n if (-not $proGetBasePort) {\n          $errorMessage = 'ProGetBasePort is not available.'\n          Write-PSFMessage -Level Error -Message $errorMessage -Tag 'Remove-ProGetApiKeys', 'Trace', 'Error'\n          throw $errorMessage\n        }\n      }\n    }\n    # $adminApiKey is used to authenticate an admin role to ProGet\n    # ToDo: Fetch from Secrets vault instead of environment variable\n    # ToDo: consider allowing this function to setup feeds on multiple proget hosts, would need a $adminApiKey in the settings for each\n    $adminApiKey = [Environment]::GetEnvironmentVariable($global:configRootKeys['ProGetAdminApiKeyConfigRootKey'], 'Process')\n if (-not $adminApiKey) {\n      $errorMessage = 'ProGet adminAPI key is not available in environment variable.'\n      Write-PSFMessage -Level Error -Message $errorMessage -Tag 'Remove-ProGetApiKeys', 'Trace', 'Error'\n      throw $errorMessage\n    }\n    # The Page for the command to list all API keys in ProGet\n    # ToDo: Move the page for the command to list all ApiKeys into configroot and settings\n    $progetListApisPage = 'api/api-keys/delete'\n    $proGetAPIpage = $progetListApisPage\n    # Each call to proget can only delete one API key at a time, and the api expects the ID in a query_string,\n    #  so the APIEndPoint will be constructed with the ID inside the Process block\n\n    $response = $null\n    $DeletedIds = @{}\n    $results = $null\n  }\n\n  Process {\n    # Create the headers\n    $headers = @{ 'X-ApiKey' = $adminApiKey }\n    # Loop over the APIKeys specified in the input\n    foreach ($apiKeyId in $Id) {\n      # Construct the API endpoint URL to delete the API key\n      $apiEndPointBuilder = [UriBuilder]::new($proGetBaseScheme, $proGetBaseHost, $proGetBasePort, $proGetAPIpage)\n      $apiEndPointBuilder.Query = \"id=$apiKeyId\"\n $apiEndPoint = $apiEndPointBuilder.URI\n\n      # === Make the API Call ===\n      try {\n        Write-PSFMessage -Level Verbose -Message \"Attempting to delete Api key with ID: $apiKeyId\" -Tag 'Remove-ProGetApiKeys', 'Trace'\n        $response = Invoke-RestMethod -Uri $apiEndPoint.AbsoluteUri -Headers $headers -Method Delete\n        $DeletedIds[$apiKeyId] = $true\n\n        Write-PSFMessage -Level Verbose -Message \"Successfully deleted Api key with ID: $apiKeyId\" -Tag 'Remove-ProGetApiKeys', 'Trace'\n      }\n      catch {\n        if ($ErrorActionPreference -eq 'SilentlyContinue') {\n $DeletedIds[$apiKeyId] = $false\n          Write-PSFMessage -Level Verbose -Message \"Failed to delete apiKeyId $apiKeyId. Exception: $($_.Exception.Message)\" -Tag 'Remove-ProGetApiKeys', 'Trace', 'Error'\n continue\n }\n $errorMessage = \"Failed to delete apiKeyId $apiKeyId. Exception: $($_.Exception.Message)\"\n Write-PSFMessage -Level Error -Message $errorMessage -Tag 'Remove-ProGetApiKeys', 'Trace', 'Error'\n        # ToDO: exception handling should wrap then throw, not just throw with only the error message\n        throw $errorMessage\n\n\n        $errorMessage = \"Failed to delete Api key with ID: $apiKeyId. Exception: $($_.Exception.Message)\"\n Write-PSFMessage -Level Error -Message $errorMessage -Exception $_.Exception -Tag 'Remove-ProGetApiKeys', 'Trace', 'Error'\n\n }\n }\n }\n\n End {\n Write-PSFMessage -Level Verbose -Message 'Exiting function: Remove-ProGetApiKeys' -Tag 'Remove-ProGetApiKeys', 'Trace'\n return $DeletedIds\n  }\n}\n```\n</attachment>\n\n</attachments>\n<reminder>\nWhen using the insert_edit_into_file tool, avoid repeating existing code, instead use a line comment with \\`...existing code...\\` to represent regions of unchanged code.\nWhen suggesting to create new files, pick a location inside `c:\\Dropbox\\whertzing\\GitHub\\ATAP.Utilities\\src\\ATAP.Utilities.IAC.Ansible.Powershell`.\n</reminder>\n<prompt>\nchange the parameters so that only iD is required, and make it required, and make it accept a single integer, an array of integers, or pipeline input\n</prompt>\n"
