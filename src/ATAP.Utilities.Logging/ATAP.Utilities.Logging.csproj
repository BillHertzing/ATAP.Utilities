<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Library</OutputType>
    <!-- Set the  NuGet Package control for this assembly -->
    <IsPackable>true</IsPackable>
    <ATAPEnableFody>true</ATAPEnableFody>
    <ATAPFodyRuntimeDependency>true</ATAPFodyRuntimeDependency>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging" />
    <!-- The woven assembly references the aspect base type at runtime. -->
    <PackageReference Include="MethodBoundaryAspect.Fody" />
    <ProjectReference Include="..\ATAP.Utilities.ETW\ATAP.Utilities.ETW.csproj" />
  </ItemGroup>


</Project>
