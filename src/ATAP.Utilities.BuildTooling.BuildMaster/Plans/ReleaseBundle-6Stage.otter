##########################################################################
# ReleaseBundle-6Stage - BuildMaster OtterScript Plan
#
# Purpose: Build a Release Bundle once, promote that same Universal Package
#          through the immutable releasebundle-* ProGet feeds, then publish
#          the Production bundle to Chocolatey and WinGet.
#
# Variables (Application Variables - set in BuildMaster Application config):
#   $ApplicationName                       - e.g. "AceCommander-ReleaseBundle"
#   $ProductName                           - e.g. "AceCommander"
#   $ReleaseTag                            - e.g. "v1.4.0" for release cuts
#   $Branch                                - branch fallback when ReleaseTag is empty
#   $SourcePath                            - absolute path to the product worktree
#   $ProGetUrl                             - e.g. "http://localhost:50000"
#   $ProGetApiKey                          - masked BuildMaster variable
#   $ReleaseBundleExperimentalFeedName     - from the application's variable set
#   $ReleaseBundleDevelopmentFeedName      - from the application's variable set
#   $ReleaseBundleIntegrationFeedName      - from the application's variable set
#   $ReleaseBundleQAFeedName               - from the application's variable set
#   $ReleaseBundleProductionFeedName       - from the application's variable set
#   $PreviousProductionBackupPath          - .bak used by Invoke-FlywayRehearsal
#   $RehearsalDatabaseName                 - ephemeral DB name for Integration rehearsal
#   $RehearsalDatabaseHost                 - SQL host for Integration rehearsal (default localhost)
#   $RehearsalSqlInstance                  - SQL named instance for Integration rehearsal (default EXPWHERTZING)
#
# This plan intentionally keeps OtterScript as dumb glue. Release logic lives
# in ATAP.Utilities.BuildTooling.PowerShell cmdlets documented by
# SolutionDocumentation/Release-Bundle-Pipeline.md sections 5 and 6.
##########################################################################

# BuildMaster stages:
#   Experimental -> Development -> Integration -> QA -> Production -> Distribution
#
# Build once in Experimental. Every later stage promotes the same bundle
# identity captured in _generated\buildmaster\releasebundle_*.tmp.

stage Experimental
{
    # Build bundle from release-branch tag, create manifest, pack .upack, and
    # push to the Experimental Universal feed.
    Exec
    (
        FileName: pwsh,
        Arguments: >>-NoProfile -Command "$$ErrorActionPreference = 'Stop'; Import-Module '$SourcePath\src\ATAP.Utilities.BuildTooling.PowerShell\ATAP.Utilities.BuildTooling.PowerShell.psd1' -Force; New-Item -ItemType Directory -Path '_generated\buildmaster' -Force | Out-Null; $$env:PROGET_ADMIN_API_KEY = '$Decrypt($ProGetApiKey)'; $$env:PROGET_BUILDMASTER_API_KEY = '$Decrypt($ProGetApiKey)'; $$global:ProGetBaseUrl = '$ProGetUrl'; if ([string]::IsNullOrWhiteSpace('$ReleaseTag')) { $$ctx = Get-BuildContext -Application '$ProductName' -Branch '$Branch' } else { $$ctx = Get-BuildContext -Application '$ProductName' -ReleaseTag '$ReleaseTag' }; $$ctx | ConvertTo-Json -Depth 20 | Set-Content -LiteralPath '_generated\buildmaster\releasebundle_context.json' -Encoding UTF8; $$manifest = New-ReleaseManifest -Context $$ctx -OutputPath '_generated\release-manifest\manifest.json'; $$bundle = New-ReleaseBundle -Manifest $$manifest -OutputPath '_generated\release-bundle' -SourceRoot '$SourcePath'; Publish-UniversalPackageToProGet -Path $$bundle.Path.FullName -Feed '$ReleaseBundleExperimentalFeedName'; $$ctx.Application | Out-File '_generated\buildmaster\releasebundle_name.tmp' -Encoding utf8 -NoNewline; $$ctx.ResolvedPackageVersion | Out-File '_generated\buildmaster\releasebundle_resolved_version.tmp' -Encoding utf8 -NoNewline; $$bundle.BundleVersion | Out-File '_generated\buildmaster\releasebundle_bundle_version.tmp' -Encoding utf8 -NoNewline; $$bundle.Path.FullName | Out-File '_generated\buildmaster\releasebundle_path.tmp' -Encoding utf8 -NoNewline; $$manifest.FullName | Out-File '_generated\buildmaster\releasebundle_manifest_path.tmp' -Encoding utf8 -NoNewline">>,
        WorkingDirectory: $SourcePath,
        SuccessExitCode: 0
    );

    Create-Artifact ReleaseManifest
    (
        From: _generated\release-manifest,
        Include: @(manifest.json)
    );

    Create-Artifact ReleaseBundle
    (
        From: _generated\release-bundle,
        Include: @(*.upack)
    );
}

stage Development
{
    # Promote the immutable bundle to Development.
    Exec
    (
        FileName: pwsh,
        Arguments: >>-NoProfile -Command "$$ErrorActionPreference = 'Stop'; Import-Module '$SourcePath\src\ATAP.Utilities.BuildTooling.PowerShell\ATAP.Utilities.BuildTooling.PowerShell.psd1' -Force; $$env:PROGET_BUILDMASTER_API_KEY = '$Decrypt($ProGetApiKey)'; $$global:ProGetBaseUrl = '$ProGetUrl'; $$name = Get-Content -LiteralPath '_generated\buildmaster\releasebundle_name.tmp' -Raw; $$version = Get-Content -LiteralPath '_generated\buildmaster\releasebundle_bundle_version.tmp' -Raw; Promote-ProGetPackage -Name $$name.Trim() -Version $$version.Trim() -FromFeed '$ReleaseBundleExperimentalFeedName' -ToFeed '$ReleaseBundleDevelopmentFeedName' -Reason 'Release Bundle Development promotion'">>,
        WorkingDirectory: $SourcePath,
        SuccessExitCode: 0
    );

    # Placeholder: Release-Bundle-Pipeline.md section 5 documents clean-VM
    # install/uninstall validation here, but section 6 does not yet name a
    # cmdlet for it. Add that Exec when the future validation stream lands.
}

stage Integration
{
    # Promote the immutable bundle to Integration.
    Exec
    (
        FileName: pwsh,
        Arguments: >>-NoProfile -Command "$$ErrorActionPreference = 'Stop'; Import-Module '$SourcePath\src\ATAP.Utilities.BuildTooling.PowerShell\ATAP.Utilities.BuildTooling.PowerShell.psd1' -Force; $$env:PROGET_BUILDMASTER_API_KEY = '$Decrypt($ProGetApiKey)'; $$global:ProGetBaseUrl = '$ProGetUrl'; $$name = Get-Content -LiteralPath '_generated\buildmaster\releasebundle_name.tmp' -Raw; $$version = Get-Content -LiteralPath '_generated\buildmaster\releasebundle_bundle_version.tmp' -Raw; Promote-ProGetPackage -Name $$name.Trim() -Version $$version.Trim() -FromFeed '$ReleaseBundleDevelopmentFeedName' -ToFeed '$ReleaseBundleIntegrationFeedName' -Reason 'Release Bundle Integration promotion'">>,
        WorkingDirectory: $SourcePath,
        SuccessExitCode: 0
    );

    # Rehearse bundled Flyway migrations against the previous-production DB snapshot.
    Exec
    (
        FileName: pwsh,
        Arguments: >>-NoProfile -Command "$$ErrorActionPreference = 'Stop'; Import-Module '$SourcePath\src\ATAP.Utilities.BuildTooling.PowerShell\ATAP.Utilities.BuildTooling.PowerShell.psd1' -Force; Import-Module '$SourcePath\src\ATAP.Utilities.DatabaseManagement.Powershell\ATAP.Utilities.DatabaseManagement.Powershell.psd1' -Force; New-Item -ItemType Directory -Path '_generated\flyway' -Force | Out-Null; $$bundlePath = Get-Content -LiteralPath '_generated\buildmaster\releasebundle_path.tmp' -Raw; $$databaseHost = if ([string]::IsNullOrWhiteSpace('$RehearsalDatabaseHost')) { 'localhost' } else { '$RehearsalDatabaseHost' }; $$sqlInstance = if ([string]::IsNullOrWhiteSpace('$RehearsalSqlInstance')) { 'EXPWHERTZING' } else { '$RehearsalSqlInstance' }; Invoke-FlywayRehearsal -BundlePath $$bundlePath.Trim() -BackupPath '$PreviousProductionBackupPath' -RehearsalDb '$RehearsalDatabaseName' -DatabaseHost $$databaseHost -SqlInstance $$sqlInstance -LogPath '_generated\flyway\flyway-rehearsal.log'">>,
        WorkingDirectory: $SourcePath,
        SuccessExitCode: 0
    );

    Create-Artifact FlywayRehearsal
    (
        From: _generated\flyway,
        Include: @(flyway-rehearsal.log)
    );
}

stage QA
{
    # Promote the immutable bundle to QA.
    Exec
    (
        FileName: pwsh,
        Arguments: >>-NoProfile -Command "$$ErrorActionPreference = 'Stop'; Import-Module '$SourcePath\src\ATAP.Utilities.BuildTooling.PowerShell\ATAP.Utilities.BuildTooling.PowerShell.psd1' -Force; $$env:PROGET_BUILDMASTER_API_KEY = '$Decrypt($ProGetApiKey)'; $$global:ProGetBaseUrl = '$ProGetUrl'; $$name = Get-Content -LiteralPath '_generated\buildmaster\releasebundle_name.tmp' -Raw; $$version = Get-Content -LiteralPath '_generated\buildmaster\releasebundle_bundle_version.tmp' -Raw; Promote-ProGetPackage -Name $$name.Trim() -Version $$version.Trim() -FromFeed '$ReleaseBundleIntegrationFeedName' -ToFeed '$ReleaseBundleQAFeedName' -Reason 'Release Bundle QA promotion'">>,
        WorkingDirectory: $SourcePath,
        SuccessExitCode: 0
    );

    # Placeholder: Release-Bundle-Pipeline.md section 5 documents the full
    # E2E suite here. Section 6 has no named release-bundle QA test cmdlet yet.
}

stage Production
{
    # Promote the immutable bundle to Production.
    Exec
    (
        FileName: pwsh,
        Arguments: >>-NoProfile -Command "$$ErrorActionPreference = 'Stop'; Import-Module '$SourcePath\src\ATAP.Utilities.BuildTooling.PowerShell\ATAP.Utilities.BuildTooling.PowerShell.psd1' -Force; $$env:PROGET_BUILDMASTER_API_KEY = '$Decrypt($ProGetApiKey)'; $$global:ProGetBaseUrl = '$ProGetUrl'; $$name = Get-Content -LiteralPath '_generated\buildmaster\releasebundle_name.tmp' -Raw; $$version = Get-Content -LiteralPath '_generated\buildmaster\releasebundle_bundle_version.tmp' -Raw; Promote-ProGetPackage -Name $$name.Trim() -Version $$version.Trim() -FromFeed '$ReleaseBundleQAFeedName' -ToFeed '$ReleaseBundleProductionFeedName' -Reason 'Release Bundle Production promotion'">>,
        WorkingDirectory: $SourcePath,
        SuccessExitCode: 0
    );

    # Placeholder: Production validation is the release-manager manual approval
    # gate documented in Release-Bundle-Pipeline.md section 5. Add an
    # Approve-BuildMasterStage Exec when that spec cmdlet is implemented.
}

stage Distribution
{
    # Publish the production-tier bundle to Chocolatey and update WinGet.
    # Both cmdlets are documented in Release-Bundle-Pipeline.md section 6 and
    # may remain future stubs until Stream N implements their full behavior.
    Exec
    (
        FileName: pwsh,
        Arguments: >>-NoProfile -Command "$$ErrorActionPreference = 'Stop'; Import-Module '$SourcePath\src\ATAP.Utilities.BuildTooling.PowerShell\ATAP.Utilities.BuildTooling.PowerShell.psd1' -Force; $$version = Get-Content -LiteralPath '_generated\buildmaster\releasebundle_bundle_version.tmp' -Raw; Publish-ChocolateyRelease -BundleVersion $$version.Trim(); Update-WinGetManifestSource -BundleVersion $$version.Trim()">>,
        WorkingDirectory: $SourcePath,
        SuccessExitCode: 0
    );
}
