      "variableData": {
        "variables": [
          {
            "id": "vscode.prompt.instructions.root__file:///c%3A/Dropbox/whertzing/GitHub/ATAP.Utilities/.github/copilot-instructions.md",
            "name": "prompt:copilot-instructions.md",
