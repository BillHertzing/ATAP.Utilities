# Flyway local environment configuration for Gmail database
# Database: Gmail on utat022 using Windows Authentication

# Experimental environment (default)
FLYWAY_EXP_URL=jdbc:sqlserver://localhost;databaseName=Gmail;integratedSecurity=true;encrypt=false;trustServerCertificate=true
FLYWAY_EXP_USER=
FLYWAY_EXP_PASSWORD=

# Development environment
FLYWAY_DEV_URL=jdbc:sqlserver://utat022;databaseName=Gmail;integratedSecurity=true;encrypt=false;trustServerCertificate=true
FLYWAY_DEV_USER=
FLYWAY_DEV_PASSWORD=

# Testing environment
FLYWAY_TEST_URL=jdbc:sqlserver://utat022;databaseName=Gmail;integratedSecurity=true;encrypt=false;trustServerCertificate=true
FLYWAY_TEST_USER=
FLYWAY_TEST_PASSWORD=

# Production environment
FLYWAY_PROD_URL=jdbc:sqlserver://utat022;databaseName=Gmail;integratedSecurity=true;encrypt=false;trustServerCertificate=true
FLYWAY_PROD_USER=
FLYWAY_PROD_PASSWORD=

# Shared SQL migration locations
FLYWAY_SHARED_SQL_PATH=C:/Dropbox/whertzing/GitHub/SharedVSCode/Databases/SQL

