    <diagram id="page-07-consume" name="07 — Consumers Consume / Install">
        <mxGraphModel dx="1291" dy="633" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="1100" math="0" shadow="0">
            <root>
                <mxCell id="0"/>
                <mxCell id="1" parent="0"/>
                <mxCell id="title-07" value="How Consumers Consume Packages or Install Modules" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=18;fontStyle=1;" parent="1" vertex="1">
                    <mxGeometry x="40" y="20" width="1620" height="40" as="geometry"/>
                </mxCell>
                <mxCell id="subtitle-07" value="Three consumer categories: dev consumers of NuGet libraries, dev consumers of PowerShell modules, end users installing the Release Bundle." style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=12;fontStyle=2;" parent="1" vertex="1">
                    <mxGeometry x="40" y="60" width="1620" height="24" as="geometry"/>
                </mxCell>
                <mxCell id="lane-csharp" value="Dev consumer — C# library (e.g. AceCommander or downstream solution)" style="swimlane;startSize=30;fillColor=#fff2cc;strokeColor=#d6b656;fontStyle=1;" parent="1" vertex="1">
                    <mxGeometry x="40" y="100" width="1620" height="240" as="geometry"/>
                </mxCell>
                <mxCell id="csharp-dev-actor" value="Developer&#xa;workstation" style="shape=mxgraph.cisco_safe.architecture.identity_service;html=1;pointerEvents=1;dashed=0;fillColor=#ffe6cc;strokeColor=#d79b00;" parent="lane-csharp" vertex="1">
                    <mxGeometry x="40" y="80" width="120" height="100" as="geometry"/>
                </mxCell>
                <mxCell id="csharp-csproj" value="MyApp.csproj&#xa;&lt;PackageReference Include=&quot;ATAP.Utilities.Philote&quot; /&gt;&#xa;(version pinned by Directory.Packages.props)" style="shape=document;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;align=left;verticalAlign=top;" parent="lane-csharp" vertex="1">
                    <mxGeometry x="220" y="80" width="380" height="100" as="geometry"/>
                </mxCell>
                <mxCell id="csharp-nugetcfg" value="NuGet.config&#xa;packageSourceMapping pins ATAP.* to the appropriate ProGet feed for the branch" style="shape=document;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;align=left;verticalAlign=top;" parent="lane-csharp" vertex="1">
                    <mxGeometry x="640" y="80" width="380" height="100" as="geometry"/>
                </mxCell>
                <mxCell id="csharp-feed" value="ProGet&#xa;nuget-experimental / -development / -integration / -qa / -stable" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontStyle=1;" parent="lane-csharp" vertex="1">
                    <mxGeometry x="1060" y="80" width="380" height="100" as="geometry"/>
                </mxCell>
                <mxCell id="csharp-restore" value="dotnet restore" style="endArrow=classic;html=1;rounded=0;strokeColor=#9673a6;strokeWidth=2;" parent="lane-csharp" source="csharp-csproj" target="csharp-feed" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="lane-ps" value="Dev consumer — PowerShell module" style="swimlane;startSize=30;fillColor=#e1d5e7;strokeColor=#9673a6;fontStyle=1;" parent="1" vertex="1">
                    <mxGeometry x="40" y="360" width="1620" height="240" as="geometry"/>
                </mxCell>
                <mxCell id="ps-dev-actor" value="PowerShell user&#xa;or build script" style="shape=mxgraph.cisco_safe.architecture.identity_service;html=1;pointerEvents=1;dashed=0;fillColor=#e1d5e7;strokeColor=#9673a6;" parent="lane-ps" vertex="1">
                    <mxGeometry x="40" y="80" width="120" height="100" as="geometry"/>
                </mxCell>
                <mxCell id="ps-register" value="Register-PSResourceRepository&#xa;(name = PowershellGet-development)&#xa;(URI from $global:settings or PROGET_POWERSHELLGET_FEED_URI_DEV env var)" style="shape=document;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;align=left;verticalAlign=top;" parent="lane-ps" vertex="1">
                    <mxGeometry x="220" y="80" width="380" height="100" as="geometry"/>
                </mxCell>
                <mxCell id="ps-install" value="Install-PSResource ATAP.Utilities.FileIO.PowerShell&#xa;-Repository PowershellGet-development&#xa;-Prerelease" style="shape=document;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;align=left;verticalAlign=top;" parent="lane-ps" vertex="1">
                    <mxGeometry x="640" y="80" width="380" height="100" as="geometry"/>
                </mxCell>
                <mxCell id="ps-feed" value="ProGet&#xa;PowershellGet-experimental / -development / -integration / -qa / -stable" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontStyle=1;" parent="lane-ps" vertex="1">
                    <mxGeometry x="1060" y="80" width="380" height="100" as="geometry"/>
                </mxCell>
                <mxCell id="ps-pull" value="Install-PSResource (HTTPS GET .nupkg)" style="endArrow=classic;html=1;rounded=0;strokeColor=#9673a6;strokeWidth=2;" parent="lane-ps" source="ps-install" target="ps-feed" edge="1">
                    <mxGeometry y="30" relative="1" as="geometry">
                        <mxPoint as="offset"/>
                    </mxGeometry>
                </mxCell>
                <mxCell id="lane-end" value="End user — Release Bundle (Chocolatey or WinGet)" style="swimlane;startSize=30;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;" parent="1" vertex="1">
                    <mxGeometry x="40" y="620" width="1620" height="380" as="geometry"/>
                </mxCell>
                <mxCell id="end-actor" value="End user&#xa;Windows workstation" style="shape=mxgraph.cisco_safe.architecture.identity_service;html=1;pointerEvents=1;dashed=0;fillColor=#d5e8d4;strokeColor=#82b366;" parent="lane-end" vertex="1">
                    <mxGeometry x="40" y="80" width="160" height="100" as="geometry"/>
                </mxCell>
                <mxCell id="end-cmd-choco" value="choco install acecommander" style="shape=document;whiteSpace=wrap;html=1;fillColor=#cce5ff;strokeColor=#3366cc;" parent="lane-end" vertex="1">
                    <mxGeometry x="240" y="60" width="320" height="50" as="geometry"/>
                </mxCell>
                <mxCell id="end-cmd-winget" value="winget install ATAP.AceCommander" style="shape=document;whiteSpace=wrap;html=1;fillColor=#cce5ff;strokeColor=#3366cc;" parent="lane-end" vertex="1">
                    <mxGeometry x="240" y="140" width="320" height="50" as="geometry"/>
                </mxCell>
                <mxCell id="end-choco-channel" value="Chocolatey community feed&#xa;(thin .nupkg with chocolateyInstall.ps1)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#cce5ff;strokeColor=#3366cc;" parent="lane-end" vertex="1">
                    <mxGeometry x="600" y="60" width="320" height="80" as="geometry"/>
                </mxCell>
                <mxCell id="end-winget-channel" value="WinGet manifest&#xa;(microsoft/winget-pkgs or private REST source)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#cce5ff;strokeColor=#3366cc;" parent="lane-end" vertex="1">
                    <mxGeometry x="600" y="160" width="320" height="80" as="geometry"/>
                </mxCell>
                <mxCell id="end-bundle-source" value="ProGet ReleaseBundle-Production&#xa;(authoritative source of the .upack)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#82b366;fontColor=#ffffff;strokeColor=#006600;fontStyle=1;" parent="lane-end" vertex="1">
                    <mxGeometry x="980" y="100" width="320" height="100" as="geometry"/>
                </mxCell>
                <mxCell id="end-installer" value="installer/Install-Application.ps1&#xa;1. verify checksums in manifest.json&#xa;2. detect DB state, decide action&#xa;3. apply Flyway migrations + run seed loaders&#xa;4. deploy app/ files to install location&#xa;5. write %ProgramData%\&lt;App&gt;\manifest.json (audit copy)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;verticalAlign=top;" parent="lane-end" vertex="1">
                    <mxGeometry x="240" y="220" width="680" height="140" as="geometry"/>
                </mxCell>
                <mxCell id="end-installed" value="Installed app + DB&#xa;%ProgramFiles%\AceCommander\&#xa;Configured DB at target Flyway version" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#82b366;fontColor=#ffffff;strokeColor=#006600;fontStyle=1;" parent="lane-end" vertex="1">
                    <mxGeometry x="980" y="220" width="320" height="140" as="geometry"/>
                </mxCell>
                <mxCell id="end-choco-edge" value="" style="endArrow=classic;html=1;rounded=0;strokeColor=#3366cc;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" parent="lane-end" source="end-cmd-choco" target="end-choco-channel" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="end-winget-edge" value="" style="endArrow=classic;html=1;rounded=0;strokeColor=#3366cc;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" parent="lane-end" source="end-cmd-winget" target="end-winget-channel" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="end-choco-pull" value="downloads .upack" style="endArrow=classic;html=1;rounded=0;strokeColor=#82b366;exitX=1;exitY=0.5;entryX=0;entryY=0.3;" parent="lane-end" source="end-choco-channel" target="end-bundle-source" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="end-winget-pull" value="downloads .upack" style="endArrow=classic;html=1;rounded=0;strokeColor=#82b366;exitX=1;exitY=0.5;entryX=0;entryY=0.7;" parent="lane-end" source="end-winget-channel" target="end-bundle-source" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="end-bundle-runs-installer" value="extract → run installer/" style="endArrow=classic;html=1;rounded=0;strokeColor=#82b366;strokeWidth=2;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" parent="lane-end" source="end-bundle-source" target="end-installer" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="end-installer-result" value="" style="endArrow=classic;html=1;rounded=0;strokeColor=#82b366;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" parent="lane-end" source="end-installer" target="end-installed" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="srcdocs-07" value="Source documentation:&#xa;• CSharp-Central-Package-Management.md (§5 floating versions 0.*-*, §6 producer/consumer contract, §7 packageSourceMapping)&#xa;• CSharp-Packages-Pack-and-Push.md (§7 feed topology, §8 NuGet.config)&#xa;• PowerShell-Modules-Pack-and-Publish.md (§5 feed URI resolution, §7 Register-PSResourceRepository, §8 publish / install)&#xa;• Release-Bundle-Pipeline.md (§4 bundle layout, §8 Chocolatey / WinGet distribution)&#xa;• Release-Branch-and-Manifest.md (§5 verification at install time, §6 auditing a deployed environment)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;align=left;verticalAlign=top;fontSize=10;fontStyle=2;" parent="1" vertex="1">
                    <mxGeometry x="40" y="1040" width="1620" height="55" as="geometry"/>
                </mxCell>
            </root>
        </mxGraphModel>
    </diagram>
    <diagram id="page-08-updates" name="08 — Consumer Update Ingestion">
        <mxGraphModel dx="1291" dy="633" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="1100" math="0" shadow="0">
            <root>
                <mxCell id="0"/>
                <mxCell id="1" parent="0"/>
                <mxCell id="title-08" value="How Consumers Ingest Updates — Code (C# / PowerShell) and DB (Schema / Data, SQL)" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=18;fontStyle=1;" parent="1" vertex="1">
                    <mxGeometry x="40" y="20" width="1620" height="40" as="geometry"/>
                </mxCell>
                <mxCell id="subtitle-08" value="Each release is a complete bundle. Code updates and DB updates ride together; the installer detects what to apply." style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=12;fontStyle=2;" parent="1" vertex="1">
                    <mxGeometry x="40" y="60" width="1620" height="24" as="geometry"/>
                </mxCell>
                <mxCell id="upd-csharp" value="Update path — C# library consumers (downstream solutions)" style="swimlane;startSize=30;fillColor=#fff2cc;strokeColor=#d6b656;fontStyle=1;" parent="1" vertex="1">
                    <mxGeometry x="40" y="100" width="800" height="280" as="geometry"/>
                </mxCell>
                <mxCell id="upd-csharp-trigger" value="ProGet feed has a higher version&#xa;(via promotion to nuget-stable, or new prerelease in lower feed)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" parent="upd-csharp" vertex="1">
                    <mxGeometry x="20" y="50" width="360" height="80" as="geometry"/>
                </mxCell>
                <mxCell id="upd-csharp-action" value="Developer bumps version in&#xa;Directory.Packages.props (pinned)&#xa;or restore picks up floating 0.*-* automatically" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" parent="upd-csharp" vertex="1">
                    <mxGeometry x="420" y="50" width="360" height="80" as="geometry"/>
                </mxCell>
                <mxCell id="upd-csharp-build" value="dotnet restore + dotnet build of the consuming solution&#xa;new transitive deps land via packages.lock.json" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" parent="upd-csharp" vertex="1">
                    <mxGeometry x="20" y="160" width="760" height="80" as="geometry"/>
                </mxCell>
                <mxCell id="upd-csharp-flow1" value="" style="endArrow=classic;html=1;rounded=0;strokeColor=#d79b00;" parent="upd-csharp" source="upd-csharp-trigger" target="upd-csharp-action" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="upd-csharp-flow2" value="" style="endArrow=classic;html=1;rounded=0;strokeColor=#d79b00;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" parent="upd-csharp" source="upd-csharp-action" target="upd-csharp-build" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="upd-ps" value="Update path — PowerShell module consumers" style="swimlane;startSize=30;fillColor=#e1d5e7;strokeColor=#9673a6;fontStyle=1;" parent="1" vertex="1">
                    <mxGeometry x="860" y="100" width="800" height="280" as="geometry"/>
                </mxCell>
                <mxCell id="upd-ps-trigger" value="ProGet PowerShellGet feed has a higher version" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" parent="upd-ps" vertex="1">
                    <mxGeometry x="20" y="50" width="360" height="80" as="geometry"/>
                </mxCell>
                <mxCell id="upd-ps-action" value="Update-PSResource &lt;ModuleName&gt;&#xa;-Repository PowershellGet-stable&#xa;(or scheduled task wrapper for unattended runs)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" parent="upd-ps" vertex="1">
                    <mxGeometry x="420" y="50" width="360" height="80" as="geometry"/>
                </mxCell>
                <mxCell id="upd-ps-import" value="On next Import-Module / new shell:&#xa;PSResourceGet picks the highest installed version automatically" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" parent="upd-ps" vertex="1">
                    <mxGeometry x="20" y="160" width="760" height="80" as="geometry"/>
                </mxCell>
                <mxCell id="upd-ps-flow1" value="" style="endArrow=classic;html=1;rounded=0;strokeColor=#9673a6;" parent="upd-ps" source="upd-ps-trigger" target="upd-ps-action" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="upd-ps-flow2" value="" style="endArrow=classic;html=1;rounded=0;strokeColor=#9673a6;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" parent="upd-ps" source="upd-ps-action" target="upd-ps-import" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="upd-app" value="Update path — End-user application (Release Bundle: app + DB ride together)" style="swimlane;startSize=30;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;" parent="1" vertex="1">
                    <mxGeometry x="40" y="400" width="1620" height="600" as="geometry"/>
                </mxCell>
                <mxCell id="upd-app-trigger" value="New version available&#xa;(Chocolatey / WinGet update notification, or scheduled check)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#cce5ff;strokeColor=#3366cc;fontStyle=1;" parent="upd-app" vertex="1">
                    <mxGeometry x="40" y="60" width="380" height="80" as="geometry"/>
                </mxCell>
                <mxCell id="upd-app-cmd-choco" value="choco upgrade acecommander" style="shape=document;whiteSpace=wrap;html=1;fillColor=#cce5ff;strokeColor=#3366cc;" parent="upd-app" vertex="1">
                    <mxGeometry x="500" y="50" width="320" height="50" as="geometry"/>
                </mxCell>
                <mxCell id="upd-app-cmd-winget" value="winget upgrade ATAP.AceCommander" style="shape=document;whiteSpace=wrap;html=1;fillColor=#cce5ff;strokeColor=#3366cc;" parent="upd-app" vertex="1">
                    <mxGeometry x="500" y="120" width="320" height="50" as="geometry"/>
                </mxCell>
                <mxCell id="upd-app-bundle" value="ProGet ReleaseBundle-Production&#xa;Bundle vN+1: app + Flyway migrations + seed + manifest&#xa;(complete; no &quot;DB-less&quot; releases)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#82b366;fontColor=#ffffff;strokeColor=#006600;fontStyle=1;" parent="upd-app" vertex="1">
                    <mxGeometry x="900" y="60" width="680" height="100" as="geometry"/>
                </mxCell>
                <mxCell id="upd-app-flow-choco" value="" style="endArrow=classic;html=1;rounded=0;strokeColor=#3366cc;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" parent="upd-app" source="upd-app-cmd-choco" target="upd-app-bundle" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="upd-app-flow-winget" value="" style="endArrow=classic;html=1;rounded=0;strokeColor=#3366cc;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" parent="upd-app" source="upd-app-cmd-winget" target="upd-app-bundle" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="upd-installer-detect" value="installer/Update-Application.ps1&#xa;reads vN+1 manifest.json + db-manifest.json" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;" parent="upd-app" vertex="1">
                    <mxGeometry x="40" y="200" width="700" height="80" as="geometry"/>
                </mxCell>
                <mxCell id="upd-decision" value="Detect current state&#xa;Current Flyway version vs vN+1 target?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontStyle=1;" parent="upd-app" vertex="1">
                    <mxGeometry x="900" y="190" width="320" height="120" as="geometry"/>
                </mxCell>
                <mxCell id="upd-bundle-to-installer" value="extract" style="endArrow=classic;html=1;rounded=0;strokeColor=#82b366;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" parent="upd-app" source="upd-app-bundle" target="upd-installer-detect" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="upd-installer-to-decision" value="" style="endArrow=classic;html=1;rounded=0;strokeColor=#82b366;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" parent="upd-app" source="upd-installer-detect" target="upd-decision" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="case-codeonly" value="Case A — Code-only update&#xa;(DB Flyway version unchanged from vN)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontStyle=1;" parent="upd-app" vertex="1">
                    <mxGeometry x="40" y="350" width="500" height="60" as="geometry"/>
                </mxCell>
                <mxCell id="case-codeonly-action" value="• Replace app/ binaries&#xa;• Re-run repeatable Flyway scripts (R__*.sql) — usually no changes&#xa;• Restart service&#xa;• Update %ProgramData%\&lt;App&gt;\manifest.json audit copy" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;align=left;verticalAlign=top;" parent="upd-app" vertex="1">
                    <mxGeometry x="40" y="420" width="500" height="120" as="geometry"/>
                </mxCell>
                <mxCell id="case-schema" value="Case B — Schema and/or data update&#xa;(DB Flyway target version increased)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;" parent="upd-app" vertex="1">
                    <mxGeometry x="600" y="350" width="500" height="60" as="geometry"/>
                </mxCell>
                <mxCell id="case-schema-action" value="• Backup current DB (recommended)&#xa;• Apply new V*.sql migrations to bring Flyway to vN+1 target&#xa;• Run any new versioned seed loaders (S*_load.sql)&#xa;• Re-run repeatable loaders (R__seed_*.sql)&#xa;• Replace app/ binaries; restart service&#xa;• Update audit manifest" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;verticalAlign=top;" parent="upd-app" vertex="1">
                    <mxGeometry x="600" y="420" width="500" height="160" as="geometry"/>
                </mxCell>
                <mxCell id="case-noop" value="Case C — Already at target&#xa;(re-install of same version, or current &gt; target)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontStyle=1;" parent="upd-app" vertex="1">
                    <mxGeometry x="1160" y="350" width="420" height="60" as="geometry"/>
                </mxCell>
                <mxCell id="case-noop-action" value="• If current = target: re-run repeatable scripts only.&#xa;• If current &gt; target (downgrade): ABORT with clear error.&#xa;  Recovery path is backup-restore, not script reversal." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;align=left;verticalAlign=top;" parent="upd-app" vertex="1">
                    <mxGeometry x="1160" y="420" width="420" height="160" as="geometry"/>
                </mxCell>
                <mxCell id="upd-decision-to-A" value="A: same Flyway target" style="endArrow=classic;html=1;rounded=0;strokeColor=#d79b00;" parent="upd-app" source="upd-decision" target="case-codeonly" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="upd-decision-to-B" value="B: higher Flyway target" style="endArrow=classic;html=1;rounded=0;strokeColor=#6c8ebf;" parent="upd-app" source="upd-decision" target="case-schema" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="upd-decision-to-C" value="C: =target / abort if &gt;target" style="endArrow=classic;html=1;rounded=0;strokeColor=#666666;" parent="upd-app" source="upd-decision" target="case-noop" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="srcdocs-08" value="Source documentation:&#xa;• Database-Change-Unit-and-Flyway-Promotion.md (§4 code-only releases, §6 backward / forward compatibility, §9 install / upgrade behavior)&#xa;• Release-Branch-and-Manifest.md (§3 manifest schema, §5 verification, §8 patch releases)&#xa;• Release-Bundle-Pipeline.md (§9 code-only releases ship full bundle, §4 installer scripts)&#xa;• CSharp-Central-Package-Management.md (§6 producer/consumer contract, §6.1 pinning at T3+, §8 packages.lock.json)&#xa;• PowerShell-Modules-Pack-and-Publish.md (§12 promotion flow that consumers pull from)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;align=left;verticalAlign=top;fontSize=10;fontStyle=2;" parent="1" vertex="1">
                    <mxGeometry x="40" y="1040" width="1620" height="55" as="geometry"/>
                </mxCell>
            </root>
        </mxGraphModel>
    </diagram>
    <diagram id="page-09-identity" name="09 — Package Identity Verification (placeholder)">
        <mxGraphModel dx="1291" dy="633" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="1100" math="0" shadow="0">
            <root>
                <mxCell id="0"/>
                <mxCell id="1" parent="0"/>
                <mxCell id="title-09" value="Package Identity Verification — PLACEHOLDER (future section)" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=18;fontStyle=1;" parent="1" vertex="1">
                    <mxGeometry x="40" y="20" width="1620" height="40" as="geometry"/>
                </mxCell>
                <mxCell id="today-state-09" value="TODAY (2026-05-08)&#xa;No identity verification is implemented.&#xa;The SHA-256 in manifest.json is computed but is NOT verified by the installer or by Chocolatey/WinGet.&#xa;This page is a placeholder for the future design." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontStyle=1;fontSize=13;align=left;verticalAlign=top;" parent="1" vertex="1">
                    <mxGeometry x="100" y="70" width="1500" height="80" as="geometry"/>
                </mxCell>
                <mxCell id="placeholder-banner" value="TO BE DESIGNED — How users of consuming apps verify the identity of an initial install or update package" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontStyle=1;fontSize=16;" parent="1" vertex="1">
                    <mxGeometry x="100" y="190" width="1500" height="80" as="geometry"/>
                </mxCell>
                <mxCell id="placeholder-scope" value="Scope of this future section&#xa;&#xa;• How an end user verifies that the .upack downloaded from Chocolatey / WinGet really came from this organization&#xa;  (and was not substituted, mirrored, or tampered with along the way).&#xa;• How a downstream developer verifies that a .nupkg restored from a ProGet feed is the exact bytes signed by our build pipeline.&#xa;• How an operator on a customer site verifies a deployed install (the manifest.json in %ProgramData%\&lt;App&gt;\) corresponds to a real published release.&#xa;• How an auditor follows the chain from a deployed binary back to a release tag, a release branch commit, and a BuildMaster release record." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;align=left;verticalAlign=top;" parent="1" vertex="1">
                    <mxGeometry x="100" y="310" width="1500" height="200" as="geometry"/>
                </mxCell>
                <mxCell id="placeholder-candidates" value="Candidate mechanisms to evaluate (none chosen yet — see TASKS.md)&#xa;&#xa;• NuGet signed packages — `dotnet nuget sign` with an Authenticode code-signing cert; `dotnet nuget verify --all`.&#xa;• ProGet built-in package signing + signature-required feeds.&#xa;• SHA-256 sidecars (.sha256) shipped alongside .nupkg / .upack downloads, served from a separate trust origin.&#xa;• Sigstore / cosign-style transparency log for ATAP-published artifacts.&#xa;• Authenticode signature on the Release Bundle&#39;s installer scripts (.ps1) and on app binaries.&#xa;• Hardware-backed code-signing key (HSM / smart card) for production-tier signatures.&#xa;• Embedded release-manifest signature (manifest.json + manifest.json.sig) checked by the installer before any DB / file action.&#xa;• Public release page listing version → SHA-256 → release-tag, served over HTTPS from a separate domain (out-of-band trust anchor)." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;align=left;verticalAlign=top;" parent="1" vertex="1">
                    <mxGeometry x="100" y="540" width="1500" height="280" as="geometry"/>
                </mxCell>
                <mxCell id="placeholder-decisions" value="Open decisions to make&#xa;&#xa;1. Trust anchor: which key(s), held where, rotated how?&#xa;2. What does the install script REFUSE to do when verification fails (hard abort, warn-and-continue, opt-out flag)?&#xa;3. What is the user-visible verification command?  e.g.  `Verify-AceCommanderRelease -BundlePath …`&#xa;4. How does a long-living release branch handle key rotation across patch releases?&#xa;5. Where does the &quot;public truth&quot; live (status page, GitHub release notes, signed manifest list)?&#xa;6. How do we communicate the trust anchor to first-time installers without already-trusted infrastructure?" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;fontStyle=2;" parent="1" vertex="1">
                    <mxGeometry x="100" y="850" width="1500" height="240" as="geometry"/>
                </mxCell>
                <mxCell id="srcdocs-09" value="Source documentation: (none yet — this section is the placeholder)&#xa;Once authored, the source-of-truth document is expected to be:  Package-Identity-Verification.md  (TBD)&#xa;Related background:&#xa;• CSharp-Packages-Pack-and-Push.md (§4 SourceLink + symbol packages, §10 PackageProjectUrl gap, §12 Security)&#xa;• Release-Branch-and-Manifest.md (§3 manifest checksums, §5 verification at install time, §6 auditing)&#xa;• Immutable-Build-Strategy.md (§2 Why build-once — hash divergence avoidance enables signature stability)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;align=left;verticalAlign=top;fontSize=10;fontStyle=2;" parent="1" vertex="1">
                    <mxGeometry x="40" y="1040" width="1620" height="55" as="geometry"/>
                </mxCell>
            </root>
        </mxGraphModel>
    </diagram>
</mxfile>
