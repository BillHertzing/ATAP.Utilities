@startuml CoreSchema_Overview
' ATAPUtilities consolidated RPRRSBSI V3 initial schema.
' Source: Database/Flyway/SQL/V00010__Create_ATAPUtilities_Initial_Schema_And_Seed.sql

skinparam linetype ortho
skinparam roundcorner 5
skinparam defaultFontName Segoe UI
skinparam defaultFontSize 10
skinparam entity {
  BackgroundColor #F0F4FF
  BorderColor #3366CC
  FontColor #1A1A2E
}
skinparam arrow {
  Color #3366CC
  FontSize 8
}

entity "Philote" as Philote <<table>> {
  * PhiloteId : uniqueidentifier <<PK>>
  --
  AdditionalIdsStub : nvarchar(max) [NULL]
}

entity "PhiloteValidityPeriod" as Validity <<table>> {
  * PhiloteValidityPeriodId : uniqueidentifier <<PK>>
  --
  PhiloteId : uniqueidentifier <<FK>>
  PreviousValidToUtc : datetime2(7) [NULL, FK]
  ValidFromUtc : datetime2(7)
  ValidToUtc : datetime2(7) [NULL]
}

entity "RuleKind" as RuleKind <<table>> {
  * RuleKindId : uniqueidentifier <<PK>>
  --
  PhiloteId : uniqueidentifier <<FK>>
  RuleKindCode : varchar(64)
  RuleKindName : nvarchar(128)
}

entity "RulePrimitive" as Primitive <<table>> {
  * RulePrimitiveId : uniqueidentifier <<PK>>
  --
  PhiloteId : uniqueidentifier <<FK>>
  RuleKindId : uniqueidentifier <<FK>>
  RulePrimitiveCode : nvarchar(128)
}

entity "RulePrimitiveInput" as Input <<table>> {
  * RulePrimitiveInputId : uniqueidentifier <<PK>>
  --
  RulePrimitiveId : uniqueidentifier <<FK>>
  InputName : nvarchar(128)
  InputType : nvarchar(256)
  InputDescription : nvarchar(1024)
  DefaultValue : nvarchar(4000) [NULL]
  IsRequired : bit
  Ordinal : int
}

entity "Rule" as Rule <<table>> {
  * RuleId : uniqueidentifier <<PK>>
  --
  PhiloteId : uniqueidentifier <<FK>>
  RuleKindId : uniqueidentifier <<FK>>
  RulePrimitiveId : uniqueidentifier <<FK>>
  RuleCode : varchar(128)
  RuleBody : nvarchar(max)
}

entity "RuleSet" as RuleSet <<table>> {
  * RuleSetId : uniqueidentifier <<PK>>
  --
  PhiloteId : uniqueidentifier <<FK>>
  RuleSetCode : varchar(128)
}

entity "RuleSetRule" as RuleSetRule <<table>> {
  * RuleSetId : uniqueidentifier <<PK, FK>>
  * RuleId : uniqueidentifier <<PK, FK>>
  --
  Ordinal : int
}

entity "BuildSet" as BuildSet <<table>> {
  * BuildSetId : uniqueidentifier <<PK>>
  --
  PhiloteId : uniqueidentifier <<FK>>
  BuildSetCode : varchar(128)
}

entity "BuildSetRuleSet" as BuildSetRuleSet <<table>> {
  * BuildSetId : uniqueidentifier <<PK, FK>>
  * RuleSetId : uniqueidentifier <<PK, FK>>
  --
  Ordinal : int
}

entity "Instantiation" as Instantiation <<table>> {
  * InstantiationId : uniqueidentifier <<PK>>
  --
  PhiloteId : uniqueidentifier <<FK>>
  BuildSetId : uniqueidentifier <<FK>>
  InstantiationCode : varchar(128)
}

Philote ||--o{ Validity : "business-valid identity"
Validity "0..1 successor" --> "0..1 predecessor" Validity : "previous end"
Philote ||--o| RuleKind : "identity"
Philote ||--o| Primitive : "identity"
Philote ||--o| Rule : "identity"
Philote ||--o| RuleSet : "identity"
Philote ||--o| BuildSet : "identity"
Philote ||--o| Instantiation : "identity"

RuleKind ||--o{ Primitive : "classifies"
Primitive ||--o{ Input : "declares"
RuleKind ||--o{ Rule : "classifies"
Primitive ||--o{ Rule : "renders"
RuleSet ||--o{ RuleSetRule : "contains"
Rule ||--o{ RuleSetRule : "member"
BuildSet ||--o{ BuildSetRuleSet : "contains"
RuleSet ||--o{ BuildSetRuleSet : "member"
BuildSet ||--o{ Instantiation : "selected by"

note right of Validity
  [ValidFromUtc, ValidToUtc)
  NULL end = open-ended
  gaps allowed; overlaps rejected
end note

note bottom of Philote
  Every Philote-bearing entity uses the same GUID
  for its entity primary key and PhiloteId.
end note

@enduml
