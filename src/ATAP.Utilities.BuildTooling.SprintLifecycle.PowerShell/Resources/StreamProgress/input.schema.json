{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Sprint stream progress input manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "sprintNumber", "planningRoot", "outputPath", "activityPath", "policyPath", "startDate", "endDate", "timeZoneId", "observedAt", "sourceBinding", "taskStreamOverrides"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "sprintNumber": { "type": "integer", "minimum": 1, "maximum": 9999 },
    "planningRoot": { "type": "string", "minLength": 1 },
    "outputPath": { "type": "string", "minLength": 1 },
    "activityPath": { "type": "string", "minLength": 1 },
    "policyPath": { "type": "string", "minLength": 1 },
    "startDate": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
    "endDate": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
    "timeZoneId": { "type": "string", "minLength": 1 },
    "observedAt": { "type": "string", "minLength": 1 },
    "taskStreamOverrides": { "type": "object", "additionalProperties": { "type": "string", "minLength": 1 } },
    "sourceBinding": { "type": "object" }
  }
}
