  <!-- when creating Console programs or services, if they dynamically load Plugins, define where the Plugins subdirectory is located -->
  <PropertyGroup>
    <PluginsRelativeDir Condition="$(PluginsRelativeDir) == '' Or $(PluginsRelativeDir) == '*Undefined*'">Plugins\</PluginsRelativeDir>
    <PluginsDir Condition="$(PluginsDir) == '' Or $(PluginsDir) == '*Undefined*'">$(OutputPath)$(PluginsRelativeDir)</PluginsDir>
  </PropertyGroup>


  <!-- Solution-wide, copy newer .json settings files that exist in the project directory into the output directory -->
  <PropertyGroup>
    <PrepareForRunDependsOn>$(PrepareForRunDependsOn);CopyJSONSettingsFilesToOutputDirectory</PrepareForRunDependsOn>
  </PropertyGroup>
  <ItemGroup>
    <JsonSettingsFiles Include="*.json" Condition="$([System.Text.RegularExpressions.Regex]::IsMatch(%(Filename), '[Ss]ettings.*json$'))" />
  </ItemGroup>
  <Target Name="CopyJSONSettingsFilesToOutputDirectory">
    <Copy SourceFiles="@(JsonSettingsFiles)" DestinationFolder="$(OutDir)" />
  </Target>

  <!-- Targets for multiframework and multiple Runtime Identifiers publishing courtesy of
    this stackoverflow answer https://stackoverflow.com/questions/43947599/how-to-publish-for-all-target-frameworks
    this GIST:https://gist.github.com/dasMulli/b14026437468ce4b56ef93e010f24a36
    and this issue: https://github.com/dotnet/sdk/issues/9363
   -->

  <Target Name="PublishProjectForAllRIDsIfTargetFrameworkSet" Condition=" '$(TargetFramework)' != '' and '$(RuntimeIdentifiers)' != '' and '$(RuntimeIdentifier)' == ''  ">
    <ItemGroup>
      <_PublishRuntimeIdentifier Include="$(RuntimeIdentifiers)" />
    </ItemGroup>
    <MSBuild Projects="$(MSBuildProjectFile)" Targets="PublishAll" Properties="TargetFramework=$(TargetFramework);RuntimeIdentifier=%(_PublishRuntimeIdentifier.Identity)" />
  </Target>

  <Target Name="PublishProjectForAllFrameworksIfFrameworkUnset" Condition=" '$(TargetFramework)' == '' ">
    <ItemGroup>
      <_PublishFramework Include="$(TargetFrameworks)" />
    </ItemGroup>
    <MSBuild Projects="$(MSBuildProjectFile)" Targets="PublishAll" Properties="TargetFramework=%(_PublishFramework.Identity)" />
  </Target>

  <Target Name="PublishAll" DependsOnTargets="PublishProjectIfFrameworkSet;PublishProjectForAllRIDsIfTargetFrameworkSet;PublishProjectForAllFrameworksIfFrameworkUnset" />
  <Target Name="PublishProjectIfFrameworkSet" DependsOnTargets="Publish" Condition=" '$(TargetFramework)' != '' " />

  <!-- Microsoft Source Link for every project -->
  <ItemGroup>
    <PackageReference Include="Microsoft.SourceLink.GitHub">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <!-- Fody IL weaving for every project.
       Fody core (6.9.3+) is required for .NET 10 / MSBuildMajorVersion=18 support.
       MethodBoundaryAspect.Fody weaves method-entry/exit/exception tracing on any class
       decorated with [MethodBoundaryAspect] attributes; projects with no such attributes
       are unaffected. It is a build-time tool — PrivateAssets=all ensures neither it nor the
       Fody core it pulls in is emitted as a runtime dependency in the generated nuspec. -->
  <ItemGroup Condition="'$(DisableFody)' != 'true' And '$(ATAPDeferredOpenHardwareMonitorLib)' != 'True'">
    <!-- Fody core flows transitively from MethodBoundaryAspect.Fody and is centrally pinned. -->
    <PackageReference Include="MethodBoundaryAspect.Fody">
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <!-- Include Roslyn Code Analysis for every project -->
  <!-- FxCopAnalyzers package has been deprecated in favor of 'Microsoft.CodeAnalysis.NetAnalyzers', hence this is now commented out -->
  <!--
  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.FxCopAnalyzers"></PackageReference>
  </ItemGroup>
  -->

  <!-- Central Package Management is now handled in Directory.Packages.props -->
  <!-- See: https://learn.microsoft.com/en-us/nuget/consume-packages/central-package-management -->

  <!-- Constrain prerelease ATAP.* nuspec dependency ranges to [0.0.0-alpha-000, 2.0.0).
       Without this, NuGet pack writes ProjectReference deps as ">= resolved-version"
       because PackTask reads %(ProjectVersion) from _ProjectReferencesWithVersions items
       (populated by _GetProjectReferenceVersions via each referenced project's
       _GetProjectVersion target). %(ProjectVersion) is set to $(PackageVersion) of the
       referenced project, which at property-evaluation time resolves to a plain version
       like "0.1.0-Alpha" — NuGet interprets that as ">= 0.1.0-Alpha".
       This target runs AfterTargets="_GetProjectReferenceVersions" (items are populated)
       and before GenerateNuspec (items are consumed). It updates %(ProjectVersion) on
       every _ProjectReferencesWithVersions item whose csproj filename starts with "ATAP."
       Only applies to packable prerelease projects during the pack pass; stable packages
       keep the resolved stable ProjectReference dependency version. -->
  <Target Name="ConstrainATAPPackageDependencyVersionRange"
          AfterTargets="_GetProjectReferenceVersions"
          Condition="'$(IsPackable)' == 'true' and $([System.String]::Copy('$(PackageVersion)').Contains('-'))">
    <ItemGroup>
      <_ProjectReferencesWithVersions
        Update="@(_ProjectReferencesWithVersions)"
        Condition="$([System.String]::Copy('%(Filename)').StartsWith('ATAP.'))"
        ProjectVersion="[0.0.0-alpha-000, 2.0.0)" />
    </ItemGroup>
  </Target>

  <!-- Task 15.155: pin the approved stable secrets release closure only. -->
  <Target Name="PinStableSecretsReleaseDependencyVersions"
          AfterTargets="ConstrainATAPPackageDependencyVersionRange"
          BeforeTargets="GenerateNuspec"
          Condition="'$(PackageId)' == 'ATAP.Utilities.Secrets.BitwardenSecretsManager'">
    <ItemGroup>
      <_ProjectReferencesWithVersions
        Update="@(_ProjectReferencesWithVersions)"
        Condition="'%(Filename)' == 'ATAP.Utilities.Secrets.Interfaces' or '%(Filename)' == 'ATAP.Utilities.Secrets.Model'"
        ProjectVersion="[0.1.2]" />
    </ItemGroup>
  </Target>

  <Target Name="PinStableWindowsSecretsReleaseDependencyVersion"
          AfterTargets="ConstrainATAPPackageDependencyVersionRange"
          BeforeTargets="GenerateNuspec"
          Condition="'$(PackageId)' == 'ATAP.Utilities.Secrets.BitwardenSecretsManager.Windows'">
    <ItemGroup>
      <_ProjectReferencesWithVersions
        Update="@(_ProjectReferencesWithVersions)"
        Condition="'%(Filename)' == 'ATAP.Utilities.Secrets.BitwardenSecretsManager'"
        ProjectVersion="[0.1.1]" />
    </ItemGroup>
  </Target>

  <!-- Compute $(Version) at property-evaluation time from per-project version properties.
       This ensures NuGet resolves ProjectReference dependency ranges correctly in nuspecs.
       The custom BuildTooling task runs at build time (too late for pack dependency resolution),
       so NuGet falls back to 1.0.0 for ProjectReference deps without this property group.
       NOTE: This must live in Directory.Build.targets (not .props) so that per-project
       MajorVersion/MinorVersion/PatchVersion/PackageLabel are already evaluated when this runs. -->
  <PropertyGroup Condition="'$(MajorVersion)' != ''">
    <Version Condition="'$(PackageLabel)' != '' and '$(BuildRevision)' != ''">$(MajorVersion).$(MinorVersion).$(PatchVersion)-$(PackageLabel)-$(BuildRevision)</Version>
    <Version Condition="'$(PackageLabel)' != '' and '$(BuildRevision)' == ''">$(MajorVersion).$(MinorVersion).$(PatchVersion)-$(PackageLabel)</Version>
    <Version Condition="'$(PackageLabel)' == ''">$(MajorVersion).$(MinorVersion).$(PatchVersion)</Version>
  </PropertyGroup>

  <!-- Include Documentation generation for every project, but only when built with Net47, as docfx 2.51.2  is only supported on net47 -->
  <!--
  <ItemGroup Condition="$(TargetFramework.Contains('net47'))>
    <PackageReference Include="docfx" />
    <Folder Include="Documentation\" />
    <PackageReference Update="docfx" Version="2.51.2" />
  </ItemGroup>
  -->

  <!-- Safety net: fail the build when the primary output assembly is 0 bytes.
       Fody can leave a 0-byte DLL on disk when the C# language server
       (OmniSharp/Roslyn) holds a lock on Fody.dll or MethodBoundaryAspect.dll:
       Fody truncates the target file and then fails to rewrite it. Without
       this guard the build reports success and NuGet packs the empty DLL
       into a nupkg that downstream consumers cannot load. -->
  <UsingTask TaskName="AssertNonEmptyFile"
             TaskFactory="RoslynCodeTaskFactory"
             AssemblyFile="$(MSBuildToolsPath)\Microsoft.Build.Tasks.Core.dll">
    <ParameterGroup>
      <FilePath ParameterType="System.String" Required="true" />
    </ParameterGroup>
    <Task>
      <Code Type="Fragment" Language="cs"><![CDATA[
        var fi = new System.IO.FileInfo(FilePath);
        if (fi.Exists && fi.Length == 0)
        {
            Log.LogError("ATAPBUILD002: Output assembly '{0}' is 0 bytes. Fody likely could not weave because the C# language server holds a lock on Fody.dll or MethodBoundaryAspect.dll. In VS Code run 'C#: Restart Language Server', delete the file, then rebuild.", FilePath);
        }
      ]]></Code>
    </Task>
  </UsingTask>
  <Target Name="VerifyNonEmptyOutputAssembly"
          AfterTargets="Build"
          Condition="'$(TargetPath)' != '' And Exists('$(TargetPath)')">
    <AssertNonEmptyFile FilePath="$(TargetPath)" />
  </Target>

  <!-- Task 15.180.j: capture project-level build coupling after project evaluation, then
       force ordinary Build to remain separate from explicit Pack/Publish. -->
  <PropertyGroup>
    <ATAPRequestedGeneratePackageOnBuild>$(GeneratePackageOnBuild)</ATAPRequestedGeneratePackageOnBuild>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
    <ATAPExplicitPublicationInvocation Condition="'$(ATAPExplicitPublicationInvocation)' == ''">false</ATAPExplicitPublicationInvocation>
  </PropertyGroup>

  <ItemGroup Condition="'$(ATAPDeferredOpenHardwareMonitorLib)' != 'True'">
    <ATAPNestedFodyXml Include="$(MSBuildThisFileDirectory)**\FodyWeavers.xml"
                       Exclude="$(MSBuildThisFileDirectory)FodyWeavers.xml;$(MSBuildThisFileDirectory)_generated\**;$(MSBuildThisFileDirectory)**\bin\**;$(MSBuildThisFileDirectory)**\obj\**" />
    <ATAPNestedFodyXsd Include="$(MSBuildThisFileDirectory)**\FodyWeavers.xsd"
                       Exclude="$(MSBuildThisFileDirectory)_generated\**;$(MSBuildThisFileDirectory)**\bin\**;$(MSBuildThisFileDirectory)**\obj\**" />
  </ItemGroup>

  <UsingTask TaskName="ValidateATAPArtifactsPath"
             TaskFactory="RoslynCodeTaskFactory"
             AssemblyFile="$(MSBuildToolsPath)\Microsoft.Build.Tasks.Core.dll">
    <ParameterGroup>
      <Root ParameterType="System.String" Required="true" />
      <ArtifactsPath ParameterType="System.String" Required="true" />
      <ExpectedPath ParameterType="System.String" Required="true" />
      <RepositoryPath ParameterType="System.String" Required="true" />
      <Owner ParameterType="System.String" Required="true" />
    </ParameterGroup>
    <Task>
      <Using Namespace="System" />
      <Using Namespace="System.IO" />
      <Using Namespace="System.Text" />
      <Code Type="Fragment" Language="cs"><![CDATA[
        string Normalize(string value) => Path.GetFullPath(value).TrimEnd(Path.DirectorySeparatorChar, Path.AltDirectorySeparatorChar);
        string root;
        string actual;
        string expected;
        string repository;
        try
        {
            if (!Path.IsPathRooted(Root) || !Path.IsPathRooted(ArtifactsPath) || !Path.IsPathRooted(ExpectedPath))
            {
                Log.LogError("ATAPBUILD004: Artifact paths must be absolute.");
                return false;
            }
            root = Normalize(Root);
            actual = Normalize(ArtifactsPath);
            expected = Normalize(ExpectedPath);
            repository = Normalize(RepositoryPath);
        }
        catch (Exception ex)
        {
            Log.LogError("ATAPBUILD004: Artifact path normalization failed: {0}", ex.Message);
            return false;
        }
        if (!actual.Equals(expected, StringComparison.OrdinalIgnoreCase) ||
            !actual.StartsWith(root + Path.DirectorySeparatorChar, StringComparison.OrdinalIgnoreCase) ||
            actual.StartsWith(repository + Path.DirectorySeparatorChar, StringComparison.OrdinalIgnoreCase) ||
            actual.IndexOf(Path.DirectorySeparatorChar + "Dropbox" + Path.DirectorySeparatorChar, StringComparison.OrdinalIgnoreCase) >= 0 ||
            actual.Length > 180)
        {
            Log.LogError("ATAPBUILD004: ArtifactsPath '{0}' violates the canonical external path contract.", actual);
            return false;
        }
        try
        {
            Directory.CreateDirectory(actual);
            string probe = Path.Combine(actual, ".atap-write-probe-" + Guid.NewGuid().ToString("N"));
            File.WriteAllText(probe, Owner, new UTF8Encoding(false));
            File.Delete(probe);
            string marker = Path.Combine(actual, ".atap-artifacts-owner");
            try
            {
                using var stream = new FileStream(marker, FileMode.CreateNew, FileAccess.Write, FileShare.Read);
                using var writer = new StreamWriter(stream, new UTF8Encoding(false));
                writer.Write(Owner);
            }
            catch (IOException)
            {
                string existing = File.ReadAllText(marker).Trim();
                if (!existing.Equals(Owner, StringComparison.Ordinal))
                {
                    Log.LogError("ATAPBUILD005: ArtifactsPath '{0}' is claimed by '{1}', not '{2}'.", actual, existing, Owner);
                    return false;
                }
            }
        }
        catch (Exception ex)
        {
            Log.LogError("ATAPBUILD004: ArtifactsPath '{0}' is not writable: {1}", actual, ex.Message);
            return false;
        }
      ]]></Code>
    </Task>
  </UsingTask>

  <Target Name="ValidateATAPCommonBuildContract"
          BeforeTargets="PrepareForBuild;Pack;Publish;VSTest"
          Condition="'$(DesignTimeBuild)' != 'true' And '$(IsCrossTargetingBuild)' != 'true' And '$(ATAPDeferredOpenHardwareMonitorLib)' != 'True'">
    <Error Condition="'$(ATAPArtifactsRoot)' == ''" Code="ATAPBUILD003"
           Text="ATAP_ARTIFACTS_ROOT is required before build execution." />
    <Error Condition="'$(ATAPArtifactsRoot)' != '' And ('$(ATAPArtifactsWorktreeId)' == '' Or '$(ATAPArtifactsExecutionId)' == '' Or '$(ArtifactsPath)' == '')"
           Code="ATAPBUILD004" Text="Artifact worktree ID, execution ID, and canonical ArtifactsPath are required." />
    <ValidateATAPArtifactsPath Condition="'$(ATAPArtifactsRoot)' != '' And '$(ATAPArtifactsWorktreeId)' != '' And '$(ATAPArtifactsExecutionId)' != '' And '$(ArtifactsPath)' != ''"
                               Root="$(ATAPArtifactsRoot)" ArtifactsPath="$(ArtifactsPath)" ExpectedPath="$(ATAPExpectedArtifactsPath)"
                               RepositoryPath="$(MSBuildThisFileDirectory)" Owner="$(ATAPArtifactsOwner)" />
    <Error Condition="!Exists('$(ProjectWeaverXml)') Or '$(ProjectWeaverXml)' != '$(MSBuildThisFileDirectory)FodyWeavers.xml' Or '$(FodyGenerateXsd)' != 'false' Or '@(ATAPNestedFodyXml)' != '' Or '@(ATAPNestedFodyXsd)' != ''"
           Code="ATAPBUILD006" Text="Fody must use one repository-root FodyWeavers.xml, FodyGenerateXsd=false, and zero nested XML/XSD files." />
    <Error Condition="'$(ATAPRequestedGeneratePackageOnBuild)' == 'true' And '$(ATAPExplicitPublicationInvocation)' != 'true'"
           Code="ATAPBUILD007" Text="GeneratePackageOnBuild couples ordinary Build to publication. Remove it or invoke an explicit authorized publication path." />
    <Error Condition="'$(ATAPLoadBearingLockValidation)' == 'true' And ('$(RestoreForceEvaluate)' != 'true' Or '$(RestoreLockedMode)' != 'true')"
           Code="ATAPBUILD008" Text="Load-bearing lock validation requires forced graph evaluation and locked mode." />
    <Error Condition="'$(CentralPackageVersionOverrideEnabled)' == 'true' And !$([System.String]::Copy('$(MSBuildProjectFullPath)').EndsWith('tests\ATAP.Utilities.Philote.Tests\ATAP.Utilities.Philote.Tests.csproj', System.StringComparison.OrdinalIgnoreCase)) And !$([System.String]::Copy('$(MSBuildProjectFullPath)').EndsWith('tests\ATAP.Utilities.StronglyTypedIDs.Tests\ATAP.Utilities.StronglyTypedIDs.Tests.csproj', System.StringComparison.OrdinalIgnoreCase)) And !$([System.String]::Copy('$(MSBuildProjectFullPath)').EndsWith('tests\ATAP.Utilities.Serializer.Interfaces.PackageSmoke.Tests\ATAP.Utilities.Serializer.Interfaces.PackageSmoke.Tests.csproj', System.StringComparison.OrdinalIgnoreCase)) And !$([System.String]::Copy('$(MSBuildProjectFullPath)').EndsWith('tests\ATAP.Utilities.Secrets.BitwardenSecretsManager.PackageSmoke.Tests\ATAP.Utilities.Secrets.BitwardenSecretsManager.PackageSmoke.Tests.csproj', System.StringComparison.OrdinalIgnoreCase))"
           Code="ATAPBUILD009" Text="Central package VersionOverride is enabled outside the exact four-fixture allowlist." />
    <Error Condition="'$(ATAPRequireBuildToolingPackage)' == 'true' And '$(ATAPBuildToolingImported)' != 'true'"
           Code="ATAPBUILD019" Text="The required immutable ATAP.Utilities.BuildTooling.CSharp package import is missing." />
  </Target>
  <!-- Task 15.180.j: publication fails closed unless the repository-selected SDK,
       SDK-owned MSBuild/NuGet CLI, and deterministic publication properties match
       the pinned baseline. The validator is invoked with pwsh -File from RepoRoot;
       it performs read-only probes and deliberately does not inspect workloads. -->
  <Target Name="ValidateToolchainBaseline" BeforeTargets="Pack;Publish"
          Condition="'$(DesignTimeBuild)' != 'true' And '$(IsCrossTargetingBuild)' != 'true' And '$(ATAPDeferredOpenHardwareMonitorLib)' != 'True'">
    <Message Importance="high"
             Text="Validating the pinned publication toolchain baseline for '$(MSBuildProjectName)'..." />
    <Exec Command="pwsh -File &quot;$(MSBuildThisFileDirectory)Build\Test-ToolchainBaseline.ps1&quot; -RepoRoot &quot;$(MSBuildThisFileDirectory)&quot; -ProbeProject &quot;$(MSBuildProjectFullPath)&quot; -RequireContinuousIntegrationBuild"
          WorkingDirectory="$(MSBuildThisFileDirectory)"
          ContinueOnError="false" />
  </Target></Project>
