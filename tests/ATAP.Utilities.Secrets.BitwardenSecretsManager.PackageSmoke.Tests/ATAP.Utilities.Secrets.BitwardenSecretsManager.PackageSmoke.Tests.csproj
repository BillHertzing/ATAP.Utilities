<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Must be the PLURAL TargetFrameworks: Directory.Build.props sets
         <TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks> for every project, and when
         both are set the plural wins. Declaring only the singular here left the project building
         as non-Windows TFMs, which cannot reference the -windows-only SUT (NU1201). This matches
         the sibling BitwardenSecretsManager.UnitTests project. -->
    <TargetFrameworks>net10.0-windows</TargetFrameworks>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
    <IsPackable>false</IsPackable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <DisableFody>true</DisableFody>
    <UsePackageReferenceForSUT Condition="'$(UsePackageReferenceForSUT)' == ''">false</UsePackageReferenceForSUT>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup Condition="'$(UsePackageReferenceForSUT)' == 'false'">
    <ProjectReference Include="..\..\src\ATAP.Utilities.Secrets\BitwardenSecretsManager\ATAP.Utilities.Secrets.BitwardenSecretsManager.csproj" />
    <ProjectReference Include="..\..\src\ATAP.Utilities.Secrets\BitwardenSecretsManager\Windows\ATAP.Utilities.Secrets.BitwardenSecretsManager.Windows.csproj" />
  </ItemGroup>

  <!-- Package-smoke SUT fixture: permit the promoted package versions supplied by the caller. -->
  <PropertyGroup Condition="'$(UsePackageReferenceForSUT)' == 'true'">
    <CentralPackageVersionOverrideEnabled>true</CentralPackageVersionOverrideEnabled>
  </PropertyGroup>

  <PropertyGroup Condition="'$(UsePackageReferenceForSUT)' == 'true'">
    <CoreSutVersion Condition="'$(CoreSutVersion)' == ''">$(SUTVersion)</CoreSutVersion>
    <WindowsSutVersion Condition="'$(WindowsSutVersion)' == ''">$(SUTVersion)</WindowsSutVersion>
  </PropertyGroup>

  <ItemGroup Condition="'$(UsePackageReferenceForSUT)' == 'true'">
    <PackageVersion Include="ATAP.Utilities.Secrets.BitwardenSecretsManager" Version="0.0.0-placeholder" />
    <PackageVersion Include="ATAP.Utilities.Secrets.BitwardenSecretsManager.Windows" Version="0.0.0-placeholder" />
    <PackageReference Include="ATAP.Utilities.Secrets.BitwardenSecretsManager" VersionOverride="$(CoreSutVersion)" />
    <PackageReference Include="ATAP.Utilities.Secrets.BitwardenSecretsManager.Windows" VersionOverride="$(WindowsSutVersion)" />
  </ItemGroup>

</Project>
