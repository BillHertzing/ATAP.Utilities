{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://atap.example.com/schemas/db-manifest/v2.json",
  "title": "ATAP DB sub-manifest v2",
  "description": "Schema for db/db-manifest.json inside a database change package. Supports schema-only, data-only, and schema+data packages.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "dbChangeUnit",
    "appVersion",
    "changeKind",
    "flywayTargetVersion",
    "createdUtc",
    "createdFromGitTag",
    "createdFromGitSha",
    "files",
    "expectedRowCounts",
    "compatibleAppPackageRanges",
    "requiresPreviousProductionSnapshot",
    "rollbackSupported",
    "rollbackNotes",
    "evidenceRequirements"
  ],
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "const": 2,
      "description": "Format version of this DB sub-manifest schema."
    },
    "dbChangeUnit": {
      "$ref": "#/$defs/nonEmptyString",
      "description": "Stable identity for the DB change unit."
    },
    "appVersion": {
      "$ref": "#/$defs/semVerString",
      "description": "Application version associated with this DB change unit."
    },
    "changeKind": {
      "type": "string",
      "enum": ["schema", "data", "schemaAndData"],
      "description": "Declares whether this package contains schema migrations, seed/reference data, or both."
    },
    "dataKind": {
      "type": "string",
      "enum": ["staticReference", "slowlyChangingSeed", "repeatableLookup", "fixture", "migrationData"],
      "description": "Sub-classification of data content. Required when changeKind is 'data' or 'schemaAndData'."
    },
    "flywayTargetVersion": {
      "$ref": "#/$defs/flywayVersion",
      "description": "Flyway schema version reached by this bundle."
    },
    "createdUtc": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$",
      "description": "UTC timestamp when the DB sub-manifest was generated."
    },
    "createdFromGitTag": {
      "$ref": "#/$defs/nonEmptyString",
      "description": "Git tag used to generate the release bundle."
    },
    "createdFromGitSha": {
      "$ref": "#/$defs/gitShaOrDocumentedEllipsis",
      "description": "Git commit SHA used to generate the release bundle."
    },
    "files": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "kind", "checksumSha256"],
        "properties": {
          "path": {
            "$ref": "#/$defs/relativePath",
            "description": "Path relative to the bundle's db/ folder."
          },
          "kind": {
            "type": "string",
            "enum": ["migration", "repeatable", "seed", "seedLoader"],
            "description": "Role of the file in the DB change unit."
          },
          "checksumSha256": {
            "$ref": "#/$defs/checksumSha256",
            "description": "SHA-256 checksum for the file."
          },
          "expectedRowCount": {
            "type": "integer",
            "minimum": 0,
            "description": "Expected row count after loading this seed file."
          },
          "destructiveChangeKind": {
            "type": "string",
            "enum": ["none", "columnDrop", "tableDrop", "columnTypeNarrow", "dataDelete", "indexDrop", "constraintDrop"],
            "description": "For migration files: the most destructive operation present."
          }
        }
      },
      "description": "Files copied into the bundle's db/ folder."
    },
    "expectedRowCounts": {
      "type": "object",
      "propertyNames": {
        "$ref": "#/$defs/nonEmptyString"
      },
      "additionalProperties": {
        "type": "integer",
        "minimum": 0
      },
      "description": "Expected table row counts after loading seed data."
    },
    "compatibleAppPackageRanges": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "description": "SemVer ranges of application package versions compatible with this DB change unit."
    },
    "requiresPreviousProductionSnapshot": {
      "type": "boolean",
      "description": "When true, rehearsal gate must restore a production snapshot before Flyway runs."
    },
    "rollbackSupported": {
      "type": "boolean",
      "description": "Whether downgrade from this DB change unit is supported."
    },
    "rollbackNotes": {
      "$ref": "#/$defs/nonEmptyString",
      "description": "Operational rollback guidance."
    },
    "evidenceRequirements": {
      "type": "object",
      "description": "Per-tier evidence gates required before promotion.",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "flywayRehearsalRequired": { "type": "boolean" },
          "rowCountValidationRequired": { "type": "boolean" },
          "snapshotBackupRequired": { "type": "boolean" },
          "approvalRequired": { "type": "boolean" }
        }
      }
    }
  },
  "if": {
    "properties": {
      "changeKind": { "enum": ["data", "schemaAndData"] }
    }
  },
  "then": {
    "required": ["dataKind"]
  },
  "$defs": {
    "nonEmptyString": {
      "type": "string",
      "minLength": 1
    },
    "semVerString": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$"
    },
    "flywayVersion": {
      "type": "string",
      "pattern": "^[0-9]+(?:\\.[0-9]+)*$"
    },
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?![A-Za-z]:)(?!/)(?!.*\\\\)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
    },
    "gitShaOrDocumentedEllipsis": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[0-9a-fA-F]{40}$"
        },
        {
          "type": "string",
          "pattern": "^[0-9a-fA-F]{7,40}\\.\\.\\.$"
        }
      ]
    },
    "checksumSha256": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[0-9a-fA-F]{64}$"
        },
        {
          "const": "..."
        }
      ]
    }
  }
}
