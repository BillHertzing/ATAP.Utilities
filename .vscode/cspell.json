{
  "version": "0.2",
  // 1) Import official language dictionaries (installed via npm)
  "import": [
    "@cspell/dict-csharp/cspell-ext.json",
    "@cspell/dict-html/cspell-ext.json",
    "@cspell/dict-markdown/cspell-ext.json",
    "@cspell/dict-powershell/cspell-ext.json",
    "@cspell/dict-python/cspell-ext.json",
    "@cspell/dict-sql/cspell-ext.json",
    "@cspell/dict-typescript/cspell-ext.json"
  ],
  // Register your repo-local dictionaries
  "dictionaryDefinitions": [
    {
      "name": "ATAPDictionary",
      "path": "./ATAP_cspell_dictionary.txt",
      "addWords": true
    },
    {
      "name": "ansible-terms",
      "path": "./dictionaries/ansible-terms.txt",
      "addWords": true
    },
    {
      "name": "jenkins-terms",
      "path": "./dictionaries/jenkins-terms.txt",
      "addWords": true
    }
  ],
  // Enable dictionaries globally (language ones)
  "dictionaries": ["ATAPDictionary", "csharp", "html", "markdown", "powershell", "python", "sql", "typescript", "ansible-terms", "jenkins-terms"],
  "allowCompoundWords": true,
  "enabledLanguageIds": ["csharp", "css", "html", "java", "javascript", "json", "jsonc", "markdown", "plaintext", "powershell", "python", "sql", "typescript", "uml", "xml", "yaml"],
  "useGitignore": true,
  "ignorePaths": [".gitignore", "package-lock.json", "node_modules", "vscode-extension", ".git/objects", ".vscode-insiders"],
  "ignoreRegExpList": ["uild"],
  "flagWords": ["teh:the"],
  "overrides": [
    {
      "filename": "*settings.json*",
      "ignoreRegExpList": ["/[Jj]enkins[Ff]ile/", "/[tT]ests/", "/dontShowNewVersionMessage/"]
    }
  ],
  "words": [],
  "ignoreWords": ["nodir"]
}
