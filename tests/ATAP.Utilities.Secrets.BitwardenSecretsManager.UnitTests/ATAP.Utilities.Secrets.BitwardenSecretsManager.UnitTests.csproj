<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net10.0-windows</TargetFrameworks>
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
    <IsPackable>false</IsPackable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <DisableFody>true</DisableFody>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\ATAP.Utilities.Secrets\BitwardenSecretsManager\ATAP.Utilities.Secrets.BitwardenSecretsManager.csproj" />
    <ProjectReference Include="..\..\src\ATAP.Utilities.Secrets\BitwardenSecretsManager\Windows\ATAP.Utilities.Secrets.BitwardenSecretsManager.Windows.csproj" />
    <ProjectReference Include="BwsProcessTestDouble\BwsProcessTestDouble.csproj" ReferenceOutputAssembly="false" />
    <Compile Remove="BwsProcessTestDouble\**\*.cs" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="Newtonsoft.Json" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio"><PrivateAssets>all</PrivateAssets></PackageReference>
  </ItemGroup>
  <Target Name="CopyBwsProcessTestDouble" AfterTargets="Build" Condition="'$(IsCrossTargetingBuild)' != 'true'">
    <PropertyGroup>
      <_BwsProcessTestDoubleOutputDirectory>$(ArtifactsPath)\bin\BwsProcessTestDouble\$([System.String]::Copy('$(Configuration)').ToLowerInvariant())_net10.0-windows_win-x64</_BwsProcessTestDoubleOutputDirectory>
    </PropertyGroup>
    <ItemGroup>
      <_BwsProcessTestDoubleFiles Include="$(_BwsProcessTestDoubleOutputDirectory)\BwsProcessTestDouble.dll" />
      <_BwsProcessTestDoubleFiles Include="$(_BwsProcessTestDoubleOutputDirectory)\BwsProcessTestDouble.deps.json" />
      <_BwsProcessTestDoubleFiles Include="$(_BwsProcessTestDoubleOutputDirectory)\BwsProcessTestDouble.runtimeconfig.json" />
    </ItemGroup>
    <Copy SourceFiles="@(_BwsProcessTestDoubleFiles)" DestinationFolder="$(OutDir)BwsProcessTestDouble" SkipUnchangedFiles="true" />
  </Target>
</Project>
