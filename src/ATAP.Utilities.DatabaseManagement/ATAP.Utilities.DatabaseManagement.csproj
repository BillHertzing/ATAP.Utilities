<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Library</OutputType>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <IsPackable>true</IsPackable>
    <!-- Assembly, File, and Package Information for this assembly-->
    <!-- Build and revision are created based on date-->
    <MajorVersion>0</MajorVersion>
    <MinorVersion>1</MinorVersion>
    <PatchVersion>0</PatchVersion>
    <!-- Current Lifecycle stage for this assembly-->
    <PackageLifeCycleStage>Development</PackageLifeCycleStage>
    <!-- NuGet Package Label for the Nuget Package if the LifeCyclestage is not Production-->
    <!-- However, if the LifeCyclestage is Production, the NuGet Package Label is ignored, but MSBuild expects a non-null value  -->
    <PackageLabel>Alpha</PackageLabel>
  </PropertyGroup>

  <!--
    This prototype targets the legacy SQL CLR surface and cannot be compiled for
    the repository's net8.0/net9.0/net10.0 targets. It is retained as historical
    source but is not part of the modern DatabaseManagement assembly.
  -->
  <ItemGroup>
    <Compile Remove="udfGetTableNamesFromBCPFilesInDirectory.cs" />
  </ItemGroup>

<!--
  <ItemGroup>
    <PackageReference Include="ServiceStack.OrmLite"/>
    <PackageReference Include="ServiceStack.OrmLite.SqlServer.Data"/>
  </ItemGroup>
-->
  <!-- Packages and projects to implement IL Weaving using Fody during the build process -->
</Project>
