{
  "gitignore": true,
  "globs": [
    "**/*.md"
  ],
  "ignores": [
    "_generated/**",
    "node_modules/**"
  ],
  "config": {
    "default": true,
    "MD003": {
      "style": "atx"
    },
    "MD007": {
      "indent": 2
    },
    "MD013": false,
    "MD025": {
      "front_matter_title": ""
    },
    "MD033": {
      "allowed_elements": [
        "figure",
        "video"
      ]
    },
    "MD060": false,
    "no-hard-tabs": true,
    "whitespace": false
  }
}
