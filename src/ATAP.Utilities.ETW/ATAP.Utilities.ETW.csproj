<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <PackageVersion>0.1.2</PackageVersion>
    <Version>0.1.2</Version>
    <OutputType>Library</OutputType>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <IsPackable>true</IsPackable>
    <DisableFody>true</DisableFody>
    <Description>ETW (Event Tracing for Windows) log attribute and provider using Fody MethodBoundaryAspect for automatic method entry, exit, and exception tracing.</Description>
  </PropertyGroup>
  <ItemGroup>
    <!-- The provider owns the aspect base type but must never weave itself (L1). -->
    <PackageReference Include="MethodBoundaryAspect.Fody">
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>
</Project>