# Flyway environment configuration for Tags database
# Database: Tags - Hierarchical I18N-ready tag system with ResourceKey localization

# Experimental environment (default - localhost)
FLYWAY_EXP_URL=jdbc:sqlserver://localhost;databaseName=Tags;integratedSecurity=true;encrypt=false;trustServerCertificate=true
FLYWAY_EXP_USER=
FLYWAY_EXP_PASSWORD=

# Development environment
FLYWAY_DEV_URL=jdbc:sqlserver://localhost;instanceName=Development;databaseName=Tags;integratedSecurity=true;encrypt=false;trustServerCertificate=true
FLYWAY_DEV_USER=
FLYWAY_DEV_PASSWORD=

# Testing environment
FLYWAY_TEST_URL=jdbc:sqlserver://localhost;instanceName=Testing;databaseName=Tags;integratedSecurity=true;encrypt=false;trustServerCertificate=true
FLYWAY_TEST_USER=
FLYWAY_TEST_PASSWORD=

# Production environment
FLYWAY_PROD_URL=jdbc:sqlserver://localhost;instanceName=Production;databaseName=Tags;integratedSecurity=true;encrypt=false;trustServerCertificate=true
FLYWAY_PROD_USER=
FLYWAY_PROD_PASSWORD=

# Shared SQL migration locations
FLYWAY_SHARED_SQL_PATH=C:/Dropbox/whertzing/GitHub/ATAP.Utilities/src/ATAP.Utilities.DatabaseManagement/SharedSQL

