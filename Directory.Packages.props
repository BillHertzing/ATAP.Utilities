<Project>
  <!-- Enable Central Package Management (NuGet 6.2+, .NET SDK 6.0.300+) -->
  <!-- Documentation: https://learn.microsoft.com/en-us/nuget/consume-packages/central-package-management -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>
  <ItemGroup Label="Security Patches (Critical - Addresses Known Vulnerabilities)">
    <!-- HTTP library (4.3.0 has a vulnerability) -->
    <PackageVersion Include="System.Net.HTTP" Version="4.8.1" />
    <!-- URI library (4.3.0 has a vulnerability) -->
    <PackageVersion Include="System.Private.URI" Version="4.3.4" />
    <PackageVersion Include="System.Runtime.Handles" Version="4.3.0" />
    <!-- Required to prevent error NU1605 -->
    <PackageVersion Include="System.Runtime.InteropServices" Version="4.3.0" />
    <!-- Regex library (4.3.0 has a vulnerability) -->
    <PackageVersion Include="System.Text.RegularExpressions" Version="5.0.0" />
    <!-- System.Drawing.Common (4.7.0 has critical vulnerability GHSA-rxg9-xrhp-64gj, upgrade to 8.0.2+) -->
    <PackageVersion Include="System.Drawing.Common" Version="8.0.2" />
    <!-- System.Security.Cryptography.Xml (4.7.0 has moderate vulnerability GHSA-vh55-786g-wjwj, 8.0.1 has high severity GHSA-37gx-xxp4-5rgx and GHSA-w3x6-4m5h-cxqf) -->
    <PackageVersion Include="System.Security.Cryptography.Xml" Version="8.0.2" />
  </ItemGroup>
  <ItemGroup Label="Core Libraries">
    <PackageVersion Include="DotNet.Contracts" Version="1.10.20606.1" />
    <PackageVersion Include="FSharp.Core" Version="4.3.4" />
    <PackageVersion Include="FSharpx.Collections.Experimental" Version="2.1.3" />
    <PackageVersion Include="McMaster.NETCore.Plugins" Version="1.4.0" />
    <!-- newtonsoft JSON serializer -->
    <PackageVersion Include="Newtonsoft.Json" Version="13.0.4" />
    <!-- Stateless lightweight StateMachine library -->
    <PackageVersion Include="Stateless" Version="5.1.2" />
    <PackageVersion Include="System.Collections.Immutable" Version="5.0.0" />
    <!-- Reactive Extensions -->
    <PackageVersion Include="System.Reactive" Version="5.0.0" />
    <!-- Text-To-Speech (TTS) packages -->
    <PackageVersion Include="System.Speech" Version="5.0.0" />
    <!-- QuickGraph and its dependencies -->
    <PackageVersion Include="YC.QuickGraph" Version="3.7.4" />
  </ItemGroup>
  <ItemGroup Label="ServiceStack Suite">
    <PackageVersion Include="ServiceStack" Version="5.12.0" />
    <PackageVersion Include="ServiceStack.HttpClient" Version="5.12.0" />
    <!-- ServiceStack ORMLite and SQLServer -->
    <PackageVersion Include="ServiceStack.OrmLite" Version="5.12.0" />
    <PackageVersion Include="ServiceStack.OrmLite.Core" Version="5.12.0" />
    <PackageVersion Include="ServiceStack.OrmLite.MySQL" Version="5.12.0" />
    <PackageVersion Include="ServiceStack.OrmLite.MySQL.Core" Version="5.12.0" />
    <PackageVersion Include="ServiceStack.OrmLite.Sqlite" Version="5.12.0" />
    <PackageVersion Include="ServiceStack.OrmLite.Sqlite.Core" Version="5.12.0" />
    <PackageVersion Include="ServiceStack.OrmLite.SqlServer" Version="5.12.0" />
    <PackageVersion Include="ServiceStack.OrmLite.SqlServer.Core" Version="5.12.0" />
    <PackageVersion Include="ServiceStack.Text" Version="5.12.0" />
    <!-- ServiceStack serializers and dump utility -->
    <PackageVersion Include="ServiceStack.Text.EnumMemberSerializer" Version="3.0.0.50044" />
  </ItemGroup>
  <ItemGroup Label="Time and Date Libraries">
    <!-- Library of rich time and interval manipulation routines -->
    <PackageVersion Include="TimePeriodLibrary.NET" Version="2.1.5" />
  </ItemGroup>
  <ItemGroup Label="ATAP.Utilities.Configuration Family">
    <PackageVersion Include="ATAP.Utilities.Configuration" Version="0.1.0-Sprint.6" />
    <PackageVersion Include="ATAP.Utilities.Configuration.Extensions" Version="0.1.0-Sprint.6" />
    <PackageVersion Include="ATAP.Utilities.Configuration.Secrets" Version="0.1.0-Sprint.6" />
    <PackageVersion Include="ATAP.Utilities.Configuration.Secrets.Shim.Bitwarden" Version="0.1.0-Sprint.6" />
    <PackageVersion Include="ATAP.Utilities.Configuration.Secrets.Shims" Version="0.1.0-Sprint.6" />
    <PackageVersion Include="ATAP.Utilities.Configuration.Secrets.Shims.Interfaces" Version="0.1.0-Sprint.6" />
  </ItemGroup>
  <ItemGroup Label="Microsoft.Extensions.* (Configuration, Hosting, DI, Logging)">
    <!-- Packages necessary to run the Net Core Generic Host and web server hosts -->
    <PackageVersion Include="Microsoft.Extensions.Configuration" Version="9.0.0" />
    <PackageVersion Include="Microsoft.Extensions.Configuration.Abstractions" Version="9.0.0" />
    <PackageVersion Include="Microsoft.Extensions.Configuration.Binder" Version="9.0.0" />
    <PackageVersion Include="Microsoft.Extensions.Configuration.CommandLine" Version="9.0.0" />
    <PackageVersion Include="Microsoft.Extensions.Configuration.EnvironmentVariables" Version="9.0.0" />
    <PackageVersion Include="Microsoft.Extensions.Configuration.Json" Version="9.0.0" />
    <!-- Standalone reference to Microsoft.Extensions.DependencyInjection used by unitTest projects -->
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection" Version="9.0.0" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="9.0.0" />
    <PackageVersion Include="Microsoft.Extensions.Hosting" Version="9.0.0" />
    <PackageVersion Include="Microsoft.Extensions.Localization" Version="9.0.0" />
    <PackageVersion Include="Microsoft.Extensions.Options.DataAnnotations" Version="9.0.0" />
    <PackageVersion Include="Microsoft.SemanticKernel" Version="1.71.0" />
    <PackageVersion Include="Microsoft.Extensions.Logging" Version="9.0.0" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="9.0.0" />
  </ItemGroup>
  <ItemGroup Label="Dependency Injection Alternatives">
    <!-- Alternate DI container used in UnitTest projects -->
    <PackageVersion Include="Ninject" Version="3.3.6" />
    <PackageVersion Include="Ninject.extensions.conventions" Version="3.3.0" />
  </ItemGroup>
  <ItemGroup Label="Resilience and Polly">
    <!-- Packages to add resilience policies to async and synchronous operations which may have transient exceptions -->
    <PackageVersion Include="Polly" Version="8.5.0" />
    <PackageVersion Include="Polly.Contrib.WaitAndRetry" Version="1.1.1" />
    <!-- Deprecated package - retained for backwards compatibility with existing projects -->
    <PackageVersion Include="Polly.Extensions.Http" Version="3.0.0" />
  </ItemGroup>
  <ItemGroup Label="File I/O and Abstractions">
    <!-- FileIO Extension to provide file and directory Globbing -->
    <PackageVersion Include="System.IO.Abstractions" Version="21.1.3" />
    <PackageVersion Include="System.IO.Abstractions.TestingHelpers" Version="21.1.3" />
  </ItemGroup>
  <ItemGroup Label="Aspect-Oriented Programming">
    <!-- Packages to implement ETW logging of method entry, method exit, and exceptions -->
    <!-- Fody core must be pinned to 6.9.3+ for .NET 10 / MSBuildMajorVersion=18 support.
         NuGet resolves MethodBoundaryAspect.Fody's transitive Fody dep to the minimum
         required version (6.7.0) which produces 0-byte DLLs on .NET 10. Explicit pin here
         forces NuGet to select 6.9.3 which added .NET 10 support. -->
    <PackageVersion Include="Fody" Version="6.9.3" />
    <PackageVersion Include="MethodBoundaryAspect.Fody" Version="2.0.150" />
  </ItemGroup>
  <ItemGroup Label="Messaging and Dataflow">
    <!-- RabbitMQ client library -->
    <PackageVersion Include="RabbitMQ.Client" Version="7.0.0" />
    <!-- Task Parallel (TPL) Library -->
    <PackageVersion Include="System.Threading.Tasks.Dataflow" Version="9.0.0" />
  </ItemGroup>
  <ItemGroup Label="Object Mapping">
    <!-- The Automapper Package (13.0.1 had high severity vulnerability GHSA-rvv3-g6hj-g44x) -->
    <PackageVersion Include="AutoMapper" Version="13.0.2" />
  </ItemGroup>
  <ItemGroup Label="MSBuild Custom Tasks">
    <!-- Packages used for custom build tasks -->
    <PackageVersion Include="Microsoft.Build.Framework" Version="17.14.28" />
    <PackageVersion Include="Microsoft.Build.Utilities.Core" Version="17.14.28" />
    <!-- NBGV MSBuild integration — version must match the nbgv CLI tool -->
    <PackageVersion Include="Nerdbank.GitVersioning" Version="3.9.50" />
  </ItemGroup>
  <ItemGroup Label="Source Link">
    <!-- Microsoft Source Link -->
    <PackageVersion Include="Microsoft.SourceLink.GitHub" Version="8.0.0" />
  </ItemGroup>
  <ItemGroup Label="Serilog Logging Suite">
    <!-- Seq Extensions for Microsoft.Extensions.Logging -->
    <PackageVersion Include="Seq.Extensions.Logging" Version="6.0.0" />
    <PackageVersion Include="Serilog" Version="4.1.0" />
    <PackageVersion Include="Serilog.Enrichers.Thread" Version="4.0.0" />
    <PackageVersion Include="Serilog.Exceptions" Version="7.1.0" />
    <PackageVersion Include="Serilog.Extensions.Hosting" Version="4.1.2" />
    <PackageVersion Include="Serilog.Extensions.Logging" Version="3.0.1" />
    <PackageVersion Include="Serilog.Settings.Configuration" Version="8.0.4" />
    <PackageVersion Include="Serilog.Sinks.Console" Version="4.0.0" />
    <PackageVersion Include="Serilog.Sinks.Debug" Version="2.0" />
    <PackageVersion Include="Serilog.Sinks.File" Version="5.0.0" />
    <PackageVersion Include="Serilog.Sinks.Seq" Version="5.0.0" />
    <PackageVersion Include="SerilogAnalyzer" Version="0.15.0" />
  </ItemGroup>
  <ItemGroup Label="Process Management">
    <!-- Package to ease spawning of and communications with processes -->
    <PackageVersion Include="MedallionShell" Version="1.6.2" />
  </ItemGroup>
  <ItemGroup Label="Units of Measure">
    <!-- Package to use real-world Units of Measure -->
    <PackageVersion Include="UnitsNet" Version="5.60.0" />
  </ItemGroup>
  <ItemGroup Label="DI Extensions">
    <!-- Package to extend Microsoft.Extensions.DependencyInjection with Scan and Decorate methods -->
    <PackageVersion Include="Scrutor" Version="3.3.0" />
  </ItemGroup>
  <ItemGroup Label="xUnit Testing Suite">
    <!-- Packages to add xUnit Testing providers and extensions -->
    <PackageVersion Include="coverlet.collector" Version="3.1.0" />
    <!-- DotNetCliToolReference (deprecated but still used in some projects) -->
    <PackageVersion Include="dotnet-xunit" Version="2.3.1" />
    <PackageVersion Include="FluentAssertions" Version="6.2.0" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="17.0.0" />
    <PackageVersion Include="Moq" Version="4.16.1" />
    <PackageVersion Include="xunit" Version="2.4.1" />
    <PackageVersion Include="Xunit.DependencyInjection" Version="7.1.0" />
    <PackageVersion Include="xunit.runner.console" Version="2.4.1" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="2.4.3" />
  </ItemGroup>
  <ItemGroup Label="Legacy/Unsorted Packages">
    <!-- DocFX package -->
    <PackageVersion Include="docfx" Version="2.56.5" />
    <!-- Packages to play with CSharpSyntaxTree -->
    <PackageVersion Include="Microsoft.CodeAnalysis.Common" Version="3.5.0" />
    <!-- Dynamic Types -->
    <PackageVersion Include="Microsoft.CSharp" Version="4.7.0" />
    <PackageVersion Include="NLog" Version="4.7.0" />
    <PackageVersion Include="NLog.Config" Version="4.7.0" />
    <PackageVersion Include="System.Dynamic.Runtime" Version="4.3.0" />
    <!-- Windows Task Scheduler wrapper -->
    <PackageVersion Include="TaskScheduler" Version="2.11.0" />
  </ItemGroup>
  <!-- Framework-Conditional Package Versions -->
  <!-- These package versions vary based on target framework -->
  <ItemGroup Label="Framework-Conditional: All Frameworks (net472+)">
    <!-- System.Text.Json V 5.0.0 supports framework 4.7.2 and later -->
    <!-- Condition matches: net472, net48, netstandard, netcore, net5+, net6+, net7+, net8+, net9+ -->
    <PackageVersion Include="System.Text.Json" Version="5.0.0" Condition="$([System.Text.RegularExpressions.Regex]::IsMatch('$(TargetFramework)', '(net|net472|standard|core|net[56789])'))" />
  </ItemGroup>
  <ItemGroup Label="Roslyn Code Analysis">
    <!-- Packages for Roslyn code analysis and workspaces -->
    <PackageVersion Include="Microsoft.Build.Locator" Version="1.2.2" />
    <PackageVersion Include="Microsoft.CodeAnalysis.Analyzers" Version="2.9.8" />
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp.Workspaces" Version="3.3.1" />
    <PackageVersion Include="Microsoft.CodeAnalysis.VisualBasic.Workspaces" Version="3.3.1" />
    <PackageVersion Include="Microsoft.CodeAnalysis.Workspaces.MSBuild" Version="3.3.1" />
  </ItemGroup>
</Project>