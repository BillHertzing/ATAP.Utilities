<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Library</OutputType>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <IsPackable>true</IsPackable>
    <EnableDefaultItems>false</EnableDefaultItems>
    <Description>Aggregator package for ATAP.Utilities.StronglyTypedId libraries.</Description>
    <!-- No source files — intentional for this aggregator facade; IncludeBuildOutput=false
         tells NuGet pack not to expect or include a DLL. Dependencies declared via
         ProjectReference below become package-level dependencies in the generated .nuspec. -->
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <NoWarn>$(NoWarn);CS2008;NU5128</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="Interfaces/ATAP.Utilities.StronglyTypedId.Interfaces.csproj" />
    <ProjectReference Include="Models/ATAP.Utilities.StronglyTypedId.Models.csproj" />
    <ProjectReference Include="JsonConverter.Shim.SystemTextJson/ATAP.Utilities.StronglyTypedId.JsonConverter.Shim.SystemTextJson.csproj" />
  </ItemGroup>

</Project>
