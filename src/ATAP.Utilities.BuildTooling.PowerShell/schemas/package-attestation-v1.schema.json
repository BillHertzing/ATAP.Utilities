{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "urn:atap:coordination:package-attestation:v1",
  "title": "Coordination-package-attestation-v1",
  "description": "Release-process attestation of one module package: archive, non-test file inventory, signer, schema hashes, semantic revision and the production test receipts it is bound to. Shape only; installed-state, signature and policy checks are performed by Test-CoordPackageAttestation.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "kind",
    "moduleName",
    "moduleVersion",
    "archiveSha256",
    "files",
    "signerThumbprint",
    "stateSchemaSha256",
    "requestSchemaSha256",
    "resultSchemaSha256",
    "coordinationSemanticRevision",
    "buildId",
    "executionIds",
    "finalProductionTestReceiptSha256",
    "tierReceiptSha256",
    "productionReceiptBinding",
    "createdUtc"
  ],
  "properties": {
    "kind": {
      "const": "Coordination-package-attestation-v1"
    },
    "moduleName": {
      "const": "ATAP.Utilities.BuildTooling.Orchestration.PowerShell"
    },
    "moduleVersion": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "archiveSha256": {
      "type": "string",
      "pattern": "^[0-9A-Fa-f]{64}$"
    },
    "files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "sha256", "size"],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1,
            "pattern": "^(?!/)(?!.*\\.\\.)[^\\\\]+$"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9A-Fa-f]{64}$"
          },
          "size": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    },
    "signerThumbprint": {
      "type": "string",
      "pattern": "^[0-9A-Fa-f]{40}$"
    },
    "stateSchemaSha256": {
      "type": "string",
      "pattern": "^[0-9A-Fa-f]{64}$"
    },
    "requestSchemaSha256": {
      "type": "string",
      "pattern": "^[0-9A-Fa-f]{64}$"
    },
    "resultSchemaSha256": {
      "type": "string",
      "pattern": "^[0-9A-Fa-f]{64}$"
    },
    "coordinationSemanticRevision": {
      "type": "string",
      "minLength": 1
    },
    "buildId": {
      "type": "string",
      "minLength": 1
    },
    "executionIds": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "finalProductionTestReceiptSha256": {
      "type": "string",
      "pattern": "^[0-9A-Fa-f]{64}$"
    },
    "tierReceiptSha256": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "string",
        "pattern": "^[0-9A-Fa-f]{64}$"
      }
    },
    "productionReceiptBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["archiveSha256", "moduleVersion", "receiptSha256"],
      "properties": {
        "archiveSha256": {
          "type": "string",
          "pattern": "^[0-9A-Fa-f]{64}$"
        },
        "moduleVersion": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
        },
        "receiptSha256": {
          "type": "string",
          "pattern": "^[0-9A-Fa-f]{64}$"
        }
      }
    },
    "createdUtc": {
      "type": "string",
      "format": "date-time"
    }
  }
}
