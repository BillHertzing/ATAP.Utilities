"code": "...existing code...\n PROCESS {\n\n # Start process\n $process.Start() | Out-Null\n\n # Read output synchronously\n $stdOut = $process.StandardOutput.ReadToEnd()\n $stdErr = $process.StandardError.ReadToEnd()\n\n # Wait for exit\n $process.WaitForExit()\n $exitCode = $process.ExitCode\n\n # Process stdout lines\n $lines = $stdOut -split \"`r?`n\"\n $script:lineNumber = 0\n foreach ($line in $lines) {\n if ($script:lineNumber -lt $discardPreambleLines) {\n $script:lineNumber++\n continue\n }\n if ($line -match $regexPattern) {\n Write-Output $line\n }\n else {\n Write-PSFMessage -Level Error -Message \"$line did not match the pattern $regexPattern. Line number $script:lineNumber was $line\"\n }\n $script:lineNumber++\n }\n\n # Process stderr lines\n if ($stdErr) {\n $errLines = $stdErr -split \"`r?`n\"\n foreach ($errLine in $errLines) {\n if ($errLine) {\n Write-PSFMessage -Level Warning -Message \"Choco warning: $errLine\" -Tag 'Trace', 'Get-ChocolateyPackagesNeedingUpdate'\n }\n }\n }\n\n return $exitCode\n }\n...existing code...\n",
"resource": {
