// A launch configuration for VSC Extension development
//   compiles a VSC extension and then opens it inside an extension development host
//   runs VSC extension tests inside an extension development host
{
  // Use IntelliSense to learn about possible attributes.
  // Hover to view descriptions of existing attributes.
  // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
  "version": "0.2.0",
  "configurations": [
    //  ************************************************************************
    // VSC Extension development
    //  These require an environment variable to tell the launch configurations the location of the source code and test code
    //    env:VSCExtensionProjectAbsolutePath
    {
      "name": "Run Extension",
      "type": "extensionHost",
      "request": "launch",
      "args": [
        // specifies the directory of the project.json file
        "--extensionDevelopmentPath=${env:VSCExtensionProjectAbsolutePath}",
        "--disable-extension=dbaeumer.vscode-eslint",
        // "--disable-extensions",
        "${env:VSCExtensionProjectAbsolutePath}" // set the folder to open on startup
      ],
      "outFiles": ["${env:VSCExtensionProjectAbsolutePath}/_generated/dist/**/*.js"],
      "smartStep": true,
      "preLaunchTask": "${defaultBuildTask}",
      "sourceMaps": true,
      "env": {
        "VSCODE_DEV": "1"
      }
    },
    {
      "name": "Extension Tests (Combined)",
      "type": "extensionHost",
      "request": "launch",
      "runtimeExecutable": "${execPath}",
      "args": [
        "--extensionDevelopmentPath=${env:VSCExtensionProjectAbsolutePath}",
        "--extensionTestsPath=${env:VSCExtensionProjectAbsolutePath}/_generated/combinedTests/tests/runTests.js",
        "--disable-extension=github.copilot",
        "--disable-extension=github.copilot-chat-extension",
        "--disable-extension=dbaeumer.vscode-eslint",
        "--disable-extension=eamodio.gitlens-extension",
        //"--disable-extensions",  // This will disable ALL of the VSC  extensions installed in the VSC instance used to develop the extension
        // another option is to individually disable specific extensions, but this can get very "wordy" if there are 83 extensions
        //  There is no way to "disable all except for [abc,xyz]", which would be preferred, as then it would be possible to keep just a few extensions enabled
        "${env:VSCExtensionProjectAbsolutePath}"
      ],
      "outFiles": [
        "${env:VSCExtensionProjectAbsolutePath}/_generated/combinedTests/tests/**/*.test.js"
        //"${workspaceFolder}/_generated/dist/**/*.js"
      ],
      "preLaunchTask": "tasks: watch-tests",
      // Enable source maps
      "sourceMaps": true //
    },

    {
      "type": "node",
      "request": "launch",
      "name": "Mocha Tests",
      "program": "${env:VSCExtensionProjectAbsolutePath}/node_modules/mocha/bin/_mocha",
      "args": ["-r", "ts-node/register", "-r", "tsconfig-paths/register", "-u", "tdd", "--timeout", "999999", "--colors", "${env:VSCExtensionProjectAbsolutePath}/_generated/mochaTests/**/*.test.js"],
      "internalConsoleOptions": "openOnSessionStart",
      "preLaunchTask": "tasks: watch-tests",
      "sourceMaps": true // Enable source maps
    },
    {
      "type": "node",
      "request": "launch",
      "name": "Debug Webpack",
      "program": "${env:VSCExtensionProjectAbsolutePath}/node_modules/webpack/bin/webpack.js",
      "args": [],
      "stopOnEntry": false,
      "cwd": "${env:VSCExtensionProjectAbsolutePath}",
      "autoAttachChildProcesses": true
    }
  ]
}
