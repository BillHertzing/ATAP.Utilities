<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Library</OutputType>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
    <IsPackable>true</IsPackable>
    <BuildOutputTargetFolder>tools</BuildOutputTargetFolder>
    <PackageId>ATAP.Utilities.BuildTooling.CSharp</PackageId>
    <Description>Canonical versioned ATAP C# MSBuild distribution and bootstrap contract.</Description>
    <PackageReadmeFile>ReadMe.md</PackageReadmeFile>
    <PackageTags>ATAP;MSBuild;BuildTooling;bootstrap</PackageTags>
    <RepositoryType>git</RepositoryType>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <SuppressDependenciesWhenPacking>true</SuppressDependenciesWhenPacking>
  </PropertyGroup>

  <!-- Required only by the custom MSBuild task assembly. -->
  <ItemGroup>
    <PackageReference Include="Microsoft.Build.Framework" PrivateAssets="all" />
    <PackageReference Include="Microsoft.Build.Utilities.Core" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <None Include="ATAP.Utilities.BuildTooling.targets" Pack="true" PackagePath="build\ATAP.Utilities.BuildTooling.CSharp.targets" />
    <None Include="ATAP.Utilities.BuildTooling.targets" Pack="true" PackagePath="buildTransitive\ATAP.Utilities.BuildTooling.CSharp.targets" />
    <None Include="ReadMe.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
