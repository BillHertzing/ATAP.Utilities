    <diagram id="page-02-databases" name="02 — Databases &amp; Migration Flow">
        <mxGraphModel grid="1" page="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" pageScale="1" pageWidth="1700" pageHeight="1100" math="0" shadow="0">
            <root>
                <mxCell id="0"/>
                <mxCell id="1" parent="0"/>
                <mxCell id="title-02" value="Databases &amp; Migration Flow — Per-Tier SQL Instances and Flyway Promotion" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=18;fontStyle=1;" parent="1" vertex="1">
                    <mxGeometry x="40" y="20" width="1620" height="40" as="geometry"/>
                </mxCell>
                <mxCell id="subtitle-02" value="DB change unit (Flyway scripts + CSV seed + loaders) is bundled with app code in the Release Bundle and validated against per-tier SQL instances." style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=12;fontStyle=2;" parent="1" vertex="1">
                    <mxGeometry x="40" y="60" width="1620" height="24" as="geometry"/>
                </mxCell>
                <mxCell id="src-zone" value="Source content (release/x.y.z branch tag)" style="swimlane;startSize=30;fillColor=#fff2cc;strokeColor=#d6b656;fontStyle=1;" parent="1" vertex="1">
                    <mxGeometry x="40" y="100" width="380" height="380" as="geometry"/>
                </mxCell>
                <mxCell id="src-flyway" value="db/&lt;App&gt;/flyway/&#xa;V*.sql, R*.sql" style="shape=document;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" parent="src-zone" vertex="1">
                    <mxGeometry x="20" y="50" width="160" height="80" as="geometry"/>
                </mxCell>
                <mxCell id="src-seed-csv" value="db/&lt;App&gt;/seed/&#xa;S*.csv" style="shape=document;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" parent="src-zone" vertex="1">
                    <mxGeometry x="200" y="50" width="160" height="80" as="geometry"/>
                </mxCell>
                <mxCell id="src-seed-load" value="db/&lt;App&gt;/seed/&#xa;S*_load.sql" style="shape=document;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" parent="src-zone" vertex="1">
                    <mxGeometry x="20" y="160" width="160" height="80" as="geometry"/>
                </mxCell>
                <mxCell id="src-rel-yml" value="db/&lt;App&gt;/releases/&#xa;x.y.z.yml" style="shape=document;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontStyle=1;" parent="src-zone" vertex="1">
                    <mxGeometry x="200" y="160" width="160" height="80" as="geometry"/>
                </mxCell>
                <mxCell id="src-note" value="x.y.z.yml lists exactly which migrations and seed files belong to App x.y.z" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=11;fontStyle=2;" parent="src-zone" vertex="1">
                    <mxGeometry x="20" y="270" width="340" height="60" as="geometry"/>
                </mxCell>
                <mxCell id="bundle-zone" value="Release Bundle (built once at Experimental tier)" style="swimlane;startSize=30;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;" parent="1" vertex="1">
                    <mxGeometry x="500" y="100" width="380" height="380" as="geometry"/>
                </mxCell>
                <mxCell id="bundle-app" value="app/&#xa;Application binaries" style="shape=folder;tabPosition=left;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" parent="bundle-zone" vertex="1">
                    <mxGeometry x="20" y="50" width="160" height="80" as="geometry"/>
                </mxCell>
                <mxCell id="bundle-db" value="db/&#xa;Flyway + seed + loaders" style="shape=folder;tabPosition=left;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" parent="bundle-zone" vertex="1">
                    <mxGeometry x="200" y="50" width="160" height="80" as="geometry"/>
                </mxCell>
                <mxCell id="bundle-installer" value="installer/&#xa;Install-Application.ps1&#xa;Update-Application.ps1" style="shape=folder;tabPosition=left;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" parent="bundle-zone" vertex="1">
                    <mxGeometry x="20" y="160" width="160" height="100" as="geometry"/>
                </mxCell>
