##########################################################################
# CSharpPackage-5Stage - BuildMaster OtterScript Plan
#
# IMMUTABLE BUILD STRATEGY (banner):
#   Adheres to the immutable build strategy: build occurs only in the
#   Experimental stage; later stages promote the same bytes via
#   `Promote-ProGetPackage`. See `Immutable-Build-Strategy.md` section 6.4
#   for the binary-determinism requirement.
#
# Source of truth:
#   Plan-DocsUpdateForImmutablePackages_V3.md Section K
#   SolutionDocumentation/BuildMaster-ProGet-CSharp-Package-Pipeline.md section 5
#   Topology doc: SolutionDocumentation/BuildMaster-Pipeline-Topology.md
#
# Variables (Application Variables):
#   $ApplicationName          Repository/application name, e.g. ATAP.Utilities
#   $Branch                   Branch being built
#   $SourcePath               Absolute path to the developer worktree
#   $Configuration            MSBuild configuration, e.g. Release
#   $ProGetApiKey             Masked BuildMaster variable for ProGet API calls
#   $MetaPackageName          Roll-up NuGet package id, e.g. ATAP.Utilities
#   $SolutionPath             Path to the solution file (e.g. ATAP.Utilities.sln for
#                             ATAP.Utilities-CSharp, AceCommander.sln for AceCommander)
#   $ProjectPath              Repo-root-relative .csproj path used for
#                             project-adjacent version.json / NBGV resolution
#   $Tier                     Current BuildMaster tier/stage (CurrentTier)
#   $CeilingTier              Runtime variable computed from version.json in
#                             the preamble
#
# Only Experimental builds and publishes. Later stages move the same package
# version through the feed chain up to $CeilingTier and run tests against the
# promoted artifact. version.json is a promotion ceiling, not the current stage.
# See SolutionDocumentation/Immutable-Build-Strategy.md §3 and
# SolutionDocumentation/VersionJsonAsCeiling.md.
##########################################################################

# The source is the BuildMaster-provided developer worktree. Do not replace it
# with file-export checkout; the .git file is required by version resolution.

set $BuildToolingModulePath = $PathCombine($SourcePath, src\ATAP.Utilities.BuildTooling.PowerShell\ATAP.Utilities.BuildTooling.PowerShell.psd1);

set $ExperimentalFeedName = nuget-experimental;
set $DevelopmentFeedName  = nuget-development;
set $IntegrationFeedName  = nuget-integration;
set $QaFeedName           = nuget-qa;
set $ProductionFeedName   = nuget-stable;
set $PackageName          = $MetaPackageName;
set $BuildContextDir = $PathCombine($SourcePath, _generated\buildmaster);
set $CurrentTierTempFile = $PathCombine($BuildContextDir, _current_tier.tmp);
set $CeilingTierTempFile = $PathCombine($BuildContextDir, _ceiling_tier.tmp);
set $ResolvedPackageVersionTempFile = $PathCombine($BuildContextDir, _resolved_version.tmp);
set $PrereleaseLabelTempFile = $PathCombine($BuildContextDir, _prerelease_label.tmp);
set $AllowExperimentalFile = $PathCombine($BuildContextDir, _allow_experimental.tmp);
set $AllowDevelopmentFile = $PathCombine($BuildContextDir, _allow_development.tmp);
set $AllowIntegrationFile = $PathCombine($BuildContextDir, _allow_integration.tmp);
set $AllowQAFile = $PathCombine($BuildContextDir, _allow_qa.tmp);
set $AllowProductionFile = $PathCombine($BuildContextDir, _allow_production.tmp);

Exec
(
    FileName: pwsh,
    Arguments: `-NoProfile -Command "$$ErrorActionPreference = 'Stop'; Import-Module '$BuildToolingModulePath' -Force; New-Item -ItemType Directory -Path '$BuildContextDir' -Force | Out-Null; $$context = Get-BuildContext -Application '$ApplicationName' -ProjectPath '$ProjectPath' -Branch '$Branch' -Stage '$Tier'; $$context.CurrentTier | Set-Content -LiteralPath '$CurrentTierTempFile' -Encoding utf8 -NoNewline; $$context.CeilingTier | Set-Content -LiteralPath '$CeilingTierTempFile' -Encoding utf8 -NoNewline; $$context.ResolvedPackageVersion | Set-Content -LiteralPath '$ResolvedPackageVersionTempFile' -Encoding utf8 -NoNewline; $$context.PrereleaseLabel | Set-Content -LiteralPath '$PrereleaseLabelTempFile' -Encoding utf8 -NoNewline; (Test-PromotionWithinCeiling -CurrentTier 'Experimental' -CeilingTier $$context.CeilingTier -AsBoolean).ToString().ToLowerInvariant() | Set-Content -LiteralPath '$AllowExperimentalFile' -Encoding utf8 -NoNewline; (Test-PromotionWithinCeiling -CurrentTier 'Development' -CeilingTier $$context.CeilingTier -AsBoolean).ToString().ToLowerInvariant() | Set-Content -LiteralPath '$AllowDevelopmentFile' -Encoding utf8 -NoNewline; (Test-PromotionWithinCeiling -CurrentTier 'Integration' -CeilingTier $$context.CeilingTier -AsBoolean).ToString().ToLowerInvariant() | Set-Content -LiteralPath '$AllowIntegrationFile' -Encoding utf8 -NoNewline; (Test-PromotionWithinCeiling -CurrentTier 'QA' -CeilingTier $$context.CeilingTier -AsBoolean).ToString().ToLowerInvariant() | Set-Content -LiteralPath '$AllowQAFile' -Encoding utf8 -NoNewline; (Test-PromotionWithinCeiling -CurrentTier 'Production' -CeilingTier $$context.CeilingTier -AsBoolean).ToString().ToLowerInvariant() | Set-Content -LiteralPath '$AllowProductionFile' -Encoding utf8 -NoNewline"`,
    WorkingDirectory: $SourcePath,
    SuccessExitCode: 0
);

set $CurrentTier = $Trim($FileContents($CurrentTierTempFile));
set $CeilingTier = $Trim($FileContents($CeilingTierTempFile));
set $ResolvedPackageVersion = $Trim($FileContents($ResolvedPackageVersionTempFile));
set $PrereleaseLabel = $Trim($FileContents($PrereleaseLabelTempFile));
set $AllowExperimental = $Trim($FileContents($AllowExperimentalFile));
set $AllowDevelopment = $Trim($FileContents($AllowDevelopmentFile));
set $AllowIntegration = $Trim($FileContents($AllowIntegrationFile));
set $AllowQA = $Trim($FileContents($AllowQAFile));
set $AllowProduction = $Trim($FileContents($AllowProductionFile));

set $FeedName = $ExperimentalFeedName;

Log-Debug `Resolved CurrentTier=$CurrentTier CeilingTier=$CeilingTier Feed=$FeedName Package=$PackageName Version=$ResolvedPackageVersion PrereleaseLabel=$PrereleaseLabel`;

# -------------------------------------------------------------------------
# Stage Experimental - build, pack, publish to the first feed
# -------------------------------------------------------------------------
stage Experimental
{
    if $Tier == Experimental
    {
        if $AllowExperimental == true
        {
        # ContinuousIntegrationBuild=true enforces binary-determinism
        # (deterministic source paths, embedded PDB metadata, no machine-
        # specific build outputs) as required by Immutable-Build-Strategy.md
        # section 6.4. Must be set on BOTH `dotnet build` and `dotnet pack`
        # so the binaries produced here are bit-identical to any later rebuild
        # from the same commit, satisfying the immutable-promotion contract.
        Exec
        (
            FileName: dotnet,
            Arguments: `build $SolutionPath --configuration $Configuration --no-incremental -p:ContinuousIntegrationBuild=true`,
            WorkingDirectory: $SourcePath,
            SuccessExitCode: 0
        );

        Exec
        (
            FileName: dotnet,
            Arguments: `pack $SolutionPath --configuration $Configuration --no-build --output _generated\nuget\$Tier -p:ContinuousIntegrationBuild=true`,
            WorkingDirectory: $SourcePath,
            SuccessExitCode: 0
        );

        Exec
        (
            FileName: pwsh,
            Arguments: `-NoProfile -Command "$$env:PROGET_ADMIN_API_KEY = '$Decrypt($ProGetApiKey)'; Import-Module '$BuildToolingModulePath' -Force; Get-ChildItem -Path '_generated\nuget\$Tier' -Filter '*.nupkg' -File | ForEach-Object { Publish-NuGetPackageToProGet -NupkgPath $$_.FullName -Feed '$FeedName' -CeilingTier '$CeilingTier' | Out-Null }"`,
            WorkingDirectory: $SourcePath,
            SuccessExitCode: 0
        );

        Create-Artifact Packages
        (
            From: _generated\nuget\$Tier,
            Include: @(*.nupkg, *.snupkg)
        );
        }
    }
}

# -------------------------------------------------------------------------
# Stage Development - promote from Experimental, then run unit tests
# -------------------------------------------------------------------------
stage Development
{
    if $Tier == Development
    {
        if $AllowDevelopment == true
        {
        Exec
        (
            FileName: pwsh,
            Arguments: `-NoProfile -Command "$$env:PROGET_BUILDMASTER_API_KEY = '$Decrypt($ProGetApiKey)'; Import-Module '$BuildToolingModulePath' -Force; Promote-ProGetPackage -Name '$PackageName' -Version '$ResolvedPackageVersion' -FromFeed '$ExperimentalFeedName' -ToFeed '$DevelopmentFeedName' -Reason 'Development gate for $ApplicationName $ResolvedPackageVersion on $Branch' -CeilingTier '$CeilingTier'"`,
            WorkingDirectory: $SourcePath,
            SuccessExitCode: 0
        );

        Exec
        (
            FileName: pwsh,
            Arguments: `-NoProfile -Command "Import-Module '$BuildToolingModulePath' -Force; Invoke-PromotedPackageTests -Name '$PackageName' -Version '$ResolvedPackageVersion' -Feed '$DevelopmentFeedName' -TestFilter 'Category=Unit' -ResultsPath '_generated\testresults\$Tier'"`,
            WorkingDirectory: $SourcePath,
            SuccessExitCode: 0
        );

        Create-Artifact TestResults
        (
            From: _generated\testresults\$Tier,
            Include: @(*.trx)
        );
        }
    }
}

# -------------------------------------------------------------------------
# Stage Integration - promote from Development, then run integration tests
# -------------------------------------------------------------------------
stage Integration
{
    if $Tier == Integration
    {
        if $AllowIntegration == true
        {
        Exec
        (
            FileName: pwsh,
            Arguments: `-NoProfile -Command "$$env:PROGET_BUILDMASTER_API_KEY = '$Decrypt($ProGetApiKey)'; Import-Module '$BuildToolingModulePath' -Force; Promote-ProGetPackage -Name '$PackageName' -Version '$ResolvedPackageVersion' -FromFeed '$DevelopmentFeedName' -ToFeed '$IntegrationFeedName' -Reason 'Integration gate for $ApplicationName $ResolvedPackageVersion on $Branch' -CeilingTier '$CeilingTier'"`,
            WorkingDirectory: $SourcePath,
            SuccessExitCode: 0
        );

        Exec
        (
            FileName: pwsh,
            Arguments: `-NoProfile -Command "Import-Module '$BuildToolingModulePath' -Force; Invoke-PromotedPackageTests -Name '$PackageName' -Version '$ResolvedPackageVersion' -Feed '$IntegrationFeedName' -TestFilter 'Category=Unit|Category=Integration' -ResultsPath '_generated\testresults\$Tier'"`,
            WorkingDirectory: $SourcePath,
            SuccessExitCode: 0
        );

        Create-Artifact TestResults
        (
            From: _generated\testresults\$Tier,
            Include: @(*.trx)
        );
        }
    }
}

# -------------------------------------------------------------------------
# Stage QA - promote from Integration, then run regression tests with coverage
# -------------------------------------------------------------------------
stage QA
{
    if $Tier == QA
    {
        if $AllowQA == true
        {
        Exec
        (
            FileName: pwsh,
            Arguments: `-NoProfile -Command "$$env:PROGET_BUILDMASTER_API_KEY = '$Decrypt($ProGetApiKey)'; Import-Module '$BuildToolingModulePath' -Force; Promote-ProGetPackage -Name '$PackageName' -Version '$ResolvedPackageVersion' -FromFeed '$IntegrationFeedName' -ToFeed '$QaFeedName' -Reason 'QA gate for $ApplicationName $ResolvedPackageVersion on $Branch' -CeilingTier '$CeilingTier'"`,
            WorkingDirectory: $SourcePath,
            SuccessExitCode: 0
        );

        Exec
        (
            FileName: pwsh,
            Arguments: `-NoProfile -Command "Import-Module '$BuildToolingModulePath' -Force; Invoke-PromotedPackageTests -Name '$PackageName' -Version '$ResolvedPackageVersion' -Feed '$QaFeedName' -CollectCoverage -ResultsPath '_generated\testresults\$Tier'"`,
            WorkingDirectory: $SourcePath,
            SuccessExitCode: 0
        );

        Create-Artifact TestResults
        (
            From: _generated\testresults\$Tier,
            Include: @(*.trx, coverage.cobertura.xml)
        );
        }
    }
}

# -------------------------------------------------------------------------
# Stage Production - promote from QA, then run smoke tests
# -------------------------------------------------------------------------
stage Production
{
    if $Tier == Production
    {
        if $AllowProduction == true
        {
        Exec
        (
            FileName: pwsh,
            Arguments: `-NoProfile -Command "$$env:PROGET_BUILDMASTER_API_KEY = '$Decrypt($ProGetApiKey)'; Import-Module '$BuildToolingModulePath' -Force; Promote-ProGetPackage -Name '$PackageName' -Version '$ResolvedPackageVersion' -FromFeed '$QaFeedName' -ToFeed '$ProductionFeedName' -Reason 'Production gate for $ApplicationName $ResolvedPackageVersion on $Branch' -CeilingTier '$CeilingTier'"`,
            WorkingDirectory: $SourcePath,
            SuccessExitCode: 0
        );

        Exec
        (
            FileName: pwsh,
            Arguments: `-NoProfile -Command "Import-Module '$BuildToolingModulePath' -Force; Invoke-PromotedPackageTests -Name '$PackageName' -Version '$ResolvedPackageVersion' -Feed '$ProductionFeedName' -TestFilter 'Category=Smoke' -ResultsPath '_generated\testresults\$Tier'"`,
            WorkingDirectory: $SourcePath,
            SuccessExitCode: 0
        );

        Create-Artifact TestResults
        (
            From: _generated\testresults\$Tier,
            Include: @(*.trx)
        );
        }
    }
}
