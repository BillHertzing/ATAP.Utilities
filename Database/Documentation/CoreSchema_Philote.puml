@startuml CoreSchema_Philote
' ATAPUtilities Philote identity and business-validity contract.
' Source: Database/Flyway/SQL/V00010__Create_ATAPUtilities_Initial_Schema_And_Seed.sql

skinparam linetype ortho
skinparam roundcorner 5
skinparam defaultFontName Segoe UI
skinparam defaultFontSize 11
skinparam entity {
  BackgroundColor #EEF6EE
  BorderColor #2E7D32
  FontColor #1A1A1A
}
skinparam arrow {
  Color #2E7D32
  FontSize 9
}

entity "Philote" as Philote <<table>> {
  * PhiloteId : uniqueidentifier <<PK>>
  --
  AdditionalIdsStub : nvarchar(max) [NULL]
}

entity "PhiloteValidityPeriod" as Validity <<table>> {
  * PhiloteValidityPeriodId : uniqueidentifier <<PK>>
  --
  PhiloteId : uniqueidentifier <<FK>>
  PreviousValidToUtc : datetime2(7) [NULL, FK]
  ValidFromUtc : datetime2(7)
  ValidToUtc : datetime2(7) [NULL]
}

Philote ||--o{ Validity : "has 0..* validity periods"
Validity "0..1 successor" --> "0..1 predecessor" Validity : "previous end"

note right of Philote
  AdditionalIdsStub is constrained to NULL.
  Domain entity IDs equal their Philote IDs.
end note

note right of Validity
  Half-open business-validity interval:
  [ValidFromUtc, ValidToUtc)

  NULL ValidToUtc = open-ended.
  NULL PreviousValidToUtc = first row only.
  Equality to the next start = adjacency;
  a later next start = permitted gap.
end note

note bottom of Validity
  The Philote-scoped unique start, end, and predecessor keys,
  the self-FK, and the two checks form one non-branching,
  non-overlapping predecessor chain. Mutation is procedure-only.
end note

@enduml
