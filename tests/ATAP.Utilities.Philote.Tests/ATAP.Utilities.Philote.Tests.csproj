<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
    <IsPackable>false</IsPackable>
    <!-- Assembly, File, and Package Information for this assembly-->
    <!-- Build and revision are created based on date-->
    <MajorVersion>0</MajorVersion>
    <MinorVersion>1</MinorVersion>
    <PatchVersion>0</PatchVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="FluentAssertions" />
    <PackageReference Include="Moq" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.console">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="xunit.runner.visualstudio">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers</IncludeAssets>
    </PackageReference>
    <PackageReference Include="coverlet.collector">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <!-- Conditional-SUT pattern per CSharp-Packages-Test-Process.md S3.1:
       promotion tiers pass UsePackageReferenceForSUT=true and SUTVersion=<promoted-version>
       so this test project consumes the promoted Philote packages instead of local project refs. -->
  <PropertyGroup>
    <UsePackageReferenceForSUT Condition="'$(UsePackageReferenceForSUT)' == ''">false</UsePackageReferenceForSUT>
  </PropertyGroup>

  <ItemGroup Condition="'$(UsePackageReferenceForSUT)' == 'false'">
    <ProjectReference Include="..\..\src\ATAP.Utilities.Philote\DefaultConfiguration\ATAP.Utilities.Philote.DefaultConfiguration.csproj" />
    <ProjectReference Include="..\..\src\ATAP.Utilities.Philote\Interfaces\ATAP.Utilities.Philote.Interfaces.csproj" />
    <ProjectReference Include="..\..\src\ATAP.Utilities.Philote\ATAP.Utilities.Philote.csproj" />
  </ItemGroup>

  <ItemGroup Condition="'$(UsePackageReferenceForSUT)' == 'true'">
    <PackageReference Include="ATAP.Utilities.Philote.DefaultConfiguration" VersionOverride="$(SUTVersion)" />
    <PackageReference Include="ATAP.Utilities.Philote.Interfaces" VersionOverride="$(SUTVersion)" />
    <PackageReference Include="ATAP.Utilities.Philote" VersionOverride="$(SUTVersion)" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\ATAP.Utilities.Logging\ATAP.Utilities.Logging.csproj" />
    <ProjectReference Include="..\..\src\ATAP.Utilities.Serializer\Interfaces\ATAP.Utilities.Serializer.Interfaces.csproj" />
    <ProjectReference Include="..\..\src\ATAP.Utilities.Testing\ATAP.Utilities.Testing.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Update="SerializationStrings.Designer.cs">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>SerializationStrings.resx</DependentUpon>
    </Compile>
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Update="SerializationStrings.resx">
      <Generator>PublicResXFileCodeGenerator</Generator>
      <LastGenOutput>SerializationStrings.Designer.cs</LastGenOutput>
    </EmbeddedResource>
  </ItemGroup>


</Project>
