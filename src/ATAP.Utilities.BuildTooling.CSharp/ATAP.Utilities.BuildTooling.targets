<?xml version="1.0" encoding="utf-8"?>
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">

  <!--
    This file is intentionally inert. NuGet imports it from both build and
    buildTransitive so consumers can discover the canonical package contract.
    Consumer policy and validation targets are owned by later Task 15.180 units.
  -->
  <PropertyGroup>
    <ATAPBuildToolingImported>true</ATAPBuildToolingImported>
    <ATAPBuildToolingContractVersion>1</ATAPBuildToolingContractVersion>
    <ATAPBuildToolingCompatibilitySentinel>ATAP.Utilities.BuildTooling.CSharp/1</ATAPBuildToolingCompatibilitySentinel>
    <ATAPBuildToolingImportProvenance>$(MSBuildThisFileFullPath)</ATAPBuildToolingImportProvenance>
    <ATAPBuildToolingImportDirectory>$(MSBuildThisFileDirectory)</ATAPBuildToolingImportDirectory>
    <ATAPBuildToolingTaskTargetFramework Condition="'$(ATAPBuildToolingTaskTargetFramework)' == ''">net10.0</ATAPBuildToolingTaskTargetFramework>
    <ATAPUtilitiesBuildToolingTasksAssembly Condition="'$(ATAPUtilitiesBuildToolingTasksAssembly)' == ''">$(MSBuildThisFileDirectory)..\tools\$(ATAPBuildToolingTaskTargetFramework)\ATAP.Utilities.BuildTooling.CSharp.dll</ATAPUtilitiesBuildToolingTasksAssembly>
  </PropertyGroup>

</Project>
