{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://atap.example.com/schemas/manifest/v2.json",
  "title": "ATAP ReleaseBundle manifest v2",
  "description": "Deterministic application ReleaseBundle manifest. Database packages are referenced, never embedded.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion", "releaseVersion", "sourceTag", "sourceCommit", "sourceBranch",
    "buildUtc", "buildAgent", "applicationProvenance", "includedLibraryPackages",
    "includedPowerShellModules", "databasePackageReference", "payloadFiles",
    "installerScripts", "testEvidence", "compatibility", "rollback"
  ],
  "properties": {
    "schemaVersion": { "type": "integer", "const": 2 },
    "releaseVersion": { "$ref": "#/$defs/semVerString" },
    "sourceTag": { "$ref": "#/$defs/nonEmptyToken" },
    "sourceCommit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "sourceBranch": { "type": "string", "pattern": "^release/[^\\s]+$" },
    "buildUtc": { "type": "string", "format": "date-time", "pattern": "Z$" },
    "buildAgent": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9.-]*$" },
    "applicationProvenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "productId", "root", "components", "artifactKind", "configuration",
        "targetFramework", "runtimeIdentifier", "publishSettings"
      ],
      "properties": {
        "productId": { "$ref": "#/$defs/packageId" },
        "root": { "$ref": "#/$defs/applicationComponent" },
        "components": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/applicationComponent" }
        },
        "artifactKind": { "enum": ["HostedWebApplication", "WindowsApplicationOrService"] },
        "configuration": { "$ref": "#/$defs/nonEmptyToken" },
        "targetFramework": { "type": "string", "pattern": "^net[0-9]+\\.[0-9]+(?:-[A-Za-z0-9.-]+)?$" },
        "runtimeIdentifier": {
          "oneOf": [
            { "type": "null" },
            { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)+$" }
          ]
        },
        "publishSettings": {
          "type": "object",
          "additionalProperties": false,
          "required": ["selfContained", "publishSingleFile", "publishTrimmed", "useAppHost"],
          "properties": {
            "selfContained": { "type": "boolean" },
            "publishSingleFile": { "type": "boolean" },
            "publishTrimmed": { "type": "boolean" },
            "useAppHost": { "type": "boolean" }
          }
        }
      }
    },
    "includedLibraryPackages": { "$ref": "#/$defs/packageReferenceList" },
    "includedPowerShellModules": { "$ref": "#/$defs/packageReferenceList" },
    "databasePackageReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "compatibleVersionRange", "pinnedVersion", "lifecycleCeiling"],
      "properties": {
        "id": { "$ref": "#/$defs/packageId" },
        "compatibleVersionRange": { "$ref": "#/$defs/nuGetVersionRange" },
        "pinnedVersion": { "$ref": "#/$defs/semVerString" },
        "lifecycleCeiling": {
          "enum": [
            "database-experimental", "database-development", "database-integration",
            "database-qa", "database-stable"
          ]
        }
      }
    },
    "payloadFiles": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/fileEvidence" }
    },
    "installerScripts": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/relativePath" }
    },
    "testEvidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "path", "checksumSha256"],
        "properties": {
          "kind": { "$ref": "#/$defs/nonEmptyToken" },
          "path": { "$ref": "#/$defs/relativePath" },
          "checksumSha256": { "$ref": "#/$defs/checksumSha256" }
        }
      }
    },
    "compatibility": {
      "type": "object",
      "additionalProperties": false,
      "required": ["osFamilies", "runtimeIdentifiers", "dotnetRuntimeVersion"],
      "properties": {
        "osFamilies": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "enum": ["windows", "linux", "macos"] }
        },
        "runtimeIdentifiers": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)+$" }
        },
        "dotnetRuntimeVersion": { "$ref": "#/$defs/versionString" }
      }
    },
    "rollback": {
      "type": "object",
      "additionalProperties": false,
      "required": ["supported", "notes"],
      "properties": {
        "supported": { "type": "boolean" },
        "notes": { "$ref": "#/$defs/nonEmptyString" }
      }
    }
  },
  "$defs": {
    "nonEmptyString": { "type": "string", "minLength": 1 },
    "nonEmptyToken": { "type": "string", "minLength": 1, "pattern": "^\\S+$" },
    "semVerString": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$"
    },
    "versionString": {
      "type": "string",
      "pattern": "^[0-9]+(?:\\.[0-9]+)*(?:[-+][0-9A-Za-z.-]+)?$"
    },
    "packageId": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"
    },
    "nuGetVersionRange": {
      "type": "string",
      "pattern": "^[\\[(](?:[0-9A-Za-z.+-]+)?\\s*,?\\s*(?:[0-9A-Za-z.+-]+)?[\\])]$"
    },
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?![A-Za-z]:)(?!/)(?!.*\\\\)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
    },
    "checksumSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "fileEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "checksumSha256", "sizeBytes"],
      "properties": {
        "path": {
          "allOf": [
            { "$ref": "#/$defs/relativePath" },
            { "not": { "pattern": "^(?:[dD][bB]/|.*(?:^|/)[dD][bB]-manifest\\.json$)" } }
          ]
        },
        "checksumSha256": { "$ref": "#/$defs/checksumSha256" },
        "sizeBytes": { "type": "integer", "minimum": 1 }
      }
    },
    "applicationComponent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "qualityTier", "projectPath"],
      "properties": {
        "id": { "$ref": "#/$defs/packageId" },
        "version": { "$ref": "#/$defs/semVerString" },
        "qualityTier": { "const": "Production" },
        "projectPath": { "$ref": "#/$defs/relativePath" }
      }
    },
    "packageReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version"],
      "properties": {
        "id": { "$ref": "#/$defs/packageId" },
        "version": { "$ref": "#/$defs/semVerString" }
      }
    },
    "packageReferenceList": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/packageReference" }
    }
  }
}