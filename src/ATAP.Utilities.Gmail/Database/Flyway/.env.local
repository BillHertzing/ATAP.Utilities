# Gmail Database - Experimental Environment Configuration
# This file sets environment variables for Flyway migrations
# Note: This file uses standard .env format (KEY=VALUE), not PowerShell syntax

# Shared SQL location (adjust path to your ATAP.Utilities installation)
FLYWAY_SHARED_SQL_PATH=C:/Dropbox/whertzing/GitHub/ATAP.Utilities/src/ATAP.Utilities.DatabaseManagement/SharedSQL

# Database-specific data directory
FLYWAY_DATA_DIR=C:/Dropbox/whertzing/GitHub/Gmail/Databases/Flyway/DATA

# Package metadata placeholders
FLYWAY_PACKAGE_NAME=Gmail.Database
FLYWAY_PACKAGE_VERSION=0.0.00001
FLYWAY_GIT_TAG=v0.0.00001
FLYWAY_GIT_COMMIT=initial
FLYWAY_MANIFEST_VALUES=(N'V00.01.000001__Init.sql','V',N'pending')

