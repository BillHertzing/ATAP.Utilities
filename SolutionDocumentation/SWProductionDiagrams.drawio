                    <mxGeometry x="200" y="160" width="160" height="100" as="geometry"/>
                </mxCell>
                <mxCell id="src-to-bundle" value="New-ReleaseBundle (uses x.y.z.yml as source-of-truth)" style="endArrow=classic;html=1;rounded=0;strokeColor=#82b366;strokeWidth=2;" parent="1" source="src-zone" target="bundle-zone" edge="1">
                    <mxGeometry x="-1" y="-60" relative="1" as="geometry">
                        <mxPoint as="offset"/>
                    </mxGeometry>
                </mxCell>
                <mxCell id="db-tiers-zone" value="Per-tier SQL Server validation environments (each tier rehearses the migrations against its own DB)" style="swimlane;startSize=30;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;" parent="1" vertex="1">
                    <mxGeometry x="40" y="520" width="1620" height="280" as="geometry"/>
                </mxCell>
                <mxCell id="db-exp" value="Experimental DB&#xa;(SQL Server LocalDB,&#xa;empty start)" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=15;fillColor=#dae8fc;strokeColor=#6c8ebf;" parent="db-tiers-zone" vertex="1">
                    <mxGeometry x="40" y="80" width="180" height="100" as="geometry"/>
                </mxCell>
                <mxCell id="db-dev" value="Development DB&#xa;(SQL Server, dev fixture)" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=15;fillColor=#dae8fc;strokeColor=#6c8ebf;" parent="db-tiers-zone" vertex="1">
                    <mxGeometry x="280" y="80" width="180" height="100" as="geometry"/>
                </mxCell>
                <mxCell id="db-int" value="Integration DB&#xa;(restored from prev-prod backup)" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=15;fillColor=#dae8fc;strokeColor=#6c8ebf;" parent="db-tiers-zone" vertex="1">
                    <mxGeometry x="520" y="80" width="180" height="100" as="geometry"/>
                </mxCell>
                <mxCell id="db-qa" value="QA Gold DB&#xa;(prod-shaped,&#xa;anonymized)" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=15;fillColor=#dae8fc;strokeColor=#6c8ebf;" parent="db-tiers-zone" vertex="1">
                    <mxGeometry x="760" y="80" width="180" height="100" as="geometry"/>
                </mxCell>
                <mxCell id="db-prod" value="Production DB&#xa;(customer)" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=15;fillColor=#82b366;fontColor=#ffffff;strokeColor=#006600;fontStyle=1;" parent="db-tiers-zone" vertex="1">
                    <mxGeometry x="1000" y="80" width="180" height="100" as="geometry"/>
                </mxCell>
                <mxCell id="db-rehearsal-svc" value="Invoke-FlywayRehearsal&#xa;(in BuildTooling.PowerShell)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontStyle=1;" parent="db-tiers-zone" vertex="1">
                    <mxGeometry x="1280" y="80" width="280" height="100" as="geometry"/>
                </mxCell>
                <mxCell id="db-step-1" value="Apply migrations" style="endArrow=classic;html=1;rounded=0;strokeColor=#666666;" parent="db-tiers-zone" source="db-exp" target="db-dev" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="db-step-2" value="Apply migrations" style="endArrow=classic;html=1;rounded=0;strokeColor=#666666;" parent="db-tiers-zone" source="db-dev" target="db-int" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="db-step-3" value="Apply migrations" style="endArrow=classic;html=1;rounded=0;strokeColor=#666666;" parent="db-tiers-zone" source="db-int" target="db-qa" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="db-step-4" value="Customer install/upgrade" style="endArrow=classic;html=1;rounded=0;strokeColor=#006600;strokeWidth=2;" parent="db-tiers-zone" source="db-qa" target="db-prod" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="db-note" value="Each tier&#39;s rehearsal log is attached to the BuildMaster release record. Headline rehearsal log (Integration) is embedded into the bundle&#39;s tests/ folder for Production audit." style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=11;fontStyle=2;" parent="db-tiers-zone" vertex="1">
                    <mxGeometry x="40" y="200" width="1540" height="50" as="geometry"/>
                </mxCell>
                <mxCell id="bundle-to-rehearsal" value="Bundle drives the rehearsal" style="endArrow=classic;html=1;rounded=0;strokeColor=#82b366;strokeWidth=2;dashed=1;exitX=1;exitY=0.5;entryX=0.5;entryY=0;" parent="1" source="bundle-zone" target="db-rehearsal-svc" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="install-decision" value="On install/upgrade, Install-Application.ps1 detects DB state:&#xa;• DB absent      → CREATE DATABASE; apply all migrations; run seed loaders.&#xa;• DB present, Flyway absent → BASELINE at manifest baseline; then migrate.&#xa;• DB at target version       → no-op for migrations; re-run repeatable loaders only.&#xa;• DB below target version    → migrate up; run new versioned seed loaders.&#xa;• DB above target version    → ABORT (downgrade not supported)." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;fontSize=11;" parent="1" vertex="1">
                    <mxGeometry x="900" y="100" width="760" height="380" as="geometry"/>
                </mxCell>
                <mxCell id="install-title" value="installer/Install-Application.ps1 — DB action decision" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=12;fontStyle=1;" parent="1" vertex="1">
                    <mxGeometry x="900" y="80" width="760" height="20" as="geometry"/>
                </mxCell>
