],
[
{
"text": " # $adminApiKey is used to authenticate an admin role to ProGet",
"range": {
"startLineNumber": 46,
"startColumn": 1,
"endLineNumber": 46,
"endColumn": 8
}
}
],
[
{
"text": " # ToDo: Fetch from Secrets vault instead of environment variable",
"range": {
"startLineNumber": 47,
"startColumn": 1,
"endLineNumber": 47,
"endColumn": 6
}
}
],
[
{
