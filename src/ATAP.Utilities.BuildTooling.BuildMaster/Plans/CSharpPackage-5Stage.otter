##########################################################################
# CSharpPackage-5Stage - BuildMaster OtterScript Plan (thin-runner shape)
#
# Variables (Application Variables - set in BuildMaster Application config):
#   $ApplicationName  - BuildMaster application name, e.g. "ATAP.Utilities"
#   $Branch           - source branch name supplied by monitor/poller
#   $SourcePath       - absolute path to the developer/build worktree
#   $MetaPackageName  - roll-up NuGet package id, e.g. "ATAP.Utilities.StronglyTypedId"
#   $PackageName      - ProGet package id used for promotion / test; defaults to $MetaPackageName
#   $ProjectPath      - path (relative to $SourcePath or absolute) to the .csproj
#                       being packed; its parent directory must contain version.json
#                       so Get-BuildContext can resolve the immutable package version
#                       via nbgv from that location
#   $SolutionPath     - solution / .slnf passed to Invoke-PromotedPackageTests
#                       (e.g. "ATAP.Utilities.Production.slnf"); defaults to
#                       "ATAP.Utilities.sln" inside the runner
#   $Configuration    - MSBuild configuration, defaults to Release
#   ProGet API key    - Arguments carry only ProGet.BuildMaster.API.Key as a
#                       SecretName. Authenticated leaves resolve it through
#                       Get-SecretATAP; no environment fallback is permitted.
#   BuildMaster stage - passed explicitly from $PipelineStageName so deployment
#                       targets do not depend on agent environment variables
#   $BuildMasterBuildId - runtime value from $BuildMasterId(build), used to
#                       isolate generated inter-stage state
#   $CeilingTier      - runtime variable computed from the project's
#                       version.json prerelease label and stored under the
#                       build-id context (owned by the runner script)
#
# Experimental builds and packs the C# package once and publishes it (and any
# sibling roll-up .nupkg files dotnet pack emits) to nuget-experimental. Later
# stages promote that same immutable .nupkg and run Invoke-PromotedPackageTests
# against the promoted package through $CeilingTier; they do not rebuild or
# repack above Experimental.
#
# Immutable build strategy:
#   Adheres to the immutable build strategy: build occurs only in the
#   Experimental stage; later stages promote the same bytes via
#   Promote-ProGetPackage. ContinuousIntegrationBuild=true is forced on both
#   dotnet build and dotnet pack inside the runner to enforce binary-
#   determinism per Immutable-Build-Strategy.md S6.4.
#   version.json is interpreted as a promotion ceiling, not as the current
#   stage. See SolutionDocumentation/Immutable-Build-Strategy.md S3 and
#   SolutionDocumentation/VersionJsonAsCeiling.md.
#   Topology doc: SolutionDocumentation/BuildMaster-Pipeline-Topology.md
#
# This plan is assigned as a per-stage deployment step in the BuildMaster UI.
# Keep the OtterScript surface tiny; the PowerShell runner owns stage/context
# branching, ceiling-clamp enforcement, per-tier completion markers, run-
# context JSON, and secret-safe ProGet publish/promote/test invocations.
##########################################################################

# BuildTooling module used by every stage command.
set $BuildToolingModuleManifest = $PathCombine($SourcePath, src\ATAP.Utilities.BuildTooling.PowerShell\ATAP.Utilities.BuildTooling.PowerShell.psd1);
set $BuildMasterPlanScriptDir = $PathCombine($SourcePath, src\ATAP.Utilities.BuildTooling.BuildMaster\Plans);
set $InvokeCSharpPackageStageScript = $PathCombine($BuildMasterPlanScriptDir, Invoke-CSharpPackageBuildMasterStage.ps1);

set $BuildMasterBuildId = $BuildMasterId(build);
set $BuildMasterBuildNumber = $BuildNumber;
set $BuildMasterExecutionId = $ExecutionId;

Exec
(
    FileName: pwsh,
    Arguments: >>-NoProfile -File "$InvokeCSharpPackageStageScript" -BuildToolingModulePath "$BuildToolingModuleManifest" -SourcePath "$SourcePath" -BuildMasterBuildId "$BuildMasterBuildId" -BuildNumber "$BuildMasterBuildNumber" -ExecutionId "$BuildMasterExecutionId" -ApplicationName "$ApplicationName" -MetaPackageName "$MetaPackageName" -PackageName "$PackageName" -ProjectPath "$ProjectPath" -SolutionPath "$SolutionPath" -Configuration "$Configuration" -Branch "$Branch" -Stage "$PipelineStageName" -ProGetUrl "$ProGetUrl" -ProGetApiKeySecretName "ProGet.BuildMaster.API.Key">>,
    WorkingDirectory: $SourcePath,
    SuccessExitCode: 0
);
