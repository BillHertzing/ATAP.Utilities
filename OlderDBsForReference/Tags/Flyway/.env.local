# Tags Database - Local/Experimental Environment Configuration
# This file sets environment variables for local Flyway migrations
# Note: This file uses standard .env format (KEY=VALUE), not PowerShell syntax

# Shared SQL location (shared migrations)
FLYWAY_SHARED_SQL_PATH=C:/Dropbox/whertzing/GitHub/ATAP.Utilities/src/ATAP.Utilities.DatabaseManagement/SharedSQL

# Database-specific data directory (for BCP files)
FLYWAY_DATA_DIR=C:/Dropbox/whertzing/GitHub/ATAP.Utilities/Databases/Tags/Flyway/Data

# Package metadata placeholders
FLYWAY_PACKAGE_NAME=Tags.Database
FLYWAY_PACKAGE_VERSION=0.1.0
FLYWAY_GIT_TAG=v0.1.0
FLYWAY_GIT_COMMIT=initial
FLYWAY_MANIFEST_VALUES=(N'V00.01.000001__CreateTagsSchema.sql','V',N'pending')
