<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Library</OutputType>
    <EnableDefaultItems>false</EnableDefaultItems>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <IsPackable>true</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="Newtonsoft\ATAP.Utilities.Serializer.Shim.Newtonsoft.csproj" />
    <ProjectReference Include="SystemTextJson\ATAP.Utilities.Serializer.Shim.SystemTextJson.csproj" />
    <!-- ServiceStack excluded: Serializer.Shim.ServiceStack.cs references the legacy ISerializerOptions interface (renamed to ISerializerOptionsAbstract) and does not implement the full ISerializerConfigurableAbstract contract. Re-enable after a code-level refactor parallel to the Newtonsoft shim. -->
    <!-- <ProjectReference Include="ServiceStack\ATAP.Utilities.Serializer.Shim.ServiceStack.csproj" /> -->
    <!-- Plugin excluded: depends on ATAP.Utilities.Loader and ATAP.Utilities.FileIO with unresolved types (ILoadDynamicSubModules, IDynamicSubModulesInfo). Re-enable after the Loader package is restored or the dynamic-loading code is migrated. -->
    <!-- <ProjectReference Include="Plugin\ATAP.Utilities.Serializer.Shim.Plugin.csproj" /> -->
  </ItemGroup>

  <!-- Packages and projects to implement IL Weaving using Fody during the build process -->
  <ItemGroup>
    <PackageReference Include="MethodBoundaryAspect.Fody" />
    <ProjectReference Include="..\..\ATAP.Utilities.ETW\ATAP.Utilities.ETW.csproj" />
  </ItemGroup>

</Project>
