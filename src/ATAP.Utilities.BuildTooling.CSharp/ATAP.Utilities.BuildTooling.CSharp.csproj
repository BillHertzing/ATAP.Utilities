<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Library</OutputType>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
    <IsPackable>true</IsPackable>
    <BuildOutputTargetFolder>tools</BuildOutputTargetFolder>
    <PackageId>ATAP.Utilities.BuildTooling.CSharp</PackageId>
    <Description>Canonical ATAP C# MSBuild package contract.</Description>
  </PropertyGroup>

  <!-- Required only by the custom MSBuild task assembly. -->
  <ItemGroup>
    <PackageReference Include="Microsoft.Build.Framework" PrivateAssets="all" />
    <PackageReference Include="Microsoft.Build.Utilities.Core" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <None Update="ATAP.Utilities.BuildTooling.targets">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Pack>true</Pack>
      <PackagePath>build\;buildTransitive\</PackagePath>
    </None>
  </ItemGroup>

</Project>
