      "response": [
        {
          "value": "To print an environment variable in PowerShell, use:\n\n```powershell\nWrite-Host $env:YOUR_VARIABLE_NAME\n```\n\nFor example, to print the `PATH` environment variable:\n\n```powershell\nWrite-Host $env:PATH\n```\n\nOr simply:\n\n```powershell\n$env:PATH\n```",
          "supportThemeIcons": false,
          "supportHtml": false,
          "baseUri": {
            "$mid": 1,
            "path": "/c:/Dropbox/whertzing/GitHub/ATAP.Utilities/",
            "scheme": "file"
          }
        }
      ],
      "responseId": "response_2c370cd3-ce90-4e0e-8b84-9bdc29dc9592",
      "result": {
        "timings": {
          "firstProgress": 2230,
          "totalElapsed": 3125
        },
        "metadata": {
          "codeBlocks": [
            {
              "code": "Write-Host $env:YOUR_VARIABLE_NAME\n",
              "language": "powershell",
              "markdownBeforeBlock": "To print an environment variable in PowerShell, use:\n\n"
            },
            {
              "code": "Write-Host $env:PATH\n",
              "language": "powershell",
              "markdownBeforeBlock": "\nFor example, to print the `PATH` environment variable:\n\n"
            },
            {
              "code": "$env:PATH\n",
              "language": "powershell",
              "markdownBeforeBlock": "\nOr simply:\n\n"
            }
          ],
