"range": {
"startLineNumber": 54,
"startColumn": 1,
"endLineNumber": 54,
"endColumn": 105
}
}
],
[
{
"text": " # The Page for the command to list all API keys in ProGet",
"range": {
"startLineNumber": 55,
"startColumn": 1,
"endLineNumber": 55,
"endColumn": 26
}
}
],
[
{
"text": " # ToDo: Move the page for the command to list all ApiKeys into configroot and settings",
"range": {
"startLineNumber": 56,
"startColumn": 1,
"endLineNumber": 56,
"endColumn": 6
}
}
],
[
{
"text": " $progetListApisPage = 'api/api-keys/delete'",
"range": {
"startLineNumber": 57,
"startColumn": 1,
"endLineNumber": 57,
"endColumn": 62
}
}
],
[
{
"text": " $proGetAPIpage = $progetListApisPage",
"range": {
"startLineNumber": 58,
"startColumn": 1,
"endLineNumber": 58,
"endColumn": 91
}
}
],
[
{
"text": " # Each call to proget can only delete one API key at a time, and the api expects the ID in a query_string,",
"range": {
"startLineNumber": 59,
"startColumn": 1,
"endLineNumber": 59,
"endColumn": 48
}
}
],
[
{
"text": " # so the APIEndPoint will be constructed with the ID inside the Process block",
"range": {
"startLineNumber": 60,
"startColumn": 1,
"endLineNumber": 60,
"endColumn": 41
}
}
],
[
{
"text": "",
"range": {
"startLineNumber": 61,
"startColumn": 1,
"endLineNumber": 61,
"endColumn": 111
}
}
],
[
{
"text": " $response = $null",
"range": {
"startLineNumber": 62,
"startColumn": 1,
"endLineNumber": 62,
"endColumn": 83
}
}
],
[
{
"text": " $DeletedIds = @{}",
"range": {
"startLineNumber": 63,
"startColumn": 1,
"endLineNumber": 63,
"endColumn": 1
}
}
],
[
{
"text": " $results = $null",
"range": {
"startLineNumber": 64,
"startColumn": 1,
"endLineNumber": 64,
"endColumn": 22
}
}
],
[
{
"text": " }",
"range": {
"startLineNumber": 65,
"startColumn": 1,
"endLineNumber": 65,
"endColumn": 22
}
}
],
[
{
"text": "",
"range": {
"startLineNumber": 66,
"startColumn": 1,
"endLineNumber": 66,
"endColumn": 21
}
}
],
[
{
"text": " Process {",
"range": {
"startLineNumber": 67,
"startColumn": 1,
"endLineNumber": 67,
"endColumn": 4
}
}
],
[
{
"text": " # Create the headers",
"range": {
"startLineNumber": 68,
"startColumn": 1,
"endLineNumber": 68,
"endColumn": 1
}
}
],
[
{
"text": " $headers = @{ 'X-ApiKey' = $adminApiKey }",
"range": {
"startLineNumber": 69,
"startColumn": 1,
"endLineNumber": 69,
"endColumn": 12
}
}
],
[
{
"text": " # Loop over the APIKeys specified in the input",
"range": {
"startLineNumber": 70,
"startColumn": 1,
"endLineNumber": 70,
"endColumn": 25
}
}
],
[
{
"text": " foreach ($apiKeyId in $ID) {",
"range": {
"startLineNumber": 71,
"startColumn": 1,
"endLineNumber": 71,
"endColumn": 46
}
}
],
[
{
"text": " # Construct the API endpoint URL to delete the API key",
"range": {
"startLineNumber": 72,
"startColumn": 1,
"endLineNumber": 72,
"endColumn": 51
}
}
],
[
{
"text": " $apiEndPointBuilder = [UriBuilder]::new($proGetBaseScheme, $proGetBaseHost, $proGetBasePort, $proGetAPIpage)",
                "range": {
                  "startLineNumber": 73,
                  "startColumn": 1,
                  "endLineNumber": 73,
                  "endColumn": 33
                }
              }
            ],
            [
              {
                "text": "      $apiEndPointBuilder.Query = \"id=$apiKeyId\"",
"range": {
"startLineNumber": 74,
"startColumn": 1,
"endLineNumber": 74,
"endColumn": 61
}
}
],
[
{
"text": " $apiEndPoint = $apiEndPointBuilder.URI",
"range": {
"startLineNumber": 75,
"startColumn": 1,
"endLineNumber": 75,
"endColumn": 115
}
}
],
[
{
"text": "",
"range": {
"startLineNumber": 76,
"startColumn": 1,
"endLineNumber": 76,
"endColumn": 49
}
}
],
[
{
"text": " # === Make the API Call ===",
"range": {
"startLineNumber": 77,
"startColumn": 1,
"endLineNumber": 77,
"endColumn": 45
}
}
],
[
{
"text": " try {",
"range": {
"startLineNumber": 78,
"startColumn": 1,
"endLineNumber": 78,
"endColumn": 1
}
}
],
[
{
"text": " Write-PSFMessage -Level Verbose -Message \"Attempting to delete Api key with ID: $apiKeyId\" -Tag 'Remove-ProGetApiKeys', 'Trace'",
"range": {
"startLineNumber": 79,
"startColumn": 1,
"endLineNumber": 79,
"endColumn": 34
}
}
],
[
{
"text": " $response = Invoke-RestMethod -Uri $apiEndPoint.AbsoluteUri -Headers $headers -Method Delete",
"range": {
"startLineNumber": 80,
"startColumn": 1,
"endLineNumber": 80,
"endColumn": 12
}
}
],
[
{
"text": " $DeletedIds[$apiKeyId] = $true",
                "range": {
                  "startLineNumber": 81,
                  "startColumn": 1,
                  "endLineNumber": 81,
                  "endColumn": 136
                }
              }
            ],
            [
              {
                "text": "",
                "range": {
                  "startLineNumber": 82,
                  "startColumn": 1,
                  "endLineNumber": 82,
                  "endColumn": 101
                }
              }
            ],
            [
              {
                "text": "        Write-PSFMessage -Level Verbose -Message \"Successfully deleted Api key with ID: $apiKeyId\" -Tag 'Remove-ProGetApiKeys', 'Trace'",
                "range": {
                  "startLineNumber": 83,
                  "startColumn": 1,
                  "endLineNumber": 83,
                  "endColumn": 39
                }
              }
            ],
            [
              {
                "text": "      }",
                "range": {
                  "startLineNumber": 84,
                  "startColumn": 1,
                  "endLineNumber": 84,
                  "endColumn": 1
                }
              }
            ],
            [
              {
                "text": "      catch {",
                "range": {
                  "startLineNumber": 85,
                  "startColumn": 1,
                  "endLineNumber": 85,
                  "endColumn": 136
                }
              }
            ],
            [
              {
                "text": "        if ($ErrorActionPreference -eq 'SilentlyContinue') {",
"range": {
"startLineNumber": 86,
"startColumn": 1,
"endLineNumber": 86,
"endColumn": 8
}
}
],
[
{
"text": " $DeletedIds[$apiKeyId] = $false",
                "range": {
                  "startLineNumber": 87,
                  "startColumn": 1,
                  "endLineNumber": 87,
                  "endColumn": 14
                }
              }
            ],
            [
              {
                "text": "          Write-PSFMessage -Level Verbose -Message \"Failed to delete apiKeyId $apiKeyId. Exception: $($*.Exception.Message)\" -Tag 'Remove-ProGetApiKeys', 'Trace', 'Error'",
"range": {
"startLineNumber": 88,
"startColumn": 1,
"endLineNumber": 88,
"endColumn": 61
}
}
],
[
