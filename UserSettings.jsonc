{
  // BEGIN ATAP AI SETTINGS (managed)
  "chat.customAgentInSubagent.enabled": true,
  "chat.promptFiles": true,
  "chat.promptFilesLocations": {
    ".github/prompts": true,
    ".agents/skills": true,
    ".claude/skills": true
  },
  "chat.tools.terminal.autoApprove": {
    "Get-Content": true,
    "Get-ChildItem": true,
    "Select-String": true,
    "git status": true,
    "git diff": true,
    "/(?i)(?:pwsh|powershell)(?:\\.exe)?.*(?:-NoProfile|-nop)(?:\\s|$)/": false,
    "/(?i)(?:^|[\\s;&|(])(?:sudo\\s+)?rm\\s+-[a-z]*(?:rf|fr)[a-z]*\\s+\\/(?:\\*)?(?:\\s|$)/": false,
    "/(?i)\\bgit\\s+push\\b(?:.*(?:--force-with-lease|--force|-f)\\b.*\\b(?:main|master)\\b|.*\\b(?:main|master)\\b.*(?:--force-with-lease|--force|-f)\\b)/": false,
    "bw export": false,
    "rmdir": false,
    "del": false,
    "erase": false,
    "Remove-Item": false,
    "Remove-ItemProperty": false,
    "Clear-Content": false,
    "Clear-Item": false,
    "Clear-ItemProperty": false,
    "Invoke-Expression": false,
    "iex": false,
    "Start-Process": false,
    "Stop-Process": false,
    "Stop-Computer": false,
    "Restart-Computer": false,
    "taskkill": false,
    "kill": false,
    "shutdown": false,
    "Format-Volume": false,
    "diskpart": false,
    "bcdedit": false,
    "takeown": false,
    "icacls": false,
    "chmod": false,
    "chown": false,
    "/(?i)\\breg\\s+(?:add|delete)\\b/": false,
    "/(?i)\\bschtasks\\s+\\/(?:create|delete|change|run|end)\\b/": false,
    "git clean": false,
    "git reset": false,
    "git revert": false,
    "/(?i)\\b(?:curl|wget|Invoke-WebRequest|Invoke-RestMethod|iwr|irm|nc|ncat)\\b.*\\b(?:[A-Z][A-Z0-9_]*_API_KEY|[A-Z][A-Z0-9_]*_TOKEN|[A-Z][A-Z0-9_]*_SECRET)\\b/": false
  },
  "chat.tools.urls.autoApprove": {
    "https://developers.openai.com": {
      "approveRequest": false,
      "approveResponse": true
    },
    "https://code.claude.com": {
      "approveRequest": false,
      "approveResponse": true
    },
    "https://code.visualstudio.com": {
      "approveRequest": false,
      "approveResponse": true
    }
  }
  // END ATAP AI SETTINGS (managed)
}